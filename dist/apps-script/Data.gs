?"},{"answer":2,"why":"It says what could have made the result wrong, and that's a limit.","hint":"Is it what you found, the numbers, or something that could make it wrong?"}],"debug":{"buggy_code":"from microbit import *\n\nwhile True:\n    readings = []\n    readings.append(microphone.sound_level())\n    average = sum(readings) // 5\n    display.show(min(9, average // 28))\n    sleep(1000)\n","checks":[{"type":"syntax"},{"type":"not_contains","pattern":"^[ \\t]+readings\\s*=\\s*\\[\\s*\\]","message":"The list is emptied on every loop. Make it once, before the loop."},{"type":"contains","pattern":"sum\\(readings\\)\\s*//\\s*len\\(readings\\)","message":"Divide by how many readings you really have: len(readings)."}]},"practice":{"checks":[{"type":"syntax"},{"type":"contains","pattern":"average\\s*=\\s*sum\\(\\s*readings\\s*\\)\\s*//?\\s*len\\(\\s*readings\\s*\\)","message":"Divide sum(readings) by len(readings)."},{"type":"contains","pattern":"display\\.(scroll|show)\\(\\s*average","message":"Scroll the average."}]},"starter":"from microbit import *\nimport log\n\nLIMIT = 120     # how loud is too loud\nSIZE = 5        # how many readings to average\nlog.set_labels('sound', 'average', timestamp=log.SECONDS)\nreadings = []\nalarm = False\ndisplay.show(Image.HAPPY)\n\nwhile True:\n    sound = microphone.sound_level()\n    readings.append(sound)\n    if len(readings) > SIZE:\n        readings.pop(0)\n    average = sum(readings) // len(readings)\n\n    if average > LIMIT and not alarm:\n        alarm = True\n        display.show(Image.SAD)\n    elif average < LIMIT - 20 and alarm:\n        alarm = False\n        display.show(Image.HAPPY)\n\n    log.add(sound=sound, average=average)\n    sleep(1000)\n","buggy":"from microbit import *\n\nwhile True:\n    readings = []\n    readings.append(microphone.sound_level())\n    average = sum(readings) // 5\n    display.show(min(9, average // 28))\n    sleep(1000)\n","practice_starter":"from microbit import *\n\nreadings = [40, 50, 60]\n\n# work out average\n# scroll average\n","stepped_count":0,"stepped_key":"lab","card":{"id":"embedded-monitor-and-report","number":"E3","title":"Embedded 3: Monitor and Report","subtitle":"Build a noise monitor that doesn't cry wolf, then present your findings","duration_minutes":35,"level":"Embedded","circuit":false,"lab":false,"standards":["6-8.DTC.c.4","6-8.CT.c.5","6-8.CS.a.5"]}}},"order":["hello-microbit","circuits-101","blink-external-led","traffic-light","dimmer-pwm","unit-1-check","buttons-and-inputs","light-sensor","potentiometer","temperature-data","unit-2-check","motion-and-sound","servo-motor","dc-motor-transistor","motor-driver","unit-3-check","robot-drive","line-follower","radio-remote","unit-4-check","sprint-servo-skills","sprint-sensor-lab","sprint-sense-decide-act","sprint-build-the-bot","sprint-mission-day","sprint-showcase","ai-rules-or-learning","ai-teach-your-microbit","ai-test-and-fix","ai-build-with-your-model","embedded-field-station","embedded-sensor-study","embedded-monitor-and-report"],"units":{"1":{"title":"Light It Up","blurb":"Python basics, your first circuits and LEDs."},"2":{"title":"Sensing the World","blurb":"Buttons, light, temperature, knobs and motion."},"3":{"title":"Making Things Move","blurb":"Sound, servos, DC motors and motor drivers."},"4":{"title":"Robots","blurb":"Build, program and remote-control a two-wheel robot."},"5":{"title":"Robot Sprint","blurb":"For classes that already know micro:bit basics. Learn servos and sensors, then pick a branch: Robots, AI or Embedded."},"6":{"title":"AI Lab","blurb":"Teach a micro:bit with machine learning, test it for fairness, and build with it."},"7":{"title":"Embedded Computing","blurb":"Build sensor stations that monitor the real world and answer research questions."}},"tree":{"hello-microbit":{"requires":[],"or_after":[],"pos":[2,0]},"circuits-101":{"requires":["hello-microbit"],"or_after":[],"pos":[2,1]},"blink-external-led":{"requires":["circuits-101"],"or_after":[],"pos
vent-it","number":13,"title":"Invent It","icon":"🚀","color":"purple","python":"Put it all together","hardware":"Your choice","pos":[1,10]}},"requires":{"blink-an-led":["name-badge"],"traffic-light":["blink-an-led"],"reaction-game":["traffic-light"],"making-music":["reaction-game"],"dodge-the-drop":["reaction-game"],"night-light":["making-music","dodge-the-drop"],"distance-detector":["night-light"],"heartbeat-monitor":["night-light"],"servo-robot":["distance-detector"],"robot-eyes":["servo-robot"],"radio-messenger":["robot-eyes","heartbeat-monitor"],"invent-it":["radio-messenger"]},"xp":{"mission":10,"step":10,"quiz":30,"quiz_perfect":20,"quiz_first_try":10,"extension":25,"ship":50,"complete":50,"badge":25},"labels":{"mission":"Mission accepted","step":"Step done","quiz":"Quiz passed","quiz_perfect":"Perfect quiz","quiz_first_try":"Perfect on the first try","extension":"Extension added","ship":"Project shipped","complete":"Lesson complete!"},"quiz_pass":0.75,"levels":[[0,"Spark"],[100,"Blinker"],[250,"Wire Wrangler"],[450,"Code Cadet"],[700,"Circuit Scout"],[1000,"Bug Hunter"],[1350,"Sensor Sleuth"],[1750,"Motor Mechanic"],[2200,"Maker"],[2700,"Engineer"],[3250,"Inventor"],[3850,"Robotics Ace"]],"badges":[["first-step","⚡","First Step","Finish your first build step.",["steps",1]],["finisher","🏁","Finisher","Complete a whole lesson.",["lessons",1]],["shipper","📦","Shipper","Turn in your first MakeCode project.",["shipped",1]],["circuit-builder","💡","Circuit Builder","Complete a lesson where you wire a circuit.",["wired",1]],["wire-wizard","🔌","Wire Wizard","Complete 4 lessons where you wire a circuit.",["wired",4]],["musician","🎵","Musician","Complete Making Music.",["lesson","making-music"]],["game-maker","🎮","Game Maker","Complete Dodge the Drop.",["lesson","dodge-the-drop"]],["echo-hunter","🦇","Echo Hunter","Complete Distance Detector.",["lesson","distance-detector"]],["heart-hacker","❤️","Heart Hacker","Complete Heartbeat Monitor.",["lesson","heartbeat-monitor"]],["robot-builder","🤖","Robot Builder","Complete Build a Robot.",["lesson","servo-robot"]],["quiz-whiz","🧠","Quiz Whiz","Get a perfect quiz score.",["perfect",1]],["sharpshooter","🎯","Sharpshooter","Get 3 quizzes perfect on the first try.",["first_try",3]],["remixer","🎨","Remixer","Add 5 extensions to your projects.",["extensions",5]],["teamwork","🤝","Teamwork","Complete a lesson with a partner.",["partner",1]],["halfway","⭐","Halfway There","Complete 5 lessons.",["lessons",5]],["graduate","🎓","Graduate","Complete all 13 lessons.",["lessons",13]],["early-bird","🐦","Early Bird","Finish an assignment before it's due.",["early"]],["robot-stylist","🤖","Robot Stylist","Customize your robot.",["avatar"]],["teachers-pick","🍎","Teacher's Pick","Given by your teacher for great work.",["teacher"]]],"avatar_options":{"body":[["box","Boxy",null],["round","Dome",null],["tall","Tall",["level",3]],["tank","Tank treads",["level",6]],["hover","Hover jets",["badge","robot-builder"]]],"color":[["teal","Teal",null],["red","Red",null],["orange","Orange",null],["yellow","Yellow",null],["green","Green",null],["blue","Blue",null],["purple","Purple",null],["pink","Pink",null],["white","White",null],["chrome","Chrome",["level",8]],["gold","Gold",["badge","halfway"]]],"eyes":[["dots","Dots",null],["round","Round",null],["visor","Visor",["level",2]],["cyclops","Cyclops",["level",4]],["hearts","Hearts",["badge","quiz-whiz"]],["leds","LED grid",["level",5]],["happy","Happy",["badge","finisher"]]],"mouth":[["smile","Smile",null],["flat","Flat",null],["open","Open",null],["grille","Grille",["level",3]],["zigzag","Zigzag",["badge","remixer"]]],"antenna":[["none","None",null],["ball","Ball",null],["double","Double",["level",2]],["bolt","Lightning",["level",4]],["dish","Radar dish",["badge","echo-hunter"]],["propeller","Propeller",["level",7]]],"accessory":[["none","None",null],["bowtie","Bow tie",null],["cap","Cap",["level",3]],["headphones","Headphones",["badge","musician"]],["goggles","Safety goggles",["badge","circuit-builder"]],["cape","Cape",["level",9]],["crown","Crown",["badge","graduate"]]],"bg":[["sky","Sky",null],["mint","Mint",null],["sun","Sunny",null],["lilac","Lilac",null],["night","Night",null],["circuit","Circuit board",["level",5]],["stars","Starfield",["level",10]]]},"avatar_parts":{"body":"Body","color":"Color","eyes":"Eyes","mouth":"Mouth","antenna":"Antenna","accessory":"Accessory","bg":"Background"},"default_avatar":{"body":"box","color":"teal","eyes":"round","mouth":"smile","antenna":"ball","accessory":"none","bg":"sky","name":""},"makecode_url":"https://makecode.microbit.org/"};


cture":null,"breadboard":null,"wiring":[]}],"quiz":[{"question":"In what order does the micro:bit run these lines? <code>basic.show_number(1)</code> then <code>basic.show_number(2)</code> then <code>basic.show_number(3)</code>","choices":["3, 2, 1","1, 2, 3","All at the same time","In a random order"],"answer":1,"why":"Code runs in order, top to bottom. Each line finishes before the next one starts."},{"question":"What is an <strong>event</strong>?","choices":["A line that runs only once","Code that waits for something to happen, like a button press","A picture on the LEDs","A kind of number"],"answer":1,"why":"An event's code runs every time the thing happens. Press A five times and the A event runs five times."},{"question":"What does <code>input.on_button_pressed(Button.A, on_button_pressed_a)</code> do?","choices":["Presses button A for you","Shows the letter A","Connects button A to the recipe called on_button_pressed_a","Deletes button A"],"answer":2,"why":"Without this line, the recipe exists but nothing ever runs it."},{"question":"In <code>basic.show_leds</code>, what does a <code>#</code> mean?","choices":["The LED is on","The LED is off","A number","A comment"],"answer":0,"why":"<code>#</code> means on and <code>.</code> means off. Five rows of five make the whole screen."},{"question":"Your name doesn't scroll when you press A. What should you check <strong>first</strong>?","choices":["Buy a new micro:bit","That the line inside the def is pushed in, and the on_button_pressed line is there","Change the name","Press B instead"],"answer":1,"why":"Most button bugs come from missing indentation or a missing connecting line."}],"ship":{"extensions":[{"title":"Shake to say hi","level":"Easier","goal":"Shaking the badge shows a waving picture or a message.","where":"Add a new event at the bottom of your program.","code":"def on_gesture_shake():\n    basic.show_string(\"Hi there!\")\ninput.on_gesture(Gesture.SHAKE, on_gesture_shake)","blocks":"","new":[1,2,3],"hi
n2.read_digital\n\n    if left == LINE and right == LINE:\n        drive(450, 450)\n    elif left == LINE:\n        drive(0, 450)\n        last_seen == 'left'\n    elif right == LINE:\n        drive(450, 0)\n        last_seen == 'right'\n    else:\n        if last_seen == 'left':\n            drive(-380, 380)\n        else:\n            drive(380, -380)\n    sleep(10)\n","checks":[{"type":"syntax"},{"type":"contains","pattern":"pin2\\.read_digital\\(\\s*\\)","message":"pin2.read_digital needs () to actually read the sensor. Without them, right is the function itself, never 0 or 1."},{"type":"not_contains","pattern":"^\\s*last_seen\\s*==","message":"A line that starts with last_seen == only asks a question - it doesn't store anything. Use = to update the state."},{"type":"contains","pattern":"last_seen\\s*=\\s*['\"]right['\"]","message":"Update last_seen to 'right' when only the right sensor sees the line."},{"type":"contains","pattern":"last_seen\\s*=\\s*['\"]left['\"]\\s*\\n(?:.*\\n)*?.*last_seen\\s*=\\s*['\"]right['\"]|last_seen\\s*=\\s*['\"]right['\"]\\s*\\n(?:.*\\n)*?.*last_seen\\s*=\\s*['\"]left['\"]","message":"Update last_seen in both the left and right branches, not just at the start."}]},"practice":{"checks":[{"type":"syntax"},{"type":"contains","pattern":"if\\s+left\\s*==\\s*1\\s+and\\s+right\\s*==\\s*1\\s*:","message":"Check both sensors first, with and."},{"type":"contains","pattern":"elif\\s+left\\s*==\\s*1\\s*:","message":"Then check the left sensor."},{"type":"contains","pattern":"elif\\s+right\\s*==\\s*1\\s*:","message":"Then check the right sensor."},{"type":"contains","pattern":"else\\s*:","message":"Use else for neither."}]},"starter":"from microbit import *\n\nLINE = 1        # what read_digital() gives over black - change to 0 if yours is opposite\nSPEED = 450     # start slow!\nSEARCH = 380\n\ndef set_motor(pin_a, pin_b, speed):\n    speed = max(-1023, min(1023, speed))\n    if speed > 0:\n        pin_a.write_analog(speed)\n        pin_b.write_digital(0)\n    elif speed < 0:\n        pin_a.write_digital(0)\n        pin_b.write_analog(-speed)\n    else:\n        pin_a.write_digital(0)\n        pin_b.write_digital(0)\n\ndef drive(left, right):\n    set_motor(pin13, pin14, left)\n    set_motor(pin15, pin16, right)\n\nlast_seen = 'left'\ndrive(0, 0)\ndisplay.show(Image.ARROW_W)        # press A to start\nwhile not button_a.was_pressed():\n    sleep(20)\n\nwhile True:\n    left = pin1.read_digital()\n    right = pin2.read_digital()\n\n    if left == LINE and right == LINE:\n        drive(SPEED, SPEED)            # centered - go straight\n        display.show(Image.ARROW_N)\n    elif left == LINE:\n        drive(0, SPEED)                # line drifting left - turn left\n        last_seen = 'left'\n        display.show(Image.ARROW_W)\n    elif right == LINE:\n        drive(SPEED, 0)                # line drifting right - turn right\n        last_seen = 'right'\n        display.show(Image.ARROW_E)\n    else:\n        display.show('?')              # lost - search toward last_seen\n        if last_seen == 'left':\n            drive(-SEARCH, SEARCH)\n        else:\n            drive(SEARCH, -SEARCH)\n\n    if button_b.was_pressed():         # emergency stop\n        drive(0, 0)\n        display.show(Image.NO)\n        break\n    sleep(10)\n","buggy":"from microbit import *\n\nLINE = 1\n\ndef set_motor(pin_a, pin_b, speed):\n    if speed > 0:\n        pin_a.write_analog(speed)\n        pin_b.write_digital(0)\n    elif speed < 0:\n        pin_a.write_digital(0)\n        pin_b.write_analog(-speed)\n    else:\n        pin_a.write_digital(0)\n        pin_b.write_digital(0)\n\ndef drive(left, right):\n    set_motor(pin13, pin14, left)\n    set_motor(pin15, pin16, right)\n\nlast_seen = 'left'\n\nwhile True:\n    left = pin1.read_digital()\n    right = pin2.read_digital\n\n    if left == LINE and right == LINE:\n        drive(450, 450)\n    elif left == LINE:\n        drive(0, 450)\n        last_seen == 'left'\n    elif ri
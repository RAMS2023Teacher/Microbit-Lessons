.write_digital(0)\n    pin14.write_digital(0)\n\nwhile True:\n    forward(800)\n    sleep(2000)\n    stop()\n    sleep(1000)\n    backward(800)\n    sleep(2000)\n    stop()\n    sleep(1000)\n","practice_starter":"from microbit import *\n\n# define spin_back here\n\nspin_back(600)\n","stepped_count":5,"stepped_key":"circuit","card":{"id":"motor-driver","number":13,"title":"Forward and Reverse with a Motor Driver","subtitle":"Use an H-bridge driver so your code can spin a motor both ways","duration_minutes":35,"level":"Intermediate","circuit":true,"lab":false,"standards":["6-8.CS.a.4","6-8.CT.d.2","6-8.CT.b.2","6-8.CT.d.6"]}},"unit-3-check":{"id":"unit-3-check","title":"Unit 3 Check: Making Things Move","number":"U3","unit":3,"kind":"check","section_keys":["quiz"],"has_debug":false,"possible_xp":90,"quiz":[{"answer":0,"explain":"Pins give only a few milliamps."},{"answer":0,"explain":"Signals only make sense against a shared ground."},{"answer":1,"explain":"The function returns 4 + 1."},{"answer":1,"explain":"It keeps the value in range."},{"answer":0,"explain":"More on-time means more power."},{"answer":0,"explain":"It flips the direction of the current."}],"debug":null,"practice":null,"starter":"","buggy":"","practice_starter":"","stepped_count":0,"stepped_key":"lab","card":{"id":"unit-3-check","number":"U3","title":"Unit 3 Check: Making Things Move","subtitle":"A short check on what you can do without looking back","duration_minutes":15,"level":"Unit check","circuit":false,"lab":false,"standards":[]}},"robot-drive":{"id":"robot-drive","title":"Drive Your Robot","number":14,"unit":4,"kind":"lesson","section_keys":["warmup","learn","circuit","code","practice","debug","quiz","challenge"],"has_debug":true,"possible_xp":260,"quiz":[{"answer":1,"explain":"The left wheel goes forward and the right wheel goes backward, so the robot spins clockwise (right) in place."},{"answer":1,"explain":"Curving left means the left wheel is slower (or the right is faster). Slowing the right wheel a little balances them."},{"answer":0,"explain":"Swapping a motor's two wires reverses the current through it. Never swap the battery pack's wires!"},{"answer":2,"explain":"Calibrating means changing numbers again and again. Having them in one place makes that quick and avoids mistakes."},{"answer":1,"explain":"range(4) gives four numbers."},{"answer":0,"explain":"Closing the other pair of switches flips the current."}],"debug":{"buggy_code":"from microbit import *\n\nTURN_TIME = 450\n\ndef set_motor(pin_a, pin_b, speed):\n    if speed > 0:\n        pin_a.write_analog(speed)\n        pin_b.write_digital(0)\n    elif speed < 0:\n        pin_a.write_digital(0)\n        pin_b.write_analog(-speed)\n    else:\n        pin_a.write_digital(0)\n        pin_b.write_digital(0)\n\ndef drive(left, right):\n    set_motor(pin13, pin14, left)\n    set_motor(pin15, pin16, right)\n\ndef turn_right():\n    drive(600, 600)\n    sleep(TURN_TIME)\n    drive(0, 0)\n\nfor side in range(3):\n    drive(700, 700)\n    sleep(1000)\n    drive(0, 0)\n    turn_right()\n","checks":[{"type":"syntax"},{"type":"not_contains","pattern":"def turn_right\\(\\)\\s*:[^\\n]*\\n(?:(?:[ \\t]+[^\\n]*)?\\n)*?[ \\t]+drive\\(\\s*(-?(?:[1-9]\\d*|[A-Za-z_]\\w*))\\s*,\\s*\\1\\s*\\)","message":"In turn_right(), the two wheels need DIFFERENT speeds, or the robot just goes straight."},{"type":"contains","pattern":"def turn_right\\(\\)\\s*:[^\\n]*\\n(?:(?:[ \\t]+[^\\n]*)?\\n)*?[ \\t]+drive\\(","message":"turn_right() should still call drive()."},{"type":"contains","pattern":"range\\(\\s*(0\\s*,\\s*)?4\\s*\\)","message":"A square has 4 sides - the loop should repeat 4 times."}]},"practice":{"checks":[{"type":"syntax"},{"type":"contains","pattern":"def\\s+turn_left\\(\\s*\\)\\s*:","message":"Start with def turn_left():"},{"type":"contains","pattern":"drive\\(\\s*-\\s*TURN_SPEED\\s*,\\s*TURN_SPEED\\s*\\)","message":"The left wheel goes backward, so its speed is negative."},{"type":"contains","pattern":"sleep\\(\
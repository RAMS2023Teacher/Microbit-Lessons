eft, right):\n    LEFT.write_analog(STOP_L + left * 25 // 100)\n    RIGHT.write_analog(STOP_R - right * 25 // 100)\n\ndef mission():\n    # Mission A: IR sensor on P0 reads 0 when something is in front\n    if pin0.read_digital() == 0:\n        display.show(Image.NO)\n        drive(-50, -50)   # back up\n        sleep(600)\n        drive(50, -50)    # spin right\n        sleep(400)\n    else:\n        display.show(Image.ARROW_N)\n        drive(50, 50)     # all clear: go\n\nrunning = False\ndrive(0, 0)\ndisplay.show(Image.HAPPY)\nwhile True:\n    if button_a.was_pressed():\n        running = True\n    if button_b.was_pressed():\n        running = False\n        drive(0, 0)\n        display.show(Image.SQUARE)\n    if running:\n        mission()\n    sleep(20)\n","buggy":"from microbit import *\n\nLEFT = pin13\nRIGHT = pin14\nLEFT.set_analog_period(20)\nRIGHT.set_analog_period(20)\nSTOP_L = 77\nSTOP_R = 77\n\ndef drive(left, right):\n    LEFT.write_analog(STOP_L + left * 25 // 100)\n    RIGHT.write_analog(STOP_R - right * 25 // 100)\n\nwhile True:\n    if pin1.read_digital() == 1:\n        drive(-50, -50)\n        drive(50, -50)\n        sleep(random.randint(300, 900))\n    else:\n        drive(50, 50)\n    sleep(20)\n","practice_starter":"from microbit import *\n\ndef drive(left, right):\n    pass   # your real drive() goes here\n\nwhile True:\n    # your bump rule\n    sleep(20)\n","stepped_count":4,"stepped_key":"circuit","card":{"id":"sprint-mission-day","number":"S5","title":"Sprint 5: Mission Day","subtitle":"Pick a mission and make your robot sense and react","duration_minutes":35,"level":"Robot Sprint","circuit":true,"lab":false,"standards":["6-8.CS.a.5","6-8.CS.a.4","6-8.CT.b.4","6-8.CT.d.3","6-8.CT.d.6"]}},"sprint-showcase":{"id":"sprint-showcase","title":"Sprint 6: Test, Upgrade, Showcase","number":"S6","unit":5,"kind":"lesson","section_keys":["warmup","learn","circuit","code","practice","debug","quiz","challenge"],"has_debug":true,"possible_xp":280,"quiz":
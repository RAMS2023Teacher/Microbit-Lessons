g:\n        last_heard = running_time()\n        if msg == 'F':\n            drive(700, 700)\n        elif msg == 'L':\n            drive(-500, 500)\n        elif msg == 'R':\n            drive(500, -500)\n        else:\n            drive(0, 0)\n    if running_time() - last_heard < 500:\n        drive(0, 0)\n    sleep(20)\n","checks":[{"type":"syntax"},{"type":"contains","pattern":"radio\\.on\\(\\s*\\)","message":"radio.on needs () or the radio never switches on."},{"type":"not_contains","pattern":"running_time\\(\\)\\s*-\\s*last_heard\\s*<=?\\s*\\d+\\s*:\\s*\\n\\s*drive\\(\\s*0\\s*,\\s*0\\s*\\)","message":"The fail-safe stops the robot when it HAS heard a message recently. It should stop when it hasn't."},{"type":"contains","pattern":"running_time\\(\\)\\s*-\\s*last_heard\\s*>=?\\s*\\d+|\\d+\\s*<=?\\s*running_time\\(\\)\\s*-\\s*last_heard|running_time\\(\\)\\s*>=?\\s*last_heard\\s*\\+\\s*\\d+","message":"Add a fail-safe that stops the robot when more than 500 ms have passed since last_heard."}]},"practice":{"checks":[{"type":"syntax"},{"type":"contains","pattern":"radio\\.on\\(\\)","message":"Turn the radio on first."},{"type":"contains","pattern":"msg\\s*=\\s*radio\\.receive\\(\\)","message":"Save radio.receive() in msg."},{"type":"contains","pattern":"if\\s+msg\\s*==\\s*['\\\"]H['\\\"]","message":"Compare msg with 'H'."},{"type":"contains","pattern":"Image\\.HEART","message":"Show Image.HEART."}]},"starter":"from microbit import *\nimport radio\n\nradio.config(group=12)   # your team's number, 0-255 - same on the robot!\nradio.on()\n\nTILT = 300   # how far you must tilt before it counts\n\nwhile True:\n    x = accelerometer.get_x()   # left / right tilt\n    y = accelerometer.get_y()   # forward / back tilt\n\n    if x < -TILT:\n        command = 'L'\n    elif x > TILT:\n        command = 'R'\n    elif y > TILT:\n        command = 'F'\n    else:\n        command = 'S'\n\n    radio.send(command)\n    display.show(command)\n    sleep(100)               # send 10 t
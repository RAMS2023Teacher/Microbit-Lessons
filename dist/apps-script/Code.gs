/**
 * micro:bit Maker Lab for Google Apps Script.
 *
 * This file is GENERATED by tools/build.py from apps_script/server/*.js.
 * Edit those files in the repository, rebuild, and paste the result. Setup steps: INSTALL.md.
 *
 * How it works
 *  - Deploy as a web app: Execute as "Me", access "Anyone within your school".
 *  - Everyone who opens it is identified by their school Google account.
 *  - The script owner is the teacher. Everyone else is a student.
 *  - Each student's work is one JSON file in the "Maker Lab data/students" folder of the
 *    teacher's Drive, so 30 students saving at once never wait for each other.
 */
var APP_NAME = 'micro:bit Maker Lab';
var DATA_FOLDER = 'Maker Lab data';
var MAX_TEXT = 20000;                // longest text a student can save in one field
var SUMMARY_MAX_AGE_MS = 60 * 1000;  // the gradebook refreshes changed students at most once a minute

// The Maker Lab logo (five yellow dots on a blue square), a 64x64 PNG. Saved to the Drive data folder
// the first time it's needed, so the browser tab can show it (Apps Script needs the icon at a web address).
var LOGO_PNG_ = '';

// ---------------------------------------------------------------- who is here
function whoIs_() {
  var email = '';
  try { email = (Session.getActiveUser().getEmail() || '').toLowerCase(); } catch (e) { email = ''; }
  var owner = (Session.getEffectiveUser().getEmail() || '').toLowerCase();
  return { email: email, teacher: !!email && email === owner };
}

function now_() { return new Date().toISOString(); }

// ---------------------------------------------------------------- reliability (docs/RELIABILITY.md)
// An error from Google means "try again", never "it's missing". Storage (folders, files) is only ever created when
// no id has EVER been saved for it, inside a lock, and a failed read is never replaced by a blank record.
var BUSY_MSG_ = 'BUSY: Maker Lab is very busy right now. Your work is safe. Trying again...';
function busy_() { var e = new Error(BUSY_MSG_); e.status = 503; return e; }

/** Run a Google call, trying again a few times. If it keeps failing, throw BUSY (the browser will retry). */
function retry_(fn) {
  for (var i = 0; i < 4; i++) {
    try { return fn(); } catch (e) {
      if (i === 3) { console.warn('Google call failed: ' + ((e && e.message) || e)); throw busy_(); }
      Utilities.sleep(250 * (i + 1));
    }
  }
}

/** Take turns for read-change-write of shared things. Keep it short: nothing slow inside. */
function withLock_(fn) {
  var lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (e) { throw busy_(); }
  try { return fn(); } finally { lock.releaseLock(); }
}

/** Every storage id ever set, so the right folder or file can always be found again. */
function rememberStorage_(key, id) {
  var props = PropertiesService.getScriptProperties(), list = [];
  try { list = JSON.parse(props.getProperty('storage:history') || '[]'); } catch (e) { list = []; }
  list.push({ key: key, id: id, at: now_() });
  props.setProperty('storage:history', JSON.stringify(list.slice(-40)));
}

// ---------------------------------------------------------------- Drive folders
function folder_(key, name, parentFn) {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty(key);
  if (id) return retry_(function () { return DriveApp.getFolderById(id); });   // can't open it now: BUSY, never a new one
  var parent = parentFn ? parentFn() : null;                                     // outside the lock (it may need its own)
  return withLock_(function () {
    var again = props.getProperty(key);                                          // another first visitor may have made it
    if (again) return retry_(function () { return DriveApp.getFolderById(again); });
    var f = parent ? parent.createFolder(name) : DriveApp.createFolder(name);
    props.setProperty(key, f.getId());
    rememberStorage_(key, f.getId());
    return f;
  });
}
function dataFolder_() { return folder_('folder:data', DATA_FOLDER, null); }
function studentFolder_() { return folder_('folder:students', 'students', dataFolder_); }
function backupFolder_() { return folder_('folder:backups', 'backups', dataFolder_); }

/** A saved JSON file. Throws BUSY if Drive fails; throws (never returns {}) if the file is damaged. */
function readJsonFile_(id) {
  var text = retry_(function () { return DriveApp.getFileById(id).getBlob().getDataAsString(); });
  try { return JSON.parse(text); } catch (e) { throw new Error('A Maker Lab data file is damaged (' + id + '). Nothing was changed. Ask Claude to look at it.'); }
}

/** A JSON file in the data folder, found by a script property. `fallback` only when it has never been made. */
function readNamed_(key, fallback) {
  var id = PropertiesService.getScriptProperties().getProperty('file:' + key);
  if (!id) return fallback;
  return readJsonFile_(id);
}
function writeNamed_(key, value) {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('file:' + key), text = JSON.stringify(value);
  if (id) { retry_(function () { DriveApp.getFileById(id).setContent(text); }); return; }
  var folder = dataFolder_();
  withLock_(function () {
    var again = props.getProperty('file:' + key);
    if (again) { retry_(function () { DriveApp.getFileById(again).setContent(text); }); return; }
    var f = folder.createFile(key + '.json', text, 'application/json');
    props.setProperty('file:' + key, f.getId());
    rememberStorage_('file:' + key, f.getId());
  });
}

// ---------------------------------------------------------------- teacher settings
// Only the teacher writes this file: classes, assignments, videos, feedback and bonus XP.
function emptyConfig_() {
  return { v: 1, classes: {}, assignments: [], videos: {}, feedback: {}, bonuses: {}, picks: {}, removed: {}, rosters: {}, next_id: 1 };
}
function config_() {
  var c = CacheService.getScriptCache().get('config');
  if (c) { var cached = JSON.parse(c); cached.rosters = cached.rosters || {}; return cached; }
  var cfg = readNamed_('config', null) || emptyConfig_();
  cfg.rosters = cfg.rosters || {};              // added with the Google Classroom import
  cacheConfig_(cfg);
  return cfg;
}
function cacheConfig_(cfg) {
  var text = JSON.stringify(cfg);
  if (text.length < 90000) CacheService.getScriptCache().put('config', text, 600);
  else CacheService.getScriptCache().remove('config');
}
function saveConfig_(cfg) {
  writeNamed_('config', cfg);
  cacheConfig_(cfg);
}
function nextId_(cfg) { var id = cfg.next_id || 1; cfg.next_id = id + 1; return id; }

/** Classes a student belongs to: joined with a code or on a Google Classroom roster, and not removed by the teacher. */
function studentClassIds_(rec, cfg) {
  var ids = (rec.classes || []).slice();
  Object.keys(cfg.rosters || {}).forEach(function (cid) { if (cfg.rosters[cid][rec.email] && ids.indexOf(cid) < 0) ids.push(cid); });
  return ids.filter(function (cid) {
    return cfg.classes[cid] && (cfg.removed[cid] || []).indexOf(rec.email) < 0;
  });
}

// ---------------------------------------------------------------- student files
function newStudent_(email) {
  return { v: 1, email: email, name: '', classes: [], xp: 0, avatar: null, badges: {}, xp_keys: {},
           xp_log: [], progress: {}, created_at: now_(), updated_at: now_() };
}
function studentFileId_(email) {
  return PropertiesService.getScriptProperties().getProperty('student:' + email);
}
/** A student's record. null ONLY when they have never had one (not joined). A read error throws BUSY. */
function loadStudent_(email) {
  var cached = CacheService.getScriptCache().get('s:' + email);
  if (cached) return JSON.parse(cached);
  var id = studentFileId_(email);
  if (!id) return null;
  return readJsonFile_(id);
}
function saveStudent_(rec) {
  rec.updated_at = now_();
  var text = JSON.stringify(rec);
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('student:' + rec.email);
  if (id) retry_(function () { DriveApp.getFileById(id).setContent(text); });       // fails: BUSY, never a second file
  else {
    var folder = studentFolder_();
    withLock_(function () {                                                         // first save of a new student
      var again = props.getProperty('student:' + rec.email);
      if (again) { retry_(function () { DriveApp.getFileById(again).setContent(text); }); return; }
      var name = 'student-' + rec.email.replace(/[^a-z0-9._-]/g, '_') + '.json';
      props.setProperty('student:' + rec.email, folder.createFile(name, text, 'application/json').getId());
    });
  }
  if (text.length < 90000) CacheService.getScriptCache().put('s:' + rec.email, text, 600);
  else CacheService.getScriptCache().remove('s:' + rec.email);
}

// ---------------------------------------------------------------- gradebook summary
// One small record per student, rebuilt from files that changed since the last look.
// The whole class opens the same views at once, so the summary is shared through the cache for a few seconds,
// and only one request at a time rebuilds it (the others use the copy they have).
function summary_(fresh) {
  var cache = CacheService.getScriptCache(), hit = !fresh && cache.get('summary');
  if (hit) return JSON.parse(hit);
  var s = readNamed_('summary', null) || { built_ms: 0, students: {} };
  if (!fresh && Date.now() - (s.built_ms || 0) < SUMMARY_MAX_AGE_MS) { cacheSummary_(s); return s; }
  if (!fresh && s.built_ms && cache.get('summary:building')) return s;         // someone else is rebuilding it
  cache.put('summary:building', '1', 30);
  var since = (s.built_ms || 0) - 120000;       // overlap a little, Drive times are rounded
  var started = Date.now();
  var props = PropertiesService.getScriptProperties().getProperties();
  var byId = {};
  Object.keys(props).forEach(function (k) { if (k.indexOf('student:') === 0) byId[props[k]] = k.slice(8); });
  // Walk the folder instead of using a Drive search query (real Drive rejected the query: "Invalid argument: q").
  var it = studentFolder_().getFiles();
  while (it.hasNext()) {
    var f = it.next();
    var email = byId[f.getId()];
    if (!email || f.getLastUpdated().getTime() <= since) continue;
    try { s.students[email] = studentSummary_(JSON.parse(f.getBlob().getDataAsString())); } catch (e) { /* skip a bad file */ }
  }
  s.built_ms = started;
  writeNamed_('summary', s);
  cacheSummary_(s);
  cache.remove('summary:building');
  return s;
}
function cacheSummary_(s) {
  try { var t = JSON.stringify(s); if (t.length < 95000) CacheService.getScriptCache().put('summary', t, 20); } catch (e) { /* too big to share: fine */ }
}

function studentSummary_(rec) {
  var lessons = {};
  Object.keys(rec.progress || {}).forEach(function (lid) {
    var L = DATA.lessons[lid];
    if (!L) return;
    var p = rec.progress[lid];
    lessons[lid] = { pct: percent_(p, L), stage: currentStage_(L, p), stages: stagesDone_(L, p),
                     steps_done: stepsDone_(L, p), steps_total: L.build.length,
                     quiz_best: p.quiz_best == null ? null : p.quiz_best, quiz_total: p.quiz_total || 0,
                     shipped: !!p.shipped_at, share: p.share || '', stars: lessonStars_(L, p),
                     completed_at: p.completed_at || null, updated_at: p.updated_at || null, partner: p.partner || null };
  });
  return { name: rec.name, classes: rec.classes || [], xp: rec.xp || 0, avatar: rec.avatar ? avatarOf_(rec) : null,
           badges: Object.keys(rec.badges || {}), lessons: lessons, updated_at: rec.updated_at, wins: recentWins_(rec),
           xp_recent: recentXp_(rec), fb: fbSummary_(rec),
           arcade: rec.arcade ? { best: rec.arcade.best || 0, day: rec.arcade.day || '', day_best: rec.arcade.day_best || 0, games: rec.arcade.games || null } : null };
}

/** XP earned in the last day and a half, as [time, amount] pairs: the class display adds up today's for the class goal. */
function recentXp_(rec) {
  var since = new Date(Date.now() - 36 * 3600 * 1000).toISOString();
  return (rec.xp_log || []).filter(function (e) { return e.at >= since && e.amount > 0; }).map(function (e) { return [e.at, e.amount]; });
}

/** A student's last few wins for the class display: badges, finished lessons, perfect quizzes, teacher bonuses. */
function winKind_(e) {
  var key = e.key || '', r = e.reason || '';
  if (key.indexOf('badge:') === 0 || (!key && r.indexOf('Badge: ') === 0)) return 'badge';
  if (key.indexOf('complete:') === 0) return 'complete';
  if (key.indexOf('ship:') === 0) return 'ship';
  if (key.indexOf('quiz_perfect:') === 0) return 'quiz_perfect';
  if (key.indexOf('bonus:') === 0 || (!key && r.indexOf('Bonus from your teacher') === 0)) return 'bonus';
  return null;
}
function recentWins_(rec) {
  return (rec.xp_log || []).filter(winKind_).slice(0, 5).map(function (e) {
    return { kind: winKind_(e), reason: e.reason, at: e.at };
  });
}

// ---------------------------------------------------------------- lesson progress
// A lesson has four stages: Mission, Build (one step per screen), Quiz, Ship it.
// Progress for one lesson (rec.progress[lessonId]):
//   mission_done, talk                      the mission's partner question
//   steps: { "0": {tests: [0, 1], answer, fields: [...], done} }, step_at
//   quiz_answers, quiz_score, quiz_best, quiz_total, quiz_attempts
//   ext: { "0": true }, reflect: [...], share, shipped_at
//   partner, started_at, updated_at, completed_at

var STAGES_ = [['mission', 'Mission', '🎯'], ['build', 'Build', '🛠️'], ['quiz', 'Quiz', '🧠'], ['ship', 'Ship it', '🚀']];
var SHARE_RE_ = /^https:\/\/(makecode\.microbit\.org|makecode\.com)\/[\w\-#?=&%.\/]+$/i;

function stepDone_(L, p, i) { return !!(p && p.steps && p.steps[i] && p.steps[i].done); }
function stepsDone_(L, p) { var n = 0; for (var i = 0; i < L.build.length; i++) if (stepDone_(L, p, i)) n++; return n; }
function quizPassed_(L, p) { return !!(p && p.quiz_total && p.quiz_best / p.quiz_total >= DATA.quiz_pass); }
function quizPerfect_(p) { return !!(p && p.quiz_total && p.quiz_best === p.quiz_total); }

/** Which stages are finished: {mission, build, quiz, ship}. */
function stagesDone_(L, p) {
  return { mission: !!(p && p.mission_done), build: stepsDone_(L, p) === L.build.length, quiz: quizPassed_(L, p), ship: !!(p && p.shipped_at) };
}

/** The first stage that isn't finished, or 'done'. */
function currentStage_(L, p) {
  var d = stagesDone_(L, p);
  for (var i = 0; i < STAGES_.length; i++) if (!d[STAGES_[i][0]]) return STAGES_[i][0];
  return 'done';
}

/** Percent done: the mission, every build step, the quiz and shipping each count as one part. */
function percent_(p, L) {
  if (!p) return 0;
  var d = stagesDone_(L, p), total = L.build.length + 3;
  return Math.round(100 * ((d.mission ? 1 : 0) + stepsDone_(L, p) + (d.quiz ? 1 : 0) + (d.ship ? 1 : 0)) / total);
}

/** 0-3 stars: perfect quiz · at least one extension · shipped. */
function lessonStars_(L, p) {
  if (!p) return 0;
  var ext = Object.keys(p.ext || {}).some(function (k) { return p.ext[k]; });
  return (quizPerfect_(p) ? 1 : 0) + (ext ? 1 : 0) + (p.shipped_at ? 1 : 0);
}

/** A step counts when every Test it box is ticked, its question is answered and its blanks are filled. */
function stepComplete_(S, row) {
  var ticked = row.tests || [];
  for (var t = 0; t < (S.test || []).length; t++) if (ticked.indexOf(t) < 0) return false;
  if (S.ask && String(row.answer || '').trim().length < 2) return false;
  for (var f = 0; f < (S.fields || []).length; f++) if (!String((row.fields || [])[f] || '').trim()) return false;
  return true;
}

/** What's still missing before a project can be shipped (empty when it's ready). */
function shipMissing_(L, p) {
  var out = [], ship = L.ship || {};
  if (!SHARE_RE_.test(String(p.share || ''))) out.push('Paste your MakeCode share link (it starts with https://makecode.microbit.org/).');
  if ((ship.extensions || []).length && !Object.keys(p.ext || {}).some(function (k) { return p.ext[k]; })) out.push('Check at least one extension you added.');
  (ship.reflect || []).forEach(function (q, i) {
    if (String((p.reflect || [])[i] || '').trim().length < 3) out.push('Answer: ' + q);
  });
  return out;
}

function gradeQuiz_(L, answers) {
  var results = L.quiz.map(function (q, i) {
    return { correct: answers[i] === q.answer, answer: q.answer, why: q.why };
  });
  var score = results.filter(function (r) { return r.correct; }).length;
  return { score: score, total: L.quiz.length, results: results, passed: score / L.quiz.length >= DATA.quiz_pass };
}

// ---------------------------------------------------------------- XP, levels, badges, map, avatars
// A JavaScript copy of app/gamify.py. The numbers (XP values, levels, badges, map, avatar parts)
// come from gamify.py through the build, so there is still one place to change them.

function levelInfo_(xp) {
  var levels = DATA.levels, lvl = 1;
  for (var i = 0; i < levels.length; i++) if (xp >= levels[i][0]) lvl = i + 1;
  var floor = levels[lvl - 1][0], next = lvl < levels.length ? levels[lvl][0] : null;
  return { level: lvl, title: levels[lvl - 1][1], xp: xp, floor: floor, next: next,
           pct: next === null ? 100 : Math.round(100 * (xp - floor) / (next - floor)), max: next === null };
}

function badgeById_(id) {
  for (var i = 0; i < DATA.badges.length; i++) {
    var b = DATA.badges[i];
    if (b[0] === id) return { id: b[0], icon: b[1], name: b[2], desc: b[3] };
  }
  return null;
}

// ---------------------------------------------------------------- courses (grades)
// Each class is set to a course (cfg.classes[cid].grade: 'g6' or 'g7'). A student follows their first class's course.
function courseOfClass_(cfg, cid) { var c = cfg.classes[cid]; return c && DATA.courses[c.grade] ? c.grade : DATA.default_course; }
function courseOf_(rec, cfg) { var ids = studentClassIds_(rec, cfg); return ids.length ? courseOfClass_(cfg, ids[0]) : DATA.default_course; }
/** The written lessons of a course in order, or of every course when cid is empty (the teacher's view). */
function lessonList_(cid) {
  return (cid ? DATA.courses[cid].order : DATA.order).filter(function (id) { return DATA.lessons[id]; }).map(function (id) { return DATA.lessons[id]; });
}

function complete_(L, p) { return !!p && percent_(p, L) === 100; }

/** Counts the badge rules in course/rules.py look at. */
function rewardCounts_(rec) {
  var c = { steps: 0, lessons: 0, wired: 0, perfect: 0, first_try: 0, extensions: 0, shipped: 0, partner: 0, done: {} };
  Object.keys(rec.progress || {}).forEach(function (lid) {
    var L = DATA.lessons[lid], p = rec.progress[lid];
    if (!L || !p) return;
    c.steps += stepsDone_(L, p);
    if (quizPerfect_(p)) { c.perfect++; if (p.quiz_attempts === 1) c.first_try++; }
    c.extensions += Object.keys(p.ext || {}).filter(function (k) { return p.ext[k]; }).length;
    if (p.shipped_at) c.shipped++;
    if (complete_(L, p)) {
      c.lessons++; c.done[lid] = 1;
      if (L.wired) c.wired++;
      if (p.partner) c.partner++;
    }
  });
  return c;
}

function badgeChecks_(rec, cfg) {
  var c = rewardCounts_(rec), earned = {};
  DATA.badges.forEach(function (b) {
    var rule = b[4] || [], ok = false;
    if (rule[0] === 'lesson') ok = !!c.done[rule[1]];
    else if (rule[0] === 'avatar') ok = !!rec.avatar;
    else if (rule[0] === 'teacher') ok = !!(cfg.picks || {})[rec.email];
    else if (rule[0] === 'early') {
      var classes = studentClassIds_(rec, cfg);
      ok = cfg.assignments.some(function (a) {
        var p = (rec.progress || {})[a.lesson_id];
        return classes.indexOf(a.class_id) >= 0 && a.due && p && p.completed_at && p.completed_at.slice(0, 10) <= a.due;
      });
    } else if (rule[0] === 'course_done') {
      var list = lessonList_(courseOf_(rec, cfg));
      ok = list.length > 0 && list.every(function (L) { return complete_(L, (rec.progress || {})[L.id]); });
    } else if (c[rule[0]] !== undefined) ok = c[rule[0]] >= rule[1];
    if (ok) earned[b[0]] = 1;
  });
  return earned;
}

function award_(rec, key, amount, reason, gained) {
  if (rec.xp_keys[key] !== undefined) return;
  rec.xp_keys[key] = amount;
  rec.xp = (rec.xp || 0) + amount;
  rec.xp_log.unshift({ amount: amount, reason: reason, at: now_(), key: key });
  if (rec.xp_log.length > 100) rec.xp_log.length = 100;
  gained.push({ amount: amount, reason: reason });
}

/** Awards any XP and badges the student has earned but not yet received. Never double-counts. */
function syncRewards_(rec, cfg) {
  var before = levelInfo_(rec.xp || 0), gained = [], X = DATA.xp, T = DATA.labels;
  rec.xp_keys = rec.xp_keys || {}; rec.xp_log = rec.xp_log || []; rec.badges = rec.badges || {};
  Object.keys(rec.progress || {}).forEach(function (lid) {
    var L = DATA.lessons[lid], p = rec.progress[lid];
    if (!L || !p) return;
    var t = ' · ' + L.title;
    if (p.mission_done) award_(rec, 'mission:' + lid, X.mission, T.mission + t, gained);
    for (var i = 0; i < L.build.length; i++) if (stepDone_(L, p, i)) award_(rec, 'step_' + i + ':' + lid, X.step, T.step + ': ' + L.build[i].title, gained);
    if (quizPassed_(L, p)) award_(rec, 'quiz:' + lid, X.quiz, T.quiz + t, gained);
    if (quizPerfect_(p)) {
      award_(rec, 'quiz_perfect:' + lid, X.quiz_perfect, T.quiz_perfect + t, gained);
      if (p.quiz_attempts === 1) award_(rec, 'quiz_first_try:' + lid, X.quiz_first_try, T.quiz_first_try + t, gained);
    }
    Object.keys(p.ext || {}).forEach(function (k) {
      var E = ((L.ship || {}).extensions || [])[+k];
      if (p.ext[k] && E) award_(rec, 'ext_' + k + ':' + lid, X.extension, T.extension + ': ' + E.title, gained);
    });
    if (p.shipped_at) award_(rec, 'ship:' + lid, X.ship, T.ship + t, gained);
    if (complete_(L, p)) {
      if (rec.xp_keys['complete:' + lid] === undefined) openArcade_(rec);     // a finished lesson opens Robot Rush for a few minutes
      award_(rec, 'complete:' + lid, X.complete, T.complete + t, gained);
    }
  });
  Object.keys(rec.lesson_fb || {}).forEach(function (lid) {     // rating a lesson (60_feedback.js)
    var L = DATA.lessons[lid];
    if (L && rec.lesson_fb[lid].rating) award_(rec, 'rate:' + lid, X.rating, T.rating + ' · ' + L.title, gained);
  });
  ((cfg.bonuses || {})[rec.email] || []).forEach(function (b) { award_(rec, b.key, b.amount, b.reason, gained); });
  var newBadges = [], earned = badgeChecks_(rec, cfg);
  Object.keys(earned).sort().forEach(function (bid) {
    if (rec.badges[bid]) return;
    var b = badgeById_(bid);
    if (!b) return;
    rec.badges[bid] = now_();
    award_(rec, 'badge:' + bid, X.badge, 'Badge: ' + b.name, gained);
    newBadges.push(b);
  });
  var after = levelInfo_(rec.xp || 0);
  return { xp_gained: gained.reduce(function (t, g) { return t + g.amount; }, 0), items: gained.slice(0, 6),
           badges: newBadges, level: after, level_up: after.level > before.level };
}

function lessonXp_(rec, lid) {
  var total = 0;
  Object.keys(rec.xp_keys || {}).forEach(function (k) {
    var i = k.indexOf(':');
    if (i > 0 && k.slice(i + 1) === lid) total += rec.xp_keys[k];
  });
  return total;
}

function possibleXp_(L) {
  var X = DATA.xp;
  return X.mission + X.step * L.build.length + X.quiz + X.quiz_perfect + X.quiz_first_try +
    X.extension * ((L.ship || {}).extensions || []).length + X.ship + X.complete;
}

/** Badges for a student's course: a badge for a lesson in another course is left out (unless they earned it). */
function badgeList_(rec, cid) {
  return DATA.badges.filter(function (b) {
    var r = b[4] || [], plan = r[0] === 'lesson' ? DATA.course_by_id[r[1]] : null;
    return !cid || !plan || plan.course === cid || (rec.badges || {})[b[0]];
  }).map(function (b) {
    var at = (rec.badges || {})[b[0]];
    return { id: b[0], icon: b[1], name: b[2], desc: b[3], earned: !!at, earned_at: at || null };
  });
}

// ---------------------------------------------------------------- the skill tree
/** Lessons a student's class assigned. */
function assignedIds_(rec, cfg) {
  var classes = studentClassIds_(rec, cfg), out = {};
  cfg.assignments.forEach(function (a) { if (classes.indexOf(a.class_id) >= 0) out[a.lesson_id] = 1; });
  return out;
}

var COLOR_UNIT_ = { blue: 1, gold: 2, green: 3, red: 4, purple: 5, teal: 6, orange: 7, pink: 4 };

function mapData_(rec, assigned, cid) {
  var course = DATA.courses[cid || DATA.default_course], plan = course.plan, requires = course.requires;
  var prog = (rec && rec.progress) || {}, complete = {}, nodes = [], current = null;
  plan.forEach(function (c) { var L = DATA.lessons[c.id]; if (L && complete_(L, prog[c.id])) complete[c.id] = 1; });
  var recent = Object.keys(prog).filter(function (l) { return DATA.lessons[l] && DATA.lessons[l].course === course.id && !complete[l]; })
    .sort(function (a, b) { return String(prog[b].updated_at || '').localeCompare(String(prog[a].updated_at || '')); });
  if (recent.length) current = recent[0];
  plan.forEach(function (c, i) {
    var L = DATA.lessons[c.id], p = prog[c.id], pct = L && p ? percent_(p, L) : 0;
    var reqs = requires[c.id] || [];
    var unlocked = !reqs.length || reqs.some(function (r) { return complete[r]; }) || assigned[c.id] || pct > 0;
    var state = !L ? 'locked' : complete[c.id] ? 'complete' : pct > 0 ? 'progress' : unlocked ? 'open' : 'locked';
    nodes.push({ id: c.id, number: c.number, title: c.title, unit: COLOR_UNIT_[c.color] || 1, x: c.pos[0], y: c.pos[1],
                 requires: i === 0 ? [] : reqs,
                 requires_titles: !L ? ['Coming soon'] : reqs.filter(function (r) { return !complete[r]; }).map(function (r) { return DATA.course_by_id[r].title; }),
                 or_titles: reqs.length > 1 ? reqs.map(function (r) { return DATA.course_by_id[r].title; }) : [],
                 state: state, pct: pct, stars: L ? lessonStars_(L, p) : 0, assigned: !!assigned[c.id],
                 xp_possible: L ? possibleXp_(L) : 0, soon: !L });
  });
  if (!current) {
    var open = nodes.filter(function (n) { return n.state === 'open'; })[0];
    current = open ? open.id : (nodes.length ? nodes[0].id : null);
  }
  return { nodes: nodes, current: current, units: {}, course: { id: course.id, name: course.name } };
}

// ---------------------------------------------------------------- avatars
function avatarOf_(rec) {
  var a = JSON.parse(JSON.stringify(DATA.default_avatar));
  if (rec && rec.avatar) Object.keys(a).forEach(function (k) { if (rec.avatar[k] !== undefined) a[k] = rec.avatar[k]; });
  var card = (DATA.avatar_options.card || []).filter(function (o) { return o[0] === a.card; })[0];     // the calling card's words travel with the robot
  if (card && card[0] !== 'none') { a.card_text = card[1]; a.card_style = cardStyle_(card[2]); }
  return a;
}
function cardStyle_(u) { return u ? (DATA.card_styles || {})[u[0]] || 'plain' : 'plain'; }
function unlockText_(u) {
  if (!u) return '';
  if (u[0] === 'cost') return 'Buy it for ' + u[1] + ' XP';
  if (gameById_(u[0])) return 'Score ' + u[1] + ' in ' + gameById_(u[0]).name;
  return u[0] === 'level' ? 'Reach level ' + u[1] : 'Earn the ' + badgeById_(u[1]).name + ' badge';
}
function isUnlocked_(u, level, badges, owned, part, id, bests) {
  if (!u) return true;
  if (u[0] === 'cost') return !!(owned || {})['part:' + part + ':' + id];
  if (gameById_(u[0])) return ((bests || {})[u[0]] || 0) >= u[1];          // won in the arcade: a best score in that game
  return u[0] === 'level' ? level >= u[1] : !!badges[u[1]];
}
function avatarCatalog_(rec, teacher) {
  var level = levelInfo_((rec && rec.xp) || 0).level, badges = (rec && rec.badges) || {}, owned = (rec && rec.owned) || {}, out = {}, bests = gameBests_(rec);
  Object.keys(DATA.avatar_options).forEach(function (part) {
    out[part] = DATA.avatar_options[part].map(function (o) {
      return { id: o[0], label: o[1], unlocked: teacher || isUnlocked_(o[2], level, badges, owned, part, o[0], bests), how: unlockText_(o[2]),
               cost: o[2] && o[2][0] === 'cost' ? o[2][1] : 0, style: part === 'card' ? cardStyle_(o[2]) : undefined };
    });
  });
  return out;
}
function cleanAvatar_(rec, data, teacher) {
  var level = levelInfo_(rec.xp || 0).level, out = {};
  var parts = Object.keys(DATA.avatar_options);
  for (var i = 0; i < parts.length; i++) {
    var part = parts[i], choice = data[part] === undefined ? DATA.default_avatar[part] : data[part];
    var match = DATA.avatar_options[part].filter(function (o) { return o[0] === choice; })[0];
    if (!match) return { error: 'Unknown ' + part };
    if (!teacher && !isUnlocked_(match[2], level, rec.badges || {}, rec.owned, part, choice, gameBests_(rec))) return { error: match[1] + ' is still locked: ' + unlockText_(match[2]) + '.' };
    out[part] = choice;
  }
  var name = String(data.name || '').trim();
  if (!/^[A-Za-z0-9 .\-_!']{0,20}$/.test(name)) return { error: 'Robot names can be up to 20 letters, numbers and spaces.' };
  out.name = name;
  return { avatar: out };
}

// ---------------------------------------------------------------- the shop and the arcade games (Robot Rush, Circuit Driver)
// XP to spend = all the XP a student ever earned minus what they spent. Levels count all earned XP, so
// shopping never lowers a level. Robot Rush (client/lib/game.js) is closed unless the teacher opens the arcade
// for a class (class display or class page). Finishing a lesson banks DATA.arcade.minutes of play time; each race
// uses its length from the bank, and only while the arcade is open for the student's class.
// Scores are checked here: a race has to be started on the server and take about as long as the race clock,
// and a score can't be more than a robot could make.

function spendable_(rec) { return Math.max(0, ((rec && rec.xp) || 0) - ((rec && rec.spent) || 0)); }

function powerLevels_(rec) {
  var out = {};
  DATA.powerups.forEach(function (u) { out[u.id] = Math.min(u.costs.length, ((rec && rec.powerups) || {})[u.id] || 0); });
  return out;
}

// Games are listed in DATA.games (course/rules.py). Robot Rush keeps its scores where they always were
// (rec.arcade.best, .day, .day_best); every other game has the same three under rec.arcade.games[id].
function gameById_(id) { return (DATA.games || []).filter(function (g) { return g.id === id; })[0] || null; }
function gameStats_(a, id, make) {
  if (id === 'rush') return a;
  if (make) { a.games = a.games || {}; a.games[id] = a.games[id] || {}; }
  return (a.games || {})[id] || {};
}
function gameBests_(rec) {
  var out = {}, a = (rec && rec.arcade) || {};
  (DATA.games || []).forEach(function (g) { out[g.id] = gameStats_(a, g.id).best || 0; });
  return out;
}
function gameOpen_(g, rec) { return !g.unlock || levelInfo_((rec && rec.xp) || 0).level >= g.unlock[1]; }
function gameList_(rec, teacher) {
  var bests = gameBests_(rec);
  return (DATA.games || []).map(function (g) {
    return { id: g.id, icon: g.icon, name: g.name, desc: g.desc, unlocked: teacher || gameOpen_(g, rec), how: g.unlock ? 'Reach level ' + g.unlock[1] : '', best: bests[g.id] };
  });
}

function raceSeconds_(levels) { return DATA.arcade.race_seconds + 5 * (levels.time || 0); }

function arcadeDay_() { return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd'); }

var ARCADE_BANK_MAX_ = 15 * 60;            // play time a student can save up, in seconds

/** Finishing a lesson banks play time (it doesn't open the arcade: only the teacher does that). */
function openArcade_(rec) {
  var a = rec.arcade = rec.arcade || {};
  a.bank = Math.min(ARCADE_BANK_MAX_, (a.bank || 0) + DATA.arcade.minutes * 60);
}

/** Is the arcade open for this student's class right now, and how much play time do they have? */
function arcadeState_(rec, cfg) {
  var classes = studentClassIds_(rec, cfg).map(function (cid) { return cfg.classes[cid]; }).filter(Boolean), until = '';
  classes.forEach(function (c) { if (c.arcade_until && c.arcade_until > until) until = c.arcade_until; });
  var left = until ? Math.floor((new Date(until).getTime() - Date.now()) / 1000) : 0, bank = Math.max(0, Math.round((rec.arcade || {}).bank || 0));
  return { open: left > 0, seconds_left: Math.max(0, left), bank: bank, can_play: left > 0 && bank > 0, minutes: DATA.arcade.minutes };
}

function arcadeBoards_(cfg, cid, fresh) {
  var out = {};
  (DATA.games || []).forEach(function (g) { out[g.id] = arcadeBoard_(cfg, cid, fresh, g.id); });
  return out;
}

/** The class leaderboard for one game: top 10 today and of all time. `fresh` is a student record newer than the summary. */
function arcadeBoard_(cfg, cid, fresh, game) {
  game = game || 'rush';
  if (!cid || !cfg.classes[cid]) return { today: [], all: [] };
  var sum = summary_(), day = arcadeDay_(), students = classStudents_(cfg, sum, cid), names = shownNames_(students, 'first');
  var rows = students.map(function (s) {
    var me = !!fresh && fresh.email === s.email, a = gameStats_(me ? (fresh.arcade || {}) : ((sum.students[s.email] || {}).arcade || {}), game);
    return { name: names[s.email], avatar: me ? avatarOf_(fresh) : (s.avatar || null), best: a.best || 0,
             today: a.day === day ? (a.day_best || 0) : 0, me: me };
  });
  var top = function (k) {
    return rows.filter(function (r) { return r[k] > 0; }).sort(function (a, b) { return b[k] - a[k]; }).slice(0, 10)
      .map(function (r) { return { name: r.name, avatar: r.avatar, score: r[k], me: r.me }; });
  };
  return { today: top('today'), all: top('best') };
}

function shopCatalog_(rec) {
  var lv = powerLevels_(rec);
  return DATA.powerups.map(function (u) {
    return { id: u.id, icon: u.icon, name: u.name, desc: u.desc, level: lv[u.id], max: u.costs.length,
             next_cost: lv[u.id] < u.costs.length ? u.costs[lv[u.id]] : null };
  });
}

/** Everything the Arcade page shows. */
function arcadeData_(rec, cfg, teacher) {
  if (teacher) {
    return { practice: true, state: { open: true, can_play: true, bank: 0 }, spendable: 0, shop: shopCatalog_(null), powerups: powerLevels_(null),
             race_seconds: DATA.arcade.race_seconds, best: 0, board: { today: [], all: [] }, boards: {}, games: gameList_(null, true), minutes: DATA.arcade.minutes };
  }
  var a = rec.arcade || {};
  return { state: arcadeState_(rec, cfg), spendable: spendable_(rec), shop: shopCatalog_(rec), powerups: powerLevels_(rec),
           race_seconds: raceSeconds_(powerLevels_(rec)), best: a.best || 0, plays: a.plays || 0, minutes: DATA.arcade.minutes,
           board: arcadeBoard_(cfg, studentClassIds_(rec, cfg)[0], rec), boards: arcadeBoards_(cfg, studentClassIds_(rec, cfg)[0], rec),
           games: gameList_(rec, false) };
}

// ---------------------------------------------------------------- student API: /api/shop/buy, /api/arcade/start, /api/arcade/finish
function shopApi_(path, d) {
  if (whoIs_().teacher) {          // the teacher's preview: nothing is saved
    if (path === '/api/arcade/start') return { ok: true, practice: true, run_id: 'practice', seconds: DATA.arcade.race_seconds, powerups: powerLevels_(null), game: String(d.game || 'rush') };
    if (path === '/api/arcade/finish') return { ok: true, practice: true, score: Math.round(Number(d.score) || 0) };
    return { ok: false, error: 'This is the student shop. Students buy items with the XP they earn.' };
  }
  var ctx = student_();
  if (path === '/api/shop/buy') return shopBuy_(ctx, d);
  if (path === '/api/arcade/start') return arcadeStart_(ctx, d);
  return arcadeFinish_(ctx, d);
}

function shopBuy_(ctx, d) {
  var rec = ctx.rec, item = String(d.item || ''), m, cost, power = null, level = 0;
  rec.owned = rec.owned || {};
  rec.powerups = rec.powerups || {};
  if ((m = /^part:(\w+):([\w-]+)$/.exec(item))) {
    var opt = (DATA.avatar_options[m[1]] || []).filter(function (o) { return o[0] === m[2]; })[0];
    if (!opt || !opt[2] || opt[2][0] !== 'cost') throw badRequest_("That isn't for sale.");
    if (rec.owned[item]) return { ok: true, already: true, spendable: spendable_(rec), catalog: avatarCatalog_(rec, false) };
    cost = opt[2][1];
  } else if ((m = /^power:(\w+)$/.exec(item))) {
    power = DATA.powerups.filter(function (u) { return u.id === m[1]; })[0];
    if (!power) throw badRequest_('No such power-up.');
    level = powerLevels_(rec)[power.id];
    if (level >= power.costs.length) return { ok: false, error: power.name + ' is already at the top level.' };
    cost = power.costs[level];
  } else throw badRequest_('No such item.');
  if (spendable_(rec) < cost) return { ok: false, error: 'You need ' + (cost - spendable_(rec)) + ' more XP to spend. Finish more steps to earn it!', spendable: spendable_(rec) };
  rec.spent = (rec.spent || 0) + cost;
  if (power) rec.powerups[power.id] = level + 1; else rec.owned[item] = now_();
  rec.shop_log = rec.shop_log || [];
  rec.shop_log.unshift({ item: item, cost: cost, at: now_() });
  if (rec.shop_log.length > 60) rec.shop_log.length = 60;
  saveStudent_(rec);
  return { ok: true, spendable: spendable_(rec), shop: shopCatalog_(rec), powerups: powerLevels_(rec), catalog: avatarCatalog_(rec, false),
           race_seconds: raceSeconds_(powerLevels_(rec)) };
}

function arcadeStart_(ctx, d) {
  var rec = ctx.rec, st = arcadeState_(rec, ctx.cfg), game = gameById_(String((d || {}).game || 'rush'));
  if (!game) throw badRequest_('No such game.');
  if (!gameOpen_(game, rec)) return { ok: false, error: game.name + ' unlocks at level ' + game.unlock[1] + '. Keep building!' };
  if (!st.open) return { ok: false, closed: true, error: 'The arcade is closed. Your teacher opens it in class.' };
  if (!st.bank) return { ok: false, error: 'You need play time: finish a lesson to earn ' + DATA.arcade.minutes + ' minutes.' };
  var a = rec.arcade = rec.arcade || {}, levels = powerLevels_(rec), id = Math.random().toString(36).slice(2, 10), secs = raceSeconds_(levels);
  a.runs = (a.runs || []).filter(function (r) { return Date.now() - new Date(r.at).getTime() < 15 * 60000; }).slice(-4);
  a.runs.push({ id: id, at: now_(), game: game.id });
  a.plays = (a.plays || 0) + 1;
  a.bank = Math.max(0, (a.bank || 0) - secs);         // a race uses its length from the bank
  saveStudent_(rec);
  return { ok: true, run_id: id, seconds: secs, powerups: levels, bank: a.bank, game: game.id };
}

function arcadeFinish_(ctx, d) {
  var rec = ctx.rec, a = rec.arcade = rec.arcade || {};
  var run = (a.runs || []).filter(function (r) { return r.id === d.run_id; })[0];
  if (!run) return { ok: false, error: "That race wasn't found. Start a new one." };
  a.runs = a.runs.filter(function (r) { return r !== run; });
  var secs = raceSeconds_(powerLevels_(rec)), took = (Date.now() - new Date(run.at).getTime()) / 1000;
  var game = gameById_(run.game || 'rush') || gameById_('rush'), score = Math.max(0, Math.round(Number(d.score) || 0));
  if (took < secs - 3 || took > secs + 600 || score > secs * game.max_per_second) {
    saveStudent_(rec);
    return { ok: false, error: "That score couldn't be counted. Try another race!" };
  }
  var g = gameStats_(a, game.id, true), day = arcadeDay_(), newBest = score > (g.best || 0), before = avatarUnlockCount_(rec);
  if (newBest) { g.best = score; g.best_at = now_(); }
  if (g.day !== day) { g.day = day; g.day_best = 0; }
  var dayBest = score > (g.day_best || 0);
  if (dayBest) g.day_best = score;
  g.last = score;
  saveStudent_(rec);
  return { ok: true, score: score, best: g.best, new_best: newBest, day_best: g.day_best, new_day_best: dayBest, game: game.id,
           unlocked: wonParts_(rec, game.id, score, newBest ? before : null),
           board: arcadeBoard_(ctx.cfg, studentClassIds_(rec, ctx.cfg)[0], rec, game.id), state: arcadeState_(rec, ctx.cfg) };
}

/** Robot parts this score just won (parts with a ("rush" | "circuit", n) unlock that n now reaches for the first time). */
function avatarUnlockCount_(rec) { return gameBests_(rec); }
function wonParts_(rec, gameId, score, before) {
  if (!before) return [];
  var out = [];
  Object.keys(DATA.avatar_options).forEach(function (part) {
    DATA.avatar_options[part].forEach(function (o) {
      if (o[2] && o[2][0] === gameId && score >= o[2][1] && (before[gameId] || 0) < o[2][1]) out.push(o[1]);
    });
  });
  return out;
}

// ---------------------------------------------------------------- teacher: open and close the arcade for a class
function arcadeTeacher_(cfg, cid) {
  var c = cfg.classes[cid], left = c.arcade_until ? Math.floor((new Date(c.arcade_until).getTime() - Date.now()) / 1000) : 0;
  return { open: left > 0, seconds_left: Math.max(0, left), minutes: DATA.arcade.minutes, board: arcadeBoard_(cfg, cid, null) };
}

/** action: 'open' (for `minutes`, default 60, e.g. until the bell), 'close', or 'gift' (everyone in the class gets
 *  DATA.arcade.minutes of play time). The arcade is closed unless the teacher opens it. */
function arcadeClass(cid, action, minutes) {
  var cfg = teacher_(), c = cfg.classes[cid];
  if (!c) throw new Error('No such class.');
  if (action === 'open') {
    var m = Math.max(5, Math.min(180, Math.round(Number(minutes) || 60)));
    c.arcade_until = new Date(Date.now() + m * 60000).toISOString();
  } else if (action === 'close') c.arcade_until = '';
  else if (action === 'gift') {
    var sum = summary_(true), n = 0;                // fresh: include students who just joined
    classStudents_(cfg, sum, cid).forEach(function (s) {
      var rec = loadStudent_(s.email);
      if (!rec) return;
      openArcade_(rec);
      saveStudent_(rec);
      n += 1;
    });
    var out = arcadeTeacher_(cfg, cid);
    out.gifted = n;
    return out;
  } else throw new Error('Unknown action.');
  saveConfig_(cfg);
  return arcadeTeacher_(cfg, cid);
}

// ---------------------------------------------------------------- "I'm stuck": help requests
// A student presses ✋ on a lesson; the class display rings and shows who needs help and where.
// Requests live in script properties (fast to read every few seconds), one per student, and expire after an hour.
// The display never gets emails: each request has a short "who" id instead.

var HELP_MAX_MS_ = 60 * 60 * 1000;

function helpWho_(email) {
  var h = 5381;
  for (var i = 0; i < email.length; i++) h = ((h * 33) ^ email.charCodeAt(i)) >>> 0;
  return h.toString(36);
}

function helpGet_(email) {
  var raw = PropertiesService.getScriptProperties().getProperty('help:' + email);
  if (!raw) return null;
  try {
    var r = JSON.parse(raw);
    if (Date.now() - new Date(r.at).getTime() > HELP_MAX_MS_) { PropertiesService.getScriptProperties().deleteProperty('help:' + email); return null; }
    return r;
  } catch (e) { return null; }
}

/** Student API: /api/help {action: 'ask' | 'cancel' | 'status', lesson, stage, step, note}. */
function helpApi_(d) {
  if (whoIs_().teacher) return { ok: true, teacher: true, help: null };
  var ctx = student_(), email = ctx.rec.email, props = PropertiesService.getScriptProperties();
  if (d.action === 'cancel') { props.deleteProperty('help:' + email); return { ok: true, help: null }; }
  if (d.action === 'ask') {
    var L = DATA.lessons[d.lesson], step = L && d.stage === 'build' ? L.build[Math.max(0, Math.min(L.build.length - 1, Number(d.step) || 0))] : null;
    var where = L ? L.title + (step ? ' · Step ' + ((Number(d.step) || 0) + 1) + ': ' + step.title : d.stage ? ' · ' + stageName_(d.stage) : '') : 'Maker Lab';
    var req = { who: helpWho_(email), email: email, name: ctx.rec.name, classes: studentClassIds_(ctx.rec, ctx.cfg), at: now_(),
                where: where, note: text_(d.note, 140).replace(/\s+/g, ' ').trim(), avatar: avatarOf_(ctx.rec) };
    props.setProperty('help:' + email, JSON.stringify(req));
    if (L && d.stage === 'build') {                           // the feedback report counts help requests per step
      var fb = fbOf_(ctx.rec, L.id), k = String(Math.max(0, Number(d.step) || 0));
      fb.help[k] = (fb.help[k] || 0) + 1;
      saveStudent_(ctx.rec);
    }
    return { ok: true, help: { at: req.at } };
  }
  var mine = helpGet_(email);
  return { ok: true, help: mine ? { at: mine.at } : null };
}

/** Open help requests for a class, oldest first. Names follow the display's "show students as" setting. */
function helpList_(cfg, cid) {
  var props = PropertiesService.getScriptProperties().getProperties(), out = [];
  Object.keys(props).forEach(function (k) {
    if (k.indexOf('help:') !== 0) return;
    var r = helpGet_(k.slice(5));
    if (r && (r.classes || []).indexOf(cid) >= 0) out.push(r);
  });
  var mode = ((cfg.classes[cid] || {}).screen || {}).names || 'first';
  var names = shownNames_(out.map(function (r) { return { email: r.email, name: r.name, avatar: r.avatar }; }), mode);
  return out.sort(function (a, b) { return String(a.at).localeCompare(String(b.at)); })
    .map(function (r) { return { who: r.who, name: names[r.email] || r.name, where: r.where, note: r.note, at: r.at, avatar: r.avatar }; });
}

/** Teacher: the class display asks for these every few seconds. */
function helpList(cid) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  return helpList_(cfg, cid);
}

/** Teacher: "✓ Helped" clears a request. */
function helpResolve(cid, who) {
  var cfg = teacher_(), props = PropertiesService.getScriptProperties().getProperties();
  Object.keys(props).forEach(function (k) {
    if (k.indexOf('help:') === 0 && helpWho_(k.slice(5)) === who) PropertiesService.getScriptProperties().deleteProperty(k);
  });
  return helpList_(cfg, cid);
}

// ---------------------------------------------------------------- 💤 idle students (client/lib/nudge.js)
// After two minutes without touching the Chromebook (with the Maker Lab tab in front), the page says so here, and
// says so again when the student is back. It's kept in the cache only (no files, no lock) and forgets itself after
// five minutes, so a closed Chromebook doesn't stay marked. The class display shows 💤 on those robots.
var IDLE_TTL_ = 300;

/** Student API: /api/idle {on: true|false, secs: how long they've been idle}. */
function idleApi_(d) {
  var me = whoIs_();
  if (me.teacher || !me.email) return { ok: true };
  var cache = CacheService.getScriptCache(), key = 'idle:' + me.email;
  if (d && d.on) {
    var secs = Math.max(0, Math.min(3600, Number(d.secs) || 0));
    cache.put(key, String(Date.now() - secs * 1000), IDLE_TTL_);
  } else cache.remove(key);
  return { ok: true };
}

/** email -> minutes idle, for the students who are idle right now. One cache read for the whole class. */
function idleMinutes_(emails) {
  var out = {};
  if (!emails.length) return out;
  var got = {};
  try { got = CacheService.getScriptCache().getAll(emails.map(function (e) { return 'idle:' + e; })) || {}; } catch (e) { return out; }
  emails.forEach(function (e) {
    var since = Number(got['idle:' + e]);
    if (since) out[e] = Math.max(2, Math.round((Date.now() - since) / 60000));
  });
  return out;
}

// ---------------------------------------------------------------- student API
// The lesson page calls api(path, body) through google.script.run (client/shim.js):
//   /api/lessons/<id>/mission  {talk}                         finish the Mission stage
//   /api/lessons/<id>/step     {i, tests, answer, fields}     tick off a Build step
//   /api/lessons/<id>/quiz     {answers}                      graded here, so answers never reach the browser
//   /api/lessons/<id>/ship     {share, ext, reflect, submit}  save Ship it (submit: true turns it in)
//   /api/lessons/<id>/partner  {action: pair|leave, partner_id}
//   /api/lessons/<id>/feedback {kind: step|quiz|rating, ...}   (60_feedback.js)
//   /api/avatar                {body, color, ...}
//   /api/shop/buy              {item: 'part:eyes:star' | 'power:turbo'}      (35_arcade.js)
//   /api/arcade/start, /api/arcade/finish {run_id, score}                    Robot Rush

function text_(v, max) {
  if (v == null) return '';
  if (typeof v !== 'string') throw badRequest_('Bad request');
  return v.slice(0, max || MAX_TEXT);
}

function newProgress_() {
  return { steps: {}, started_at: now_(), updated_at: now_() };
}

/** Every student request: who they are, their record, the teacher's settings. */
function student_() {
  var me = whoIs_();
  if (!me.email) throw new Error('Sign in with your school Google account.');
  var rec = loadStudent_(me.email);
  if (!rec) throw new Error('Join your class first: open Maker Lab and enter your class code.');
  return { me: me, rec: rec, cfg: config_() };
}

function finish_(ctx, L, p, extra) {
  var pct = percent_(p, L);
  if (pct === 100 && !p.completed_at) p.completed_at = now_();
  p.updated_at = now_();
  var mate = mirrorToPartner_(ctx, L, p);       // working together: the partner gets the same work
  var rewards = syncRewards_(ctx.rec, ctx.cfg);
  saveStudent_(ctx.rec);
  var out = { ok: true, percent: pct, stages: stagesDone_(L, p), stage: currentStage_(L, p), rewards: rewards,
              lesson_xp: lessonXp_(ctx.rec, L.id), stars: lessonStars_(L, p), level: levelInfo_(ctx.rec.xp || 0) };
  if (mate) out.partner = mate;
  out.arcade = arcadeState_(ctx.rec, ctx.cfg);
  Object.keys(extra || {}).forEach(function (k) { out[k] = extra[k]; });
  return out;
}

/** One entry point for the lesson page. Returns {status, body} like an HTTP response. */
function api(path, bodyJson) {
  try {
    var body = bodyJson ? JSON.parse(bodyJson) : {};
    if (path === '/api/run') return runCall_(body);
    if (path === '/api/help') return { status: 200, body: helpApi_(body) };
    if (path === '/api/idle') return { status: 200, body: idleApi_(body) };
    if (path === '/api/avatar') return apiAvatar_(body);
    if (/^\/api\/(shop\/buy|arcade\/start|arcade\/finish)$/.test(path)) return { status: 200, body: shopApi_(path, body) };
    var m = /^\/api\/lessons\/([\w-]+)\/(mission|step|quiz|ship|partner|feedback)$/.exec(path);
    if (!m) return { status: 404, body: { error: 'Not found' } };
    var L = DATA.lessons[m[1]];
    if (!L) return { status: 404, body: { error: 'No such lesson' } };
    if (whoIs_().teacher && m[2] === 'feedback') return { status: 200, body: { ok: true, teacher: true } };
    if (whoIs_().teacher && m[2] !== 'quiz') return { status: 200, body: { ok: true, teacher: true } };   // previews don't save
    if (whoIs_().teacher) return { status: 200, body: { ok: true, quiz: gradeQuiz_(L, (body.answers || []).slice(0, L.quiz.length)) } };
    var ctx = student_();
    var p = ctx.rec.progress[L.id] || (ctx.rec.progress[L.id] = newProgress_());
    return { status: 200, body: API_[m[2]](ctx, L, p, body) };
  } catch (e) {
    if (e && e.status) return { status: e.status, body: { ok: false, error: e.message } };
    return { status: 400, body: { ok: false, error: (e && e.message) || 'Something went wrong.' } };
  }
}

// ---------------------------------------------------------------- every page action goes through api('/api/run')
// The browser calls only api(); this picks the function. (A browser holding an older copy of the page can't
// call a function google.script.run doesn't know about, so the pages never call the others directly.)
// Each function checks for itself who may use it (teacher_() or the signed-in student).
var RUN_ = {
  joinClass: function (a) { return joinClass(a[0], a[1]); },
  createClass: function (a) { return createClass(a[0], a[1]); },
  setClassGrade: function (a) { return setClassGrade(a[0], a[1]); },
  deleteClass: function (a) { return deleteClass(a[0], a[1]); },
  assignLessons: function (a) { return assignLessons(a[0], a[1], a[2], a[3]); },
  updateAssignment: function (a) { return updateAssignment(a[0], a[1], a[2], a[3]); },
  removeStudent: function (a) { return removeStudent(a[0], a[1]); },
  saveFeedback: function (a) { return saveFeedback(a[0], a[1], a[2]); },
  giveBonus: function (a) { return giveBonus(a[0], a[1], a[2], a[3]); },
  saveVideos: function (a) { return saveVideos(a[0]); },
  teacherHome: function () { return teacherHome(); },
  gradebook: function (a) { return gradebook(a[0]); },
  studentDetail: function (a) { return studentDetail(a[0], a[1]); },
  classroomPackage: function (a) { return classroomPackage(a[0], a[1], a[2]); },
  screenData: function (a) { return screenData(a[0]); },
  screenSave: function (a) { return screenSave(a[0], a[1]); },
  setTabIcon: function (a) { return setTabIcon(a[0], a[1]); },
  classroomCourses: function () { return classroomCourses(); },
  importClassroom: function (a) { return importClassroom(a[0]); },
  syncClassroom: function (a) { return syncClassroom(a[0]); },
  syncAllClassroom: function () { return syncAllClassroom(); },
  unlinkClassroom: function (a) { return unlinkClassroom(a[0]); },
  arcadeClass: function (a) { return arcadeClass(a[0], a[1], a[2]); },
  helpList: function (a) { return helpList(a[0]); },
  feedbackReport: function (a) { return feedbackReport(a[0]); },
  dataInfo: function () { return dataInfo(); },
  translate: function (a) { return translate(a[0], a[1]); },
  reportBug: function (a) { return reportBug(a[0]); },
  bugList: function () { return bugList(); },
  bugUpdate: function (a) { return bugUpdate(a[0], a[1]); },
  backupNow: function () { return backupNow(); },
  helpResolve: function (a) { return helpResolve(a[0], a[1]); },
};
// Teacher actions that read, change and save the settings file take turns (two tabs, like the class display and the
// class page, could otherwise save over each other). Slow ones (Google Classroom, giving everyone play time) don't.
var RUN_LOCKED_ = { createClass: 1, setClassGrade: 1, deleteClass: 1, assignLessons: 1, updateAssignment: 1, removeStudent: 1,
                    saveFeedback: 1, giveBonus: 1, saveVideos: 1, screenSave: 1, setTabIcon: 1 };
function runCall_(d) {
  var name = d && d.fn, fn = RUN_[name];
  if (!fn) return { status: 404, body: { ok: false, error: 'Maker Lab doesn\'t know "' + name + '". Reload the page; if it keeps happening, the files may be from different versions.' } };
  var args = (d.args || []).slice(0, 6);
  var locked = RUN_LOCKED_[name] || (name === 'arcadeClass' && args[1] !== 'gift');
  return { status: 200, body: { ok: true, value: locked ? withLock_(function () { return fn(args); }) : fn(args) } };
}

function badRequest_(msg) { var e = new Error(msg); e.status = 400; return e; }

var API_ = {
  mission: function (ctx, L, p, d) {
    p.talk = text_(d.talk, 2000);
    p.mission_done = p.talk.trim().length >= 3;
    return finish_(ctx, L, p);
  },

  step: function (ctx, L, p, d) {
    var i = d.i, S = L.build[i];
    if (typeof i !== 'number' || !S) throw badRequest_('No such step');
    p.steps = p.steps || {};
    var row = p.steps[i] || {};
    if (d.tests !== undefined) row.tests = (d.tests || []).filter(function (t, k, all) {
      return typeof t === 'number' && t >= 0 && t < (S.test || []).length && all.indexOf(t) === k;
    });
    if (d.answer !== undefined) row.answer = text_(d.answer, 2000);
    if (d.fields !== undefined) row.fields = (d.fields || []).slice(0, (S.fields || []).length).map(function (f) { return text_(String(f == null ? '' : f), 200); });
    row.done = stepComplete_(S, row);
    p.steps[i] = row;
    p.step_at = Math.max(p.step_at || 0, row.done ? Math.min(i + 1, L.build.length - 1) : i);
    return finish_(ctx, L, p, { step: i, step_done: row.done });
  },

  quiz: function (ctx, L, p, d) {
    var answers = d.answers;
    if (!Array.isArray(answers) || answers.length !== L.quiz.length) throw badRequest_('Answer every question first.');
    var g = gradeQuiz_(L, answers);
    p.quiz_answers = answers;
    if (!p.quiz_first) p.quiz_first = answers.slice();       // first try: the feedback report shows which questions trip students up
    p.quiz_score = g.score;
    p.quiz_total = g.total;
    p.quiz_best = Math.max(p.quiz_best || 0, g.score);
    p.quiz_attempts = (p.quiz_attempts || 0) + 1;
    return finish_(ctx, L, p, { quiz: g });
  },

  feedback: function (ctx, L, p, d) { return lessonFeedback_(ctx, L, d); },

  ship: function (ctx, L, p, d) {
    if (d.share !== undefined) p.share = text_(d.share, 300).trim();
    if (d.ext !== undefined) {
      p.ext = {};
      (d.ext || []).forEach(function (k) { if (typeof k === 'number' && ((L.ship || {}).extensions || [])[k]) p.ext[k] = true; });
    }
    if (d.reflect !== undefined) p.reflect = (d.reflect || []).slice(0, ((L.ship || {}).reflect || []).length).map(function (r) { return text_(String(r || ''), 2000); });
    var missing = shipMissing_(L, p);
    if (d.submit) {
      if (missing.length) return finish_(ctx, L, p, { ok: false, missing: missing });
      if (!p.shipped_at) p.shipped_at = now_();
    } else if (missing.length && p.shipped_at) {
      delete p.shipped_at;           // they changed something it needs: turn it in again
    }
    return finish_(ctx, L, p, { missing: missing, shipped: !!p.shipped_at });
  },

  partner: function (ctx, L, p, d) {
    if (d.action === 'pair') {
      var email = String(d.partner_id || '').toLowerCase();
      if (p.partner) throw badRequest_('You already have a partner for this lesson.');
      if (!classmates_(ctx).some(function (m) { return m.id === email; })) throw badRequest_('You can only partner with someone in your class.');
      var mate = partnerRecord_(ctx.cfg, email), theirs = mate.progress[L.id];
      if (theirs && theirs.partner && theirs.partner !== ctx.rec.email) throw badRequest_('That classmate already has a partner for this lesson.');
      mergeProgress_(p, theirs);
      p.partner = email;
      p.partner_by = ctx.rec.email;                // who picked whom: the other student is told, and either can undo it
      finish_(ctx, L, p);                          // saves both files and gives XP to both
    } else if (d.action === 'leave' && p.partner) {
      var other = loadStudent_(p.partner);
      if (other && other.progress[L.id] && other.progress[L.id].partner === ctx.rec.email) {
        delete other.progress[L.id].partner;
        delete other.progress[L.id].partner_by;
        saveStudent_(other);
      }
      delete p.partner;
      delete p.partner_by;
      saveStudent_(ctx.rec);
    }
    return partnerState_(ctx, L, p);
  },
};

// ---------------------------------------------------------------- partners (two classmates, one Chromebook)
// The signed-in student picks a classmate. There's no accept step: the partner is sitting right there.
// Both students' progress for the lesson is combined, then every save is copied to the partner's file.
function classmates_(ctx) {
  var sum = summary_(), seen = {}, out = [];
  studentClassIds_(ctx.rec, ctx.cfg).forEach(function (cid) {
    classStudents_(ctx.cfg, sum, cid).forEach(function (s) {
      if (s.email === ctx.rec.email || seen[s.email]) return;
      seen[s.email] = 1;
      out.push({ id: s.email, name: s.name });
    });
  });
  return out.sort(function (a, b) { return a.name.toLowerCase().localeCompare(b.name.toLowerCase()); });
}

function partnerName_(cfg, email) {
  var rec = loadStudent_(email);
  return (rec && rec.name) || rosterName_(cfg, email) || email;
}

function partnerRecord_(cfg, email) {
  var rec = loadStudent_(email);
  if (!rec) { rec = newStudent_(email); rec.name = rosterName_(cfg, email) || email.split('@')[0]; }
  return rec;
}

/** Combine two students' work on one lesson into a: whatever either of them finished counts. */
function mergeProgress_(a, b) {
  if (!b) return a;
  a.mission_done = !!(a.mission_done || b.mission_done);
  if (!a.talk && b.talk) a.talk = b.talk;
  a.steps = a.steps || {};
  Object.keys(b.steps || {}).forEach(function (k) {
    var mine = a.steps[k], theirs = b.steps[k];
    if (!mine || (!mine.done && theirs.done)) a.steps[k] = JSON.parse(JSON.stringify(theirs));
  });
  a.step_at = Math.max(a.step_at || 0, b.step_at || 0);
  if ((b.quiz_best || 0) > (a.quiz_best || 0)) {
    a.quiz_best = b.quiz_best; a.quiz_total = b.quiz_total; a.quiz_answers = b.quiz_answers; a.quiz_score = b.quiz_score;
  }
  a.quiz_attempts = Math.max(a.quiz_attempts || 0, b.quiz_attempts || 0);
  if (!a.quiz_first && b.quiz_first) a.quiz_first = b.quiz_first;
  a.ext = a.ext || {};
  Object.keys(b.ext || {}).forEach(function (k) { if (b.ext[k]) a.ext[k] = true; });
  if (!a.share && b.share) a.share = b.share;
  if (!(a.reflect || []).join('') && (b.reflect || []).join('')) a.reflect = b.reflect;
  ['shipped_at', 'completed_at', 'started_at'].forEach(function (f) {
    if (b[f] && (!a[f] || b[f] < a[f])) a[f] = b[f];
  });
  return a;
}

/** After any save: copy this lesson's work to the partner's file. Returns the partner's name, or null. */
function mirrorToPartner_(ctx, L, p) {
  if (!p.partner) return null;
  var mate = partnerRecord_(ctx.cfg, p.partner), theirs = mate.progress[L.id];
  if (theirs && theirs.partner && theirs.partner !== ctx.rec.email) { delete p.partner; delete p.partner_by; return null; }   // they paired with someone else
  var copy = JSON.parse(JSON.stringify(p));
  copy.partner = ctx.rec.email;
  if (theirs && theirs.quiz_first) copy.quiz_first = theirs.quiz_first;      // each keeps their own first try (feedback report)
  mate.progress[L.id] = copy;
  syncRewards_(mate, ctx.cfg);
  saveStudent_(mate);
  return mate.name;
}

function partnerState_(ctx, L, p) {
  if (p.partner) return { status: 'paired', name: partnerName_(ctx.cfg, p.partner), by_me: !p.partner_by || p.partner_by === ctx.rec.email };
  return { status: 'none', classmates: classmates_(ctx) };
}

function apiAvatar_(d) {
  var me = whoIs_();
  if (me.teacher) return { status: 200, body: { ok: true, avatar: cleanAvatar_({ xp: 0 }, d, true).avatar, rewards: {} } };
  var ctx = student_();
  var r = cleanAvatar_(ctx.rec, d, false);
  if (r.error) return { status: 400, body: { ok: false, error: r.error } };
  ctx.rec.avatar = r.avatar;
  var rewards = syncRewards_(ctx.rec, ctx.cfg);
  saveStudent_(ctx.rec);
  return { status: 200, body: { ok: true, avatar: avatarOf_(ctx.rec), rewards: rewards } };
}

// ---------------------------------------------------------------- joining a class
function joinClass(code, name) {
  var me = whoIs_();
  if (!me.email) throw new Error('Sign in with your school Google account.');
  if (me.teacher) throw new Error('You are the teacher. Students join with the class code.');
  code = String(code || '').trim().toUpperCase();
  name = String(name || '').trim().replace(/\s+/g, ' ').slice(0, 40);
  var cfg = config_();
  var cls = Object.keys(cfg.classes).map(function (k) { return cfg.classes[k]; }).filter(function (c) { return c.code === code; })[0];
  if (!cls) throw new Error('That class code was not found. Check it with your teacher.');
  var rec = loadStudent_(me.email) || newStudent_(me.email);
  if (name) rec.name = name;
  if (!rec.name) throw new Error('Type your first name and last initial.');
  if (rec.classes.indexOf(cls.id) < 0) rec.classes.push(cls.id);
  saveStudent_(rec);
  return { ok: true, class_name: cls.name };
}

// ---------------------------------------------------------------- setup
/** Run once from the editor (Run > setup). Makes the data folder, the settings file and the tab icon. */
function setup() {
  dataFolder_();
  studentFolder_();
  if (!readNamed_('config', null)) saveConfig_(emptyConfig_());
  logoUrl_();
  return 'Set up: the "' + DATA_FOLDER + '" folder in your Drive is ready.';
}

// ---------------------------------------------------------------- teacher
// Only the script owner can call these. They change config.json, never a student's file,
// so a teacher and a student saving at the same moment can't overwrite each other.

function teacher_() {
  var me = whoIs_();
  if (!me.teacher) { var e = new Error('Only the teacher can do that.'); e.status = 403; throw e; }
  return config_();
}

function joinCode_(cfg) {
  var abc = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789', used = {};
  Object.keys(cfg.classes).forEach(function (k) { used[cfg.classes[k].code] = 1; });
  for (;;) {
    var code = '';
    for (var i = 0; i < 6; i++) code += abc.charAt(Math.floor(Math.random() * abc.length));
    if (!used[code]) return code;
  }
}

function dateOrEmpty_(s) {
  s = String(s || '');
  return /^\d{4}-\d{2}-\d{2}$/.test(s) ? s : '';
}

function createClass(name, grade) {
  var cfg = teacher_();
  name = String(name || '').trim().slice(0, 80);
  if (!name) throw new Error('Give the class a name.');
  if (!DATA.courses[grade]) throw new Error('Pick 6th or 7th grade for the class.');
  var id = String(nextId_(cfg));
  cfg.classes[id] = { id: id, name: name, code: joinCode_(cfg), created_at: now_(), grade: DATA.courses[grade] ? grade : DATA.default_course };
  saveConfig_(cfg);
  return cfg.classes[id];
}

/** Which course (grade) a class follows: its students see only that course's lessons. Work is kept when it changes. */
function setClassGrade(cid, grade) {
  var cfg = teacher_(), c = cfg.classes[cid];
  if (!c) throw new Error('No such class.');
  if (!DATA.courses[grade]) throw new Error('Unknown grade.');
  c.grade = grade;
  saveConfig_(cfg);
  return { ok: true, grade: grade };
}

function deleteClass(cid, typedName) {
  var cfg = teacher_(), c = cfg.classes[cid];
  if (!c) throw new Error('No such class.');
  if (typedName !== c.name) throw new Error('Type the class name exactly to delete it.');
  delete cfg.classes[cid];
  if (cfg.rosters) delete cfg.rosters[cid];
  cfg.assignments = cfg.assignments.filter(function (a) { return a.class_id !== cid; });
  saveConfig_(cfg);
  return { ok: true };
}

function assignLessons(cid, lessonIds, due, note) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  var have = {};
  cfg.assignments.forEach(function (a) { if (a.class_id === cid) have[a.lesson_id] = 1; });
  var added = 0;
  (lessonIds || []).forEach(function (lid) {
    if (!DATA.lessons[lid] || have[lid]) return;
    cfg.assignments.push({ id: String(nextId_(cfg)), class_id: cid, lesson_id: lid, due: dateOrEmpty_(due),
                           note: String(note || '').slice(0, 500), created_at: now_() });
    added++;
  });
  saveConfig_(cfg);
  return { added: added };
}

function updateAssignment(aid, due, note, remove) {
  var cfg = teacher_();
  var a = cfg.assignments.filter(function (x) { return x.id === aid; })[0];
  if (!a) throw new Error('No such assignment.');
  if (remove) cfg.assignments = cfg.assignments.filter(function (x) { return x.id !== aid; });
  else { a.due = dateOrEmpty_(due); a.note = String(note || '').slice(0, 500); }
  saveConfig_(cfg);
  return { ok: true };
}

function removeStudent(cid, email) {
  var cfg = teacher_();
  cfg.removed[cid] = cfg.removed[cid] || [];
  if (cfg.removed[cid].indexOf(email) < 0) cfg.removed[cid].push(email);
  saveConfig_(cfg);
  return { ok: true };
}

function saveFeedback(email, lid, text) {
  var cfg = teacher_();
  cfg.feedback[email] = cfg.feedback[email] || {};
  cfg.feedback[email][lid] = String(text || '').trim().slice(0, 5000);
  saveConfig_(cfg);
  return { ok: true };
}

function giveBonus(email, amount, reason, badge) {
  var cfg = teacher_();
  amount = Math.max(0, Math.min(Math.floor(Number(amount) || 0), 200));
  reason = String(reason || '').trim().slice(0, 120) || 'Great work';
  if (amount) {
    cfg.bonuses[email] = cfg.bonuses[email] || [];
    cfg.bonuses[email].push({ key: 'bonus:' + now_(), amount: amount, reason: 'Bonus from your teacher: ' + reason, at: now_() });
  }
  if (badge) cfg.picks[email] = true;
  saveConfig_(cfg);
  return { ok: true, xp: amount };
}

function saveVideos(map) {
  var cfg = teacher_(), out = {};
  Object.keys(map || {}).forEach(function (lid) {
    var url = String(map[lid] || '').trim();
    if (DATA.lessons[lid] && /^https:\/\//.test(url)) out[lid] = url.slice(0, 500);
  });
  cfg.videos = out;
  saveConfig_(cfg);
  return { ok: true, count: Object.keys(out).length };
}

// ---------------------------------------------------------------- gradebook
/** Everyone in a class: students who joined with the code, plus the Google Classroom roster (even before they sign in). */
function classStudents_(cfg, sum, cid) {
  var removed = cfg.removed[cid] || [], roster = rosterOf_(cfg, cid), emails = {};
  Object.keys(sum.students).forEach(function (email) { if (sum.students[email].classes.indexOf(cid) >= 0) emails[email] = 1; });
  Object.keys(roster).forEach(function (email) { emails[email] = 1; });
  return Object.keys(emails).filter(function (email) { return removed.indexOf(email) < 0; }).map(function (email) {
    var s = sum.students[email];
    if (!s) return { email: email, name: roster[email] || email, xp: 0, level: 1, avatar: null, badges: [], lessons: {}, not_yet: true };
    return { email: email, name: roster[email] || s.name || email, xp: s.xp, level: levelInfo_(s.xp).level, avatar: s.avatar || null,
             badges: s.badges, lessons: s.lessons, rostered: email in roster };
  }).sort(function (a, b) { return a.name.toLowerCase().localeCompare(b.name.toLowerCase()); });
}

/** One gradebook square: how far the student is with an assigned lesson. */
function gradebookCell_(a, s) {
  var x = s.lessons[a.lesson_id];
  var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
  var status = !x ? 'not-started' : x.pct === 100 ? 'complete' : 'in-progress';
  return { status: status, pct: x ? x.pct : 0, stage: x ? x.stage : 'mission', steps_done: x ? x.steps_done : 0,
           steps_total: x ? x.steps_total : 0, quiz_best: x ? x.quiz_best : null, quiz_total: x ? x.quiz_total : 0,
           share: x ? x.share : '', shipped: !!(x && x.shipped), stars: x ? x.stars : 0, partner: (x && x.partner) || null,
           late: !!(a.due && a.due < today && status !== 'complete') };
}

function teacherHome() {
  var cfg = teacher_(), sum = summary_();
  return { grades: DATA.course_ids.map(function (g) { return { id: g, name: DATA.courses[g].name }; }), classes: Object.keys(cfg.classes).map(function (cid) {
    var c = cfg.classes[cid];
    return { id: c.id, name: c.name, code: c.code, students: classStudents_(cfg, sum, cid).length, classroom: c.classroom || null,
             grade: courseOfClass_(cfg, cid), grade_name: DATA.courses[courseOfClass_(cfg, cid)].short,
             assignments: cfg.assignments.filter(function (a) { return a.class_id === cid; }).length };
  }) };
}

function gradebook(cid) {
  var cfg = teacher_(), c = cfg.classes[cid];
  if (!c) throw new Error('No such class.');
  var sum = summary_(), students = classStudents_(cfg, sum, cid);
  var cols = cfg.assignments.filter(function (a) { return a.class_id === cid && DATA.lessons[a.lesson_id]; }).map(function (a) {
    var L = DATA.lessons[a.lesson_id];
    return { id: a.id, lesson_id: L.id, number: L.number, title: L.title, icon: L.icon, due: a.due, note: a.note };
  });
  var grid = {};
  students.forEach(function (s) { cols.forEach(function (a) { grid[s.email + '|' + a.id] = gradebookCell_(a, s); }); });
  return { cls: c, cols: cols, students: students.map(function (s) {
             return { email: s.email, name: s.name, xp: s.xp, level: s.level, avatar: s.avatar, not_yet: !!s.not_yet };
           }), grid: grid,
           assigned: cols.map(function (a) { return a.lesson_id; }), url: ScriptApp.getService().getUrl() };
}

function studentDetail(cid, email) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  var rec = loadStudentFresh_(email);
  if (!rec && rosterOf_(cfg, cid)[email]) { rec = newStudent_(email); rec.name = rosterOf_(cfg, cid)[email]; }
  if (!rec) throw new Error('No work saved for that student yet.');
  var assigned = {};
  cfg.assignments.forEach(function (a) { if (a.class_id === cid) assigned[a.lesson_id] = 1; });
  var items = lessonList_().filter(function (L) { return rec.progress[L.id] || assigned[L.id]; }).map(function (L) {
    var p = rec.progress[L.id] || null;
    return { id: L.id, number: L.number, title: L.title, icon: L.icon, assigned: !!assigned[L.id], pct: p ? percent_(p, L) : 0,
             stage: currentStage_(L, p), p: p, feedback: ((cfg.feedback[email] || {})[L.id]) || '',
             partner: p && p.partner ? partnerName_(cfg, p.partner) : null,
             steps: L.build.map(function (S) { return { title: S.title, ask: S.ask || '', fields: S.fields || [] }; }),
             talk_q: L.mission.talk, quiz_total: L.quiz.length,
             extensions: ((L.ship || {}).extensions || []).map(function (e) { return e.title; }), reflect_q: (L.ship || {}).reflect || [] };
  });
  return { cls: cfg.classes[cid], student: { email: email, name: rec.name, xp: rec.xp || 0, level: levelInfo_(rec.xp || 0),
           avatar: avatarOf_(rec), badges: badgeList_(rec).filter(function (b) { return b.earned; }) }, items: items };
}

/** The teacher always reads a student's file from Drive, not a cached copy. */
function loadStudentFresh_(email) {
  var id = studentFileId_(email);
  if (!id) return null;
  try { return readJsonFile_(id); } catch (e) { return null; }
}

// ---------------------------------------------------------------- Google Classroom grades package
// Paste the result into the "Maker Lab to Google Classroom" sender (maker-lab-classroom.gs).
function classroomPackage(cid, how, lessonIds) {
  if (['complete', 'quiz', 'both'].indexOf(how) < 0) throw new Error('Pick how to score.');
  var gb = gradebook(cid), wanted = {};
  (lessonIds || []).forEach(function (l) { wanted[l] = 1; });
  var cols = gb.cols.filter(function (a) { return wanted[a.lesson_id]; });
  var students = gb.students.map(function (s, i) {
    var grades = {};
    cols.forEach(function (a) {
      var cell = gb.grid[s.email + '|' + a.id], score = null;
      if (cell && cell.status !== 'not-started') {
        var quiz = cell.quiz_total ? Math.round(100 * (cell.quiz_best || 0) / cell.quiz_total) : null;
        score = how === 'complete' ? cell.pct : how === 'quiz' ? quiz : (quiz === null ? null : Math.round((cell.pct + quiz) / 2));
      }
      if (score !== null) grades[a.lesson_id] = score;
    });
    return { ref: s.email, name: s.name, grades: grades };
  });
  return { source: 'microbit-maker-lab', version: 1, 'class': gb.cls.name, students: students,
           assignments: cols.map(function (a) { return { key: a.lesson_id, title: a.number + '. ' + a.title, due: a.due || '' }; }) };
}

// ---------------------------------------------------------------- class display (projector)
// Same data as the Flask site's /teacher/classes/<id>/screen/data, read by app/static/js/screen.js.
var WIN_ICONS_ = { badge: '🏅', complete: '🏁', ship: '📦', quiz_perfect: '🧠', bonus: '🍎' };

function winText_(name, w) {
  var r = w.reason || '', detail = r.indexOf(' · ') >= 0 ? r.slice(r.indexOf(' · ') + 3) : r;
  if (w.kind === 'badge') return name + ' earned the ' + r.replace('Badge: ', '') + ' badge';
  if (w.kind === 'complete') return name + ' finished ' + detail;
  if (w.kind === 'quiz_perfect') return name + ' got a perfect quiz in ' + detail;
  if (w.kind === 'ship') return name + ' shipped ' + detail;
  return name + ' got a bonus from the teacher';
}

/** First names for the projector, with a last initial when two students share one (or robot names). */
function shownNames_(students, mode) {
  var first = function (s) { return (String(s.name || '').trim().split(/\s+/)[0]) || 'Student'; }, count = {}, out = {};
  students.forEach(function (s) { count[first(s)] = (count[first(s)] || 0) + 1; });
  students.forEach(function (s) {
    var parts = String(s.name || '').trim().split(/\s+/), n = first(s);
    if (count[n] > 1 && parts.length > 1) n += ' ' + parts[1].charAt(0) + '.';
    if (mode === 'robot' && s.avatar && s.avatar.name) n = s.avatar.name;
    out[s.email] = n;
  });
  return out;
}

function whereIs_(s) {
  var ids = Object.keys(s.lessons || {}).filter(function (l) { return DATA.lessons[l]; })
    .sort(function (a, b) { return String(s.lessons[b].updated_at || '').localeCompare(String(s.lessons[a].updated_at || '')); });
  for (var i = 0; i < ids.length; i++) {
    var x = s.lessons[ids[i]], L = DATA.lessons[ids[i]];
    if (x.pct < 100) return { where: L.number + '. ' + L.title, pct: x.pct, status: 'working', lesson_id: L.id };
  }
  if (ids.length) { var D = DATA.lessons[ids[0]]; return { where: '✓ ' + D.number + '. ' + D.title, pct: 100, status: 'done', lesson_id: D.id }; }
  return { where: 'Not started', pct: 0, status: 'waiting', lesson_id: null };
}

/** Race-track stops: the four stages of a lesson. */
function trackStops_() { return STAGES_.map(function (st) { return { key: st[0], name: st[1], icon: st[2] }; }); }

function standardsInPlay_(counts, focusId) {
  var c = Object.keys(counts).length ? counts : (function () { var o = {}; o[focusId] = 0; return o; })(), out = {}, order = [];
  Object.keys(c).sort(function (a, b) { return c[b] - c[a]; }).forEach(function (lid) {
    var L = DATA.lessons[lid];
    (L.standards_full || []).forEach(function (st) {
      if (!out[st.code]) { out[st.code] = { code: st.code, text: st.text, students: 0, lessons: [] }; order.push(st.code); }
      out[st.code].students += c[lid];
      out[st.code].lessons.push(L.number + '. ' + L.title);
    });
  });
  return order.map(function (k) { return out[k]; }).sort(function (a, b) { return b.students - a.students; }).slice(0, 4);
}

function screenPayload_(cfg, cid) {
  var c = cfg.classes[cid], saved = c.screen || {};
  var settings = { lesson_id: saved.lesson_id || '', question: saved.question || '', names: saved.names || 'first',
                   xp: saved.xp || 'each', bell: saved.bell || '', view: saved.view === 'cards' ? 'cards' : 'track',
                   goal: saved.goal == null ? '' : saved.goal };
  var sum = summary_(), students = classStudents_(cfg, sum, cid), names = shownNames_(students, settings.names), wins = [];
  var wheres = {}, working = {};
  students.forEach(function (s) {
    var w = wheres[s.email] = whereIs_(s);
    if (w.status === 'working') working[w.lesson_id] = (working[w.lesson_id] || 0) + 1;
  });
  var L = DATA.lessons[settings.lesson_id];
  if (!L && Object.keys(working).length) {        // default: the lesson most students are on right now
    L = DATA.lessons[Object.keys(working).sort().reduce(function (best, lid) { return working[lid] > working[best] ? lid : best; })];
  }
  if (!L) {                                         // ...or the next assignment due
    var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
    var mine = cfg.assignments.filter(function (a) { return a.class_id === cid && DATA.lessons[a.lesson_id]; })
      .sort(function (a, b) { return (a.due || '9999') < (b.due || '9999') ? -1 : (a.due || '9999') > (b.due || '9999') ? 1 : 0; });
    var next = mine.filter(function (a) { return !a.due || a.due >= today; })[0] || mine[0];
    L = next ? DATA.lessons[next.lesson_id] : lessonList_(courseOfClass_(cfg, cid))[0];
  }
  var idle = idleMinutes_(students.map(function (s) { return s.email; }));
  var rows = students.map(function (s) {
    var w = wheres[s.email], here = (s.lessons || {})[L.id], sd = here && here.stages;
    var row = { who: helpWho_(s.email), name: names[s.email], avatar: s.avatar || null, level: s.level, where: w.where, pct: w.pct, status: w.status,
                // race track: stages done in today's lesson (null = busy with a different lesson, or not started)
                done: here ? (sd ? STAGES_.filter(function (st) { return sd[st[0]]; }).length : 0) : null };
    if (here && sd && sd.mission && !sd.build) row.step = Math.min(L.build.length - 1, here.steps_done || 0);   // which Build step they're on (0 = step 1)
    if (!here && w.status === 'working') row.elsewhere = w.where;
    if (idle[s.email]) row.idle = idle[s.email];           // 💤 minutes without touching the Chromebook
    if (settings.xp === 'each') row.xp = s.xp || 0;      // hidden XP never reaches the browser
    ((sum.students[s.email] || {}).wins || []).forEach(function (x) {
      wins.push({ icon: WIN_ICONS_[x.kind] || '⭐', text: winText_(names[s.email], x), at: x.at });
    });
    return row;
  }).sort(function (a, b) { return a.name.toLowerCase().localeCompare(b.name.toLowerCase()); });
  // class XP goal for today: XP everyone earned since midnight, against the teacher's goal (blank = 60 per student, 0 = off)
  var tz = Session.getScriptTimeZone(), day = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd'), todayXp = 0;
  students.forEach(function (s) {
    ((sum.students[s.email] || {}).xp_recent || []).forEach(function (e) {
      if (Utilities.formatDate(new Date(e[0]), tz, 'yyyy-MM-dd') === day) todayXp += e[1];
    });
  });
  var goal = settings.goal === '' ? Math.max(100, students.length * 60) : Number(settings.goal) || 0;
  var since = new Date(Date.now() - 12 * 3600 * 1000).toISOString();
  wins = wins.filter(function (w) { return w.at >= since; }).sort(function (a, b) { return String(b.at).localeCompare(String(a.at)); }).slice(0, 8);
  return { settings: settings, students: rows, wins: wins,
           total_xp: settings.xp === 'hide' ? 0 : students.reduce(function (t, s) { return t + (s.xp || 0); }, 0),
           goal: settings.xp === 'hide' || !goal ? null : { target: goal, today: todayXp, auto: settings.goal === '' },
           lesson: { id: L.id, number: L.number, title: L.title, steps: L.build.length }, auto_lesson: !DATA.lessons[settings.lesson_id],
           track: trackStops_(), question: settings.question || L.mission.big_question || '', big_idea: L.idea_label + ': ' + L.python,
           standards: standardsInPlay_(working, L.id), arcade: arcadeTeacher_(cfg, cid), help: helpList_(cfg, cid) };
}

function screenData(cid) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  var out = screenPayload_(cfg, cid);
  backupStep_(2000);                 // the class display refreshes often: build today's backup a little at a time
  return out;
}

function screenSave(cid, d) {
  var cfg = teacher_(), c = cfg.classes[cid];
  if (!c) throw new Error('No such class.');
  d = d || {};
  c.screen = { lesson_id: DATA.lessons[d.lesson_id] ? d.lesson_id : '', question: String(d.question || '').trim().slice(0, 300),
               names: d.names === 'robot' ? 'robot' : 'first', view: d.view === 'cards' ? 'cards' : 'track',
               xp: ['each', 'total', 'hide'].indexOf(d.xp) >= 0 ? d.xp : 'each',
               bell: /^\d{1,2}:\d{2}$/.test(String(d.bell || '')) ? d.bell : '',
               goal: String(d.goal == null ? '' : d.goal).trim() === '' ? '' : Math.max(0, Math.min(100000, Math.round(Number(d.goal)) || 0)) };
  saveConfig_(cfg);
  return screenPayload_(cfg, cid);
}

function screenUnits_(grade) {
  return [{ title: DATA.courses[grade || DATA.default_course].name, lessons: lessonList_(grade || DATA.default_course).map(function (L) { return { id: L.id, number: L.number, title: L.title }; }) }];
}

// ---------------------------------------------------------------- the icon in the browser tab
// Apps Script needs a picture at a web address. These are Google's own emoji pictures (fonts.gstatic.com,
// the same place the fonts load from), so school filters that block other sites still show them.
var TAB_ICONS_ = [['logo', null, 'Maker Lab logo (five dots)'], ['robot', '1f916', '🤖 Robot'], ['rocket', '1f680', '🚀 Rocket'], ['bulb', '1f4a1', '💡 Light bulb'],
                  ['bolt', '26a1', '⚡ Lightning'], ['wrench', '1f527', '🔧 Wrench'], ['puzzle', '1f9e9', '🧩 Puzzle']];

function faviconUrl_() {
  var pick = '';
  try { pick = config_().tab_icon || ''; } catch (e) { pick = ''; }
  if (/^https:\/\/\S+$/.test(pick)) return pick;
  var icon = TAB_ICONS_.filter(function (t) { return t[0] === pick; })[0] || TAB_ICONS_[0];
  if (icon[0] === 'logo') return logoUrl_() || emojiUrl_('1f916');     // '' once Apps Script has refused the logo
  return emojiUrl_(icon[1]);
}

function emojiUrl_(code) { return 'https://fonts.gstatic.com/s/e/notoemoji/latest/' + code + '/512.png'; }

/** The logo as a picture in the Drive data folder, shared so browsers can load it. '' if Drive won't allow that. */
function logoUrl_() {
  var props = PropertiesService.getScriptProperties(), url = props.getProperty('logo:url');
  if (props.getProperty('logo:refused')) return '';
  if (url && !/\.png$/.test(url)) url += '#.png';     // Apps Script wants icon addresses to end in .png or .ico
  if (url) return url;
  try {
    var file = dataFolder_().createFile(Utilities.newBlob(Utilities.base64Decode(LOGO_PNG_), 'image/png', 'maker-lab-tab-icon.png'));
    try {           // anyone with the link: works on every account and loads fastest
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      url = 'https://lh3.googleusercontent.com/d/' + file.getId() + '#.png';
    } catch (e) {   // schools often only allow sharing inside the district
      file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);
      url = 'https://drive.google.com/uc?export=view&id=' + file.getId() + '#.png';
    }
    props.setProperty('logo:url', url);
    return url;
  } catch (e) {
    return '';
  }
}

/** Sets the tab icon on a page. If Apps Script refuses it, the page still loads (with the robot). A refused
 *  logo is remembered and not tried again, so a bad icon can never stop Maker Lab from opening. */
function withIcon_(out) {
  var url = '';
  try {
    url = faviconUrl_();
    out.setFaviconUrl(url);
    return out;
  } catch (e) {
    if (url && url === logoUrl_()) PropertiesService.getScriptProperties().setProperty('logo:refused', String((e && e.message) || 'refused'));
  }
  try { out.setFaviconUrl(emojiUrl_('1f916')); } catch (e2) { /* no icon at all is fine */ }
  return out;
}

/** choice: one of the TAB_ICONS_ ids, or the https address of a .png or .ico picture. */
function setTabIcon(choice) {
  var cfg = teacher_();
  choice = String(choice || '').trim();
  var known = TAB_ICONS_.some(function (t) { return t[0] === choice; });
  if (!known && !/^https:\/\/\S+\.(png|ico)(\?\S*)?$/i.test(choice)) {
    throw new Error('Pick one of the icons, or paste a web address that starts with https:// and ends in .png or .ico.');
  }
  cfg.tab_icon = choice;
  saveConfig_(cfg);
  return { ok: true, url: faviconUrl_() };
}

// ---------------------------------------------------------------- Google Classroom: import classes and rosters
// Uses the Google Classroom advanced service (appsscript.json "dependencies"), read-only, as the teacher.
// A linked class keeps its roster in config.json (cfg.rosters[cid] = { email: name }), so students on it
// are in the class the first time they open Maker Lab: no join code, and their Classroom name is used.

function classroomApi_() {
  if (typeof Classroom === 'undefined' || !Classroom.Courses) {
    throw new Error('The Google Classroom service is not turned on. Replace appsscript.json with the one in INSTALL.md, ' +
      'save, then run checkInstall once to allow access.');
  }
  return Classroom;
}

function classroomCoursesRaw_() {
  var api = classroomApi_(), out = [], token = null;
  do {
    var r = api.Courses.list({ teacherId: 'me', courseStates: ['ACTIVE'], pageSize: 100, pageToken: token || undefined });
    (r.courses || []).forEach(function (c) { out.push(c); });
    token = r.nextPageToken;
  } while (token);
  return out;
}

/** { students: { email: name }, missing: number of students whose email Classroom didn't share } */
function classroomRoster_(courseId) {
  var api = classroomApi_(), students = {}, missing = 0, token = null;
  do {
    var r = api.Courses.Students.list(courseId, { pageSize: 100, pageToken: token || undefined });
    (r.students || []).forEach(function (s) {
      var p = s.profile || {}, email = String(p.emailAddress || '').trim().toLowerCase();
      var name = String((p.name && (p.name.fullName || [p.name.givenName, p.name.familyName].join(' '))) || '').trim();
      if (email) students[email] = name.slice(0, 40) || email;
      else missing++;
    });
    token = r.nextPageToken;
  } while (token);
  return { students: students, missing: missing };
}

function rosterOf_(cfg, cid) { return (cfg.rosters || {})[cid] || {}; }

/** The import page: your active Classroom courses and which Maker Lab class each is linked to. */
function classroomCourses() {
  var cfg = teacher_(), linked = {};
  Object.keys(cfg.classes).forEach(function (cid) {
    var g = cfg.classes[cid].classroom;
    if (g) linked[g.id] = cid;
  });
  var courses = classroomCoursesRaw_().map(function (c) {
    return { id: c.id, name: c.name || 'Untitled class', section: c.section || '', link: c.alternateLink || '', linked: linked[c.id] || null };
  });
  return { courses: courses, grades: DATA.course_ids.map(function (g) { return { id: g, name: DATA.courses[g].name }; }),
           classes: Object.keys(cfg.classes).map(function (cid) { return { id: cid, name: cfg.classes[cid].name, grade: courseOfClass_(cfg, cid) }; }) };
}

/** choices: [{ course_id, target: 'new' | a class id, grade: 'g6' | 'g7' }]. Makes or links each class, then copies its roster. */
function importClassroom(choices) {
  var cfg = teacher_(), byId = {}, results = [];
  classroomCoursesRaw_().forEach(function (c) { byId[c.id] = c; });
  (choices || []).forEach(function (ch) {
    var c = byId[ch && ch.course_id];
    if (!c) return;
    var cid = ch.target === 'new' ? null : String(ch.target || '');
    if (cid && !cfg.classes[cid]) return;
    Object.keys(cfg.classes).forEach(function (k) {   // a course links to one class at a time
      var g = cfg.classes[k].classroom;
      if (g && g.id === c.id && k !== cid) { delete cfg.classes[k].classroom; delete cfg.rosters[k]; }
    });
    if (!cid) {
      cid = String(nextId_(cfg));
      var name = (c.name + (c.section ? ' (' + c.section + ')' : '')).slice(0, 80);
      cfg.classes[cid] = { id: cid, name: name, code: joinCode_(cfg), created_at: now_() };
    }
    if (DATA.courses[ch.grade]) cfg.classes[cid].grade = ch.grade;      // 6th or 7th grade, picked on the import page
    cfg.classes[cid].classroom = { id: c.id, name: c.name || '', section: c.section || '', link: c.alternateLink || '' };
    results.push(syncInto_(cfg, cid));
  });
  saveConfig_(cfg);
  return { classes: results };
}

function syncInto_(cfg, cid) {
  var cls = cfg.classes[cid], before = rosterOf_(cfg, cid), r = classroomRoster_(cls.classroom.id);
  cfg.rosters = cfg.rosters || {};
  cfg.rosters[cid] = r.students;
  cls.classroom.synced_at = now_();
  cls.classroom.missing = r.missing;
  var added = Object.keys(r.students).filter(function (e) { return !(e in before); }).length;
  var left = Object.keys(before).filter(function (e) { return !(e in r.students); }).length;
  return { id: cid, name: cls.name, students: Object.keys(r.students).length, added: added, left: left, missing: r.missing };
}

/** Copies the class's roster from Google Classroom again (new students in, students who left out). */
function syncClassroom(cid) {
  var cfg = teacher_(), cls = cfg.classes[cid];
  if (!cls) throw new Error('No such class.');
  if (!cls.classroom) throw new Error('This class is not linked to Google Classroom.');
  var out = syncInto_(cfg, cid);
  saveConfig_(cfg);
  return out;
}

/** Re-copies every linked class's roster. */
function syncAllClassroom() {
  var cfg = teacher_(), out = [];
  Object.keys(cfg.classes).forEach(function (cid) {
    if (!cfg.classes[cid].classroom) return;
    try { out.push(syncInto_(cfg, cid)); } catch (e) { out.push({ id: cid, name: cfg.classes[cid].name, error: e.message }); }
  });
  saveConfig_(cfg);
  return { classes: out };
}

function unlinkClassroom(cid) {
  var cfg = teacher_(), cls = cfg.classes[cid];
  if (!cls) throw new Error('No such class.');
  delete cls.classroom;
  if (cfg.rosters) delete cfg.rosters[cid];
  saveConfig_(cfg);
  return { ok: true };
}

/** The Classroom name for a student, if any linked class has them on its roster. */
function rosterName_(cfg, email) {
  var rosters = cfg.rosters || {};
  for (var cid in rosters) if (cfg.classes[cid] && rosters[cid][email]) return rosters[cid][email];
  return '';
}

// ---------------------------------------------------------------- pages
// Every page is one doGet: ?p=/lessons/dodge-the-drop. The server sends data; client/pages.js and
// client/lesson.js draw the page in the browser.

function doGet(e) {
  var problems = installProblems_();
  if (problems.length) return plainPage_('Maker Lab needs a fix', '<h1>Maker Lab isn\'t installed correctly yet</h1><ul><li>' +
    problems.map(escapeHtml_).join('</li><li>') + '</li></ul><p>Fix the files above in the Apps Script editor, save, then deploy a ' +
    '<b>new version</b> (Deploy → Manage deployments → ✏️ → Version: New version). The steps are in INSTALL.md.</p>');
  var me = whoIs_();
  var path = String((e && e.parameter && e.parameter.p) || '/');
  var page;
  try {
    var sv;
    if (me.teacher && (sv = /^\/student-view\/(\w+)$/.exec(path))) { setStudentView_(sv[1]); path = '/'; }
    else if (me.teacher && path === '/exit-student-view') { setStudentView_(''); path = '/'; }
    var view = me.teacher ? studentView_() : '';
    if (!me.email) page = { name: 'error', title: 'Sign in', data: { message: 'Open Maker Lab while signed in to your school Google account.' } };
    else if (view) page = previewPage_(me, path, view);
    else page = me.teacher ? teacherPage_(path) : studentPage_(me, path);
  } catch (err) {
    var busy = /^BUSY/.test((err && err.message) || '');
    page = { name: 'error', title: busy ? 'Busy' : 'Problem', data: { message: busy ? 'Maker Lab is very busy right now. Your work is safe. This page will try again in a few seconds.' : (err && err.message) || 'Something went wrong.', retry: busy } };
  }
  page.path = path;
  return render_(me, page);
}

// ---------------------------------------------------------------- 👀 student view (the teacher sees a class as a student)
// A pretend student in that class, made fresh for every page and never saved. The teacher's lesson and shop actions
// are already previews on the server (nothing saved), so the pages just work.
function studentView_() {
  var cid = PropertiesService.getScriptProperties().getProperty('teacher:student-view') || '';
  return cid && config_().classes[cid] ? cid : '';
}
function setStudentView_(cid) {
  var props = PropertiesService.getScriptProperties();
  if (cid && config_().classes[cid]) props.setProperty('teacher:student-view', cid); else props.deleteProperty('teacher:student-view');
}
function previewPage_(me, path, cid) {
  var cfg = config_(), rec = newStudent_(me.email);
  rec.name = 'Student view';
  rec.classes = [cid];
  var page = studentPage_(me, path, rec);
  page.preview = { cls: cfg.classes[cid].name, grade: DATA.courses[courseOfClass_(cfg, cid)].short };
  return page;
}

function studentPage_(me, path, preview) {
  var rec = preview || loadStudent_(me.email), cfg = config_();
  var listed = preview ? '' : rosterName_(cfg, me.email);
  if (listed && (!rec || !rec.name)) {          // on a Google Classroom roster: no join page, use the Classroom name
    rec = rec || newStudent_(me.email);
    rec.name = listed;
    saveStudent_(rec);
  }
  if (!rec || !rec.name || !studentClassIds_(rec, cfg).length) return { name: 'join', title: 'Join your class', data: { name: rec ? rec.name : '' } };
  var rewards = syncRewards_(rec, cfg);
  if (rewards.xp_gained && !preview) saveStudent_(rec);
  var level = levelInfo_(rec.xp || 0), base = { level: level, avatar: avatarOf_(rec), rewards: rewards, name: rec.name,
                                                arcade_state: arcadeState_(rec, cfg), spendable: spendable_(rec),
                                                course: courseOf_(rec, cfg), editor: DATA.courses[courseOf_(rec, cfg)].editor };
  var m;
  if (path === '/' || path === '/dashboard') return { name: 'dashboard', title: 'Home', data: merge_(base, dashboardData_(rec, cfg)) };
  if (path === '/lessons') return { name: 'catalog', title: 'Lessons', data: merge_(base, catalogData_(rec, courseOf_(rec, cfg))) };
  if (path === '/map') return { name: 'map', title: 'Skill tree', data: merge_(base, { map: mapData_(rec, assignedIds_(rec, cfg), courseOf_(rec, cfg)) }) };
  if (path === '/me') return { name: 'profile', title: 'My robot', data: merge_(base, profileData_(rec, courseOf_(rec, cfg))) };
  if (path === '/arcade') return { name: 'arcade', title: 'Arcade', data: merge_(base, arcadeData_(rec, cfg, false)) };
  if (path === '/help') return { name: 'help', title: 'MakeCode help', data: merge_(base, { makecode: DATA.makecode_url }) };
  if ((m = /^\/lessons\/([\w-]+)$/.exec(path))) return lessonPage_(m[1], rec, cfg, base, false);
  return { name: 'error', title: 'Not found', data: { message: "We couldn't find that page." } };
}

function teacherPage_(path) {
  var cfg = config_(), m, base = { teacher: true };
  if (path === '/' || path === '/teacher') backupStep_(1500);
  if (path === '/' || path === '/teacher') return { name: 'teacher-home', title: 'My classes', data: merge_(base, merge_(teacherHome(), {
    tab_icons: TAB_ICONS_.map(function (t) { return { id: t[0], label: t[2] }; }), tab_icon: cfg.tab_icon || 'logo', tab_icon_url: faviconUrl_(),
    logo_refused: !!PropertiesService.getScriptProperties().getProperty('logo:refused') })) };
  if ((m = /^\/teacher\/classes\/(\w+)$/.exec(path))) return { name: 'classroom', title: 'Class', data: merge_(base, merge_(gradebook(m[1]), { course: courseCards_(null, courseOfClass_(cfg, m[1])),
    grade: courseOfClass_(cfg, m[1]), grades: DATA.course_ids.map(function (g) { return { id: g, name: DATA.courses[g].name }; }), arcade: arcadeTeacher_(cfg, m[1]) })) };
  if ((m = /^\/teacher\/classes\/(\w+)\/students\/(.+)$/.exec(path))) return { name: 'student', title: 'Student', data: merge_(base, studentDetail(m[1], decodeURIComponent(m[2]))) };
  if (path === '/teacher/google-import') return { name: 'gc-import', title: 'Import from Google Classroom', data: merge_(base, classroomImportData_()) };
  if ((m = /^\/teacher\/classes\/(\w+)\/screen$/.exec(path))) {
    if (!cfg.classes[m[1]]) throw new Error('No such class.');
    return { name: 'screen', title: 'Class display', bodyClass: 'screen-page', mainClass: 'screen-main',
             data: merge_(base, { cls: { id: m[1], name: cfg.classes[m[1]].name }, units: screenUnits_(courseOfClass_(cfg, m[1])) }) };
  }
  if ((m = /^\/teacher\/classes\/(\w+)\/google-classroom$/.exec(path))) return { name: 'google', title: 'Google Classroom', data: merge_(base, gradebook(m[1])) };
  if (path === '/arcade') return { name: 'arcade', title: 'Arcade', data: merge_(base, merge_(arcadeData_(null, cfg, true), { avatar: DATA.default_avatar })) };
  if (path === '/teacher/reports') return { name: 'reports', title: 'Problem reports', data: merge_(base, bugList()) };
  if ((m = /^\/teacher\/feedback(?:\/(\w+))?$/.exec(path))) return { name: 'feedback', title: 'Lesson feedback', data: merge_(base, feedbackReport(m[1])) };
  if (path === '/teacher/standards') return { name: 'standards', title: 'Standards', data: merge_(base, standardsData_()) };
  if (path === '/teacher/videos') return { name: 'videos', title: 'Videos', data: merge_(base, { courses: allCourses_(), urls: cfg.videos }) };
  if (path === '/lessons') return { name: 'catalog', title: 'Lessons', data: merge_(base, { courses: allCourses_() }) };
  if (path === '/help') return { name: 'help', title: 'MakeCode help', data: merge_(base, { makecode: DATA.makecode_url }) };
  if ((m = /^\/map(?:\/(\w+))?$/.exec(path))) {
    var map = mapData_(null, {}, DATA.courses[m[1]] ? m[1] : DATA.default_course);
    map.courses = DATA.course_ids.map(function (g) { return { id: g, name: DATA.courses[g].short }; });
    map.nodes.forEach(function (n) { if (!n.soon) n.state = 'open'; });
    return { name: 'map', title: 'Skill tree', data: merge_(base, { map: map }) };
  }
  if ((m = /^\/lessons\/([\w-]+)$/.exec(path))) return lessonPage_(m[1], null, cfg, base, true);
  return { name: 'error', title: 'Not found', data: { message: "We couldn't find that page." } };
}

function classroomImportData_() {
  try { return classroomCourses(); } catch (e) { return { courses: [], classes: [], problem: e.message }; }
}

function merge_(a, b) {
  var out = {};
  Object.keys(a).forEach(function (k) { out[k] = a[k]; });
  Object.keys(b).forEach(function (k) { out[k] = b[k]; });
  return out;
}

/** Every lesson in the course plan, written or not ("soon"), with the student's progress. */
function courseCards_(rec, cid) {
  return DATA.courses[cid || DATA.default_course].plan.map(function (c) {
    var L = DATA.lessons[c.id], p = rec && L ? rec.progress[c.id] : null;
    return { id: c.id, course: c.course, number: c.number, title: c.title, icon: c.icon, color: c.color, python: c.python, hardware: c.hardware,
             tagline: L ? L.tagline : '', minutes: L ? L.minutes : 0, soon: !L,
             pct: L && p ? percent_(p, L) : 0, stage: L ? currentStage_(L, p) : 'mission', stars: L ? lessonStars_(L, p) : 0 };
  });
}

function catalogData_(rec, cid) { return { course: courseCards_(rec, cid), course_name: DATA.courses[cid].name }; }
/** The teacher sees every course. */
function allCourses_() {
  return DATA.course_ids.map(function (cid) { return { id: cid, name: DATA.courses[cid].name, short: DATA.courses[cid].short, cards: courseCards_(null, cid) }; });
}

function stageName_(stage) {
  var st = STAGES_.filter(function (s) { return s[0] === stage; })[0];
  return st ? st[1] : 'Done';
}

function dashboardData_(rec, cfg) {
  var classes = studentClassIds_(rec, cfg), cid = courseOf_(rec, cfg), cards = courseCards_(rec, cid), byId = {};
  cards.forEach(function (c) { byId[c.id] = c; });
  var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
  var rows = cfg.assignments.filter(function (a) { return classes.indexOf(a.class_id) >= 0 && DATA.lessons[a.lesson_id] && byId[a.lesson_id]; })
    .sort(function (a, b) { return (a.due || '9999') < (b.due || '9999') ? -1 : (a.due || '9999') > (b.due || '9999') ? 1 : 0; })
    .map(function (a) {
      var c = byId[a.lesson_id];
      return { lesson: c, class_name: cfg.classes[a.class_id].name, due: a.due, note: a.note, pct: c.pct,
               overdue: !!(a.due && a.due < today && c.pct < 100), feedback: !!((cfg.feedback[rec.email] || {})[a.lesson_id]) };
    });
  var done = cards.filter(function (c) { return !c.soon && c.pct === 100; }).length;
  return { rows: rows, next_up: nextUp_(rec, rows, cards), badges: badgeList_(rec, cid), done: done, course_name: DATA.courses[cid].name,
           total: cards.length, classes: classes.map(function (c) { return cfg.classes[c].name; }) };
}

/** One clear thing to do: the lesson they were last working on, else the next assignment, else the next lesson. */
function nextUp_(rec, rows, cards) {
  var pick = function (verb, c) { return { verb: verb, lesson: c, stage: stageName_(c.stage) }; };
  var started = Object.keys(rec.progress).filter(function (l) { return DATA.lessons[l]; })
    .sort(function (a, b) { return String(rec.progress[b].updated_at || '').localeCompare(String(rec.progress[a].updated_at || '')); });
  var byId = {};
  cards.forEach(function (c) { byId[c.id] = c; });
  for (var i = 0; i < started.length; i++) if (byId[started[i]] && byId[started[i]].pct < 100) return pick('Keep going', byId[started[i]]);
  for (var j = 0; j < rows.length; j++) if (rows[j].pct < 100) return pick('Start', rows[j].lesson);
  for (var k = 0; k < cards.length; k++) if (!cards[k].soon && cards[k].pct < 100) return pick('Start', cards[k]);
  return null;
}

function profileData_(rec, cid) {
  return { badges: badgeList_(rec, cid), history: rec.xp_log || [], catalog: avatarCatalog_(rec, false),
           parts: DATA.avatar_parts, levels: DATA.levels, xp_table: DATA.xp, xp_labels: DATA.labels };
}

/** The lesson as the browser gets it: no quiz answers (they're checked on the server). */
function publicLesson_(L) {
  var v = JSON.parse(JSON.stringify(L));
  v.quiz = L.quiz.map(function (q) { return { question: q.question, choices: q.choices }; });
  delete v.teacher_notes;
  return v;
}

function lessonPage_(lid, rec, cfg, base, teacher) {
  var L = DATA.lessons[lid];
  var c = DATA.course_by_id[lid];
  if (L && rec && !teacher && L.course !== courseOf_(rec, cfg))
    return { name: 'error', title: 'Another grade', data: merge_(base, { message: '"' + L.title + '" is a lesson for another grade. Find your lessons on the Lessons page.' }) };
  if (!L) return { name: 'error', title: 'Coming soon', data: merge_(base, { message: c ? '"' + c.title + '" is coming soon.' : "We couldn't find that lesson." }) };
  var p = rec ? rec.progress[lid] || null : null;
  var state = p ? JSON.parse(JSON.stringify(p)) : newProgress_();
  if (p && p.quiz_answers) state.quiz_results = gradeQuiz_(L, p.quiz_answers);
  return { name: 'lesson', title: L.title, mainClass: 'lesson-main',
           data: merge_(base, { lesson: publicLesson_(L), state: state, stage: currentStage_(L, p), stages: stagesDone_(L, p),
                                lesson_xp: rec ? lessonXp_(rec, lid) : 0, xp_possible: possibleXp_(L), stars: lessonStars_(L, p),
                                pct: percent_(p, L), feedback: rec ? ((cfg.feedback[rec.email] || {})[lid] || '') : '',
                                video: embedInfo_(cfg.videos[lid]), makecode: DATA.makecode_url, help: rec ? !!helpGet_(rec.email) : false, my_fb: myFeedback_(rec, lid),
                                key: teacher ? { quiz: L.quiz.map(function (q) { return q.choices[q.answer]; }), notes: L.teacher_notes || '',
                                                 standards: L.standards_full || [] } : null }) };
}

function standardsData_() {
  return { lessons: lessonList_().map(function (L) { return { id: L.id, number: L.number, title: L.title, course: DATA.courses[L.course].short, standards: L.standards_full || [] }; }) };
}

/** Same rules as before: YouTube, Google Drive, Vimeo, or a direct video file. */
function embedInfo_(url) {
  if (!url || !/^https:\/\//.test(url)) return null;
  var m;
  if ((m = /^https:\/\/(?:www\.|m\.)?(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{6,20})/.exec(url)))
    return { kind: 'iframe', src: 'https://www.youtube-nocookie.com/embed/' + m[1] };
  if ((m = /^https:\/\/drive\.google\.com\/file\/d\/([\w-]+)/.exec(url))) return { kind: 'iframe', src: 'https://drive.google.com/file/d/' + m[1] + '/preview' };
  if ((m = /^https:\/\/(?:www\.)?vimeo\.com\/(\d+)/.exec(url))) return { kind: 'iframe', src: 'https://player.vimeo.com/video/' + m[1] };
  if (/\.(mp4|webm|ogg)(\?|$)/i.test(url)) return { kind: 'video', src: url };
  return { kind: 'link', src: url };
}

// ---------------------------------------------------------------- install check
function escapeHtml_(s) {
  return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; });
}

/** Every pasted Script file must be there, complete (its last line sets its stamp), and from the same build. */
function installProblems_() {
  var out = [], stamps = typeof BUILD_STAMPS === 'undefined' ? {} : BUILD_STAMPS;
  Object.keys(BUILD_EXPECT).forEach(function (key) {
    var got = stamps[key], name = key + '.gs';
    if (!got) out.push(name + ' is missing or was cut short while pasting. Add it as a Script file named "' + key + '" and paste all of it.');
    else if (got !== BUILD_EXPECT[key]) out.push(name + ' is from a different version than Code.gs. Paste the new ' + name + '.');
  });
  return out;
}

/** Run this from the editor (choose checkInstall, press Run) to check everything; the result is in the log. */
function checkInstall() {
  var lines = [], ok = function (good, text) { lines.push((good ? '✅ ' : '❌ ') + text); };
  var problems = installProblems_();
  ok(!problems.length, problems.length ? 'Files: ' + problems.join(' | ') : 'All ' + BUILD_FILES.length + ' files are pasted, complete, and match (Code.gs ' + BUILD_ID + ')');
  try {
    ['styles', 'app'].forEach(function (k) { if (asset_(k).length < 1000) throw new Error(k + ' is empty'); });
    ok(true, 'The site\'s styles and code unpack');
  } catch (e) { ok(false, 'Assets.gs: ' + e.message); }
  try { ok(Object.keys(DATA.lessons).length > 0, Object.keys(DATA.lessons).length + ' lessons in Data.gs'); } catch (e) { ok(false, 'Data.gs: ' + e.message); }
  try { studentFolder_(); ok(true, 'Drive folder "' + DATA_FOLDER + '" is ready'); } catch (e) { ok(false, 'Drive folder: ' + e.message + ' (run setup)'); }
  try { var tr = LanguageApp.translate('Good morning', 'en', 'pt'); ok(!!tr, 'Translation to Portuguese works ("Good morning" → "' + tr + '")'); }
  catch (e) { ok(false, 'Translation: ' + e.message + ' (Portuguese pages will stay in English until this works)'); }
  try { var icon = faviconUrl_(); ok(true, 'Tab icon: ' + icon); } catch (e) { ok(false, 'Tab icon: ' + e.message); }
  try { config_(); ok(true, 'Settings file reads'); } catch (e) { ok(false, 'Settings: ' + e.message); }
  try { ok(true, 'Google Classroom: ' + classroomCoursesRaw_().length + ' active classes you teach'); }
  catch (e) { ok(false, 'Google Classroom: ' + e.message); }
  try { ok(ScriptApp.getService().isEnabled(), 'Web app is deployed: ' + ScriptApp.getService().getUrl()); } catch (e) { ok(false, 'Deployment: ' + e.message); }
  var report = lines.join('\n');
  Logger.log(report);
  return report;
}

function plainPage_(title, body) {
  return withIcon_(HtmlService.createHtmlOutput('<!doctype html><html><head><base target="_top"><meta charset="utf-8"></head>' +
    '<body style="font:16px/1.5 system-ui,sans-serif;max-width:760px;margin:24px auto;padding:0 16px;color:#12283f">' + body + '</body></html>')
    .setTitle(title));
}

// ---------------------------------------------------------------- the HTML around every page
/** The site's CSS and JavaScript, stored gzip-compressed in Assets.gs. */
var ASSET_CACHE_ = {};
function asset_(name) {
  if (ASSET_CACHE_[name] !== undefined) return ASSET_CACHE_[name];
  var blob = Utilities.newBlob(Utilities.base64Decode(ASSETS_GZ[name]), 'application/x-gzip');
  return (ASSET_CACHE_[name] = JSON.parse(Utilities.ungzip(blob).getDataAsString('UTF-8')));
}

/** Text as web-safe base64: only letters, digits, - and _, so Apps Script can't mistake any of it for a comment. */
function safe64_(text) {
  return Utilities.base64EncodeWebSafe(Utilities.newBlob(text, 'text/plain').getBytes()).replace(/=+$/, '');
}

// Apps Script strips // and /* comments from <script> blocks, without noticing when they're inside strings.
// So the page gets exactly two tiny scripts written with no slashes at all, and all real code and data
// travel as safe64 text that the loader decodes and runs.
var CRASH_SCRIPT_ = '<script>window.addEventListener("error",function(e){var b=document.getElementById("ml-crash");' +
  'if(!b){b=document.createElement("div");b.id="ml-crash";b.style.cssText="position:fixed;left:8px;right:8px;bottom:8px;' +
  'z-index:9999;background:#fde2e2;color:#7a1010;border:2px solid #b32626;border-radius:10px;padding:10px 14px;' +
  'font:14px system-ui,sans-serif;white-space:pre-wrap";(document.body||document.documentElement).appendChild(b);' +
  'b.textContent="Something went wrong on this page. Please send this to your teacher:"}' +
  'b.textContent+=String.fromCharCode(10)+(e.message||"error")+(e.lineno?" (line "+e.lineno+")":"")});</script>';
var LOADER_SCRIPT_ = '<script>(function(){var t=document.getElementById("ml-code");' +
  'function d(s){var b=atob(s.split("-").join("+").split("_").join(String.fromCharCode(47)));' +
  'var u=new Uint8Array(b.length);for(var i=0;i<b.length;i++){u[i]=b.charCodeAt(i)}return new TextDecoder().decode(u)}' +
  'var parts=t.textContent.split(".");for(var j=0;j<parts.length;j++){if(!parts[j])continue;' +
  'var s=document.createElement("script");s.textContent=d(parts[j]);document.body.appendChild(s)}' +
  'if(window.MLStart){window.MLStart()}})();</script>';

function json_(v) { return JSON.stringify(v).replace(/</g, '\\u003c'); }

// AppVenture's fonts: Lilita One for headings, Nunito for text (system fonts if Google Fonts is blocked). A <link>, not a
// CSS @import, because Apps Script strips "//" inside <style> blocks.
var FONTS_HTML_ = '<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito:wght@500;700;800;900&family=Lexend:wght@400;600;700&family=Atkinson+Hyperlegible:wght@400;700&display=swap">';

function render_(me, page) {
  var nav = me.teacher
    ? [['/', 'My classes'], ['/lessons', 'Lessons'], ['/map', 'Skill trees'], ['/teacher/standards', 'Standards'], ['/teacher/feedback', 'Feedback'], ['/teacher/reports', 'Reports'], ['/teacher/videos', 'Videos'], ['/arcade', '🎮 Arcade']]
    : [['/', 'Home'], ['/lessons', 'Lessons'], ['/map', 'Skill tree'], ['/me', 'My robot'], ['/arcade', '🎮 Arcade']];
  if (page.preview) nav = [['/', 'Home'], ['/lessons', 'Lessons'], ['/map', 'Skill tree'], ['/me', 'My robot'], ['/arcade', '🎮 Arcade']];
  var ml = { base: ScriptApp.getService().getUrl(), page: page.name, path: page.path || '/', teacher: me.teacher && !page.preview, nav: nav,
             preview: page.preview || null, data: page.data || {} };
  var globals = page.globals || {}, setup = 'window.ML=' + json_(ml) + ';';
  Object.keys(globals).forEach(function (k) { setup += 'window.' + k + '=' + json_(globals[k]) + ';'; });
  var code = [safe64_(setup), safe64_(asset_('app'))];
  var out = ['<!doctype html><html lang="en"><head><base target="_top"><meta charset="utf-8">', FONTS_HTML_,
    '<meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="apps-script">',
    '<style>', asset_('styles'), '</style></head><body class="apps-script ' + (page.bodyClass || '') + '">', CRASH_SCRIPT_,
    '<header class="topbar" id="topbar"></header>',
    '<main class="', page.mainClass || 'container', '" id="main">',
    page.html || '<p class="muted" style="padding:24px">Loading Maker Lab…</p><noscript>Maker Lab needs JavaScript turned on.</noscript>', '</main>',
    '<footer class="footer">micro:bit Maker Lab · <button type="button" class="linklike" id="footer-bug">🐞 Report a problem</button></footer>',
    '<div id="ml-code" hidden>', code.join('.'), '</div>', LOADER_SCRIPT_, '</body></html>'];
  return withIcon_(HtmlService.createHtmlOutput(out.join(''))
    .setTitle((page.title ? page.title + ' · ' : '') + APP_NAME)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1'));
}

// ---------------------------------------------------------------- lesson feedback and the report for improving lessons
// Students flag a build step or quiz question as confusing, and rate the lesson at the end. Kept in the student's
// record (rec.lesson_fb), not in lesson progress, so a partner's save never overwrites it. Help requests (37_help.js)
// count up per step too. The teacher's Feedback page adds it all up, with first-try quiz misses, without names.

var FB_REASONS_ = { unclear: 'The instructions were unclear', broken: "The code didn't work", hard: 'Too hard', easy: 'Too easy or boring', other: 'Something else' };

function fbOf_(rec, lid) {
  rec.lesson_fb = rec.lesson_fb || {};
  return rec.lesson_fb[lid] || (rec.lesson_fb[lid] = { flags: {}, help: {} });
}

/** /api/lessons/<id>/feedback  {kind: 'step' | 'quiz', i, reason, note}  or  {kind: 'rating', rating 1-5, hardest, change} */
function lessonFeedback_(ctx, L, d) {
  var fb = fbOf_(ctx.rec, L.id), i = Math.floor(Number(d.i));
  if (d.kind === 'step' || d.kind === 'quiz') {
    var list = d.kind === 'step' ? L.build : L.quiz;
    if (!(i >= 0 && i < list.length)) throw badRequest_('No such ' + d.kind + '.');
    if (!FB_REASONS_[d.reason]) throw badRequest_('Pick a reason.');
    fb.flags[d.kind + ':' + i] = { reason: d.reason, note: text_(d.note, 200).trim(), at: now_() };
    saveStudent_(ctx.rec);
    return { ok: true, flagged: d.kind + ':' + i };
  }
  if (d.kind === 'rating') {
    var r = Math.round(Number(d.rating));
    if (!(r >= 1 && r <= 5)) throw badRequest_('Pick how much you liked it.');
    fb.rating = r;
    fb.hardest = text_(d.hardest, 400).trim();
    fb.change = text_(d.change, 400).trim();
    fb.rated_at = now_();
    var rewards = syncRewards_(ctx.rec, ctx.cfg);
    saveStudent_(ctx.rec);
    return { ok: true, rating: r, rewards: rewards, level: levelInfo_(ctx.rec.xp || 0) };
  }
  throw badRequest_('Unknown feedback.');
}

/** What the lesson page needs to show what this student already said. */
function myFeedback_(rec, lid) {
  var fb = (rec && rec.lesson_fb && rec.lesson_fb[lid]) || {};
  return { flags: Object.keys(fb.flags || {}), rating: fb.rating || 0, hardest: fb.hardest || '', change: fb.change || '' };
}

/** Small copy for the summary file: the report reads every student from there. */
function fbSummary_(rec) {
  var out = {};
  Object.keys(rec.lesson_fb || {}).forEach(function (lid) {
    var f = rec.lesson_fb[lid];
    out[lid] = { flags: f.flags || {}, help: f.help || {}, rating: f.rating || 0, hardest: f.hardest || '', change: f.change || '' };
  });
  Object.keys(rec.progress || {}).forEach(function (lid) {
    var p = rec.progress[lid], first = p.quiz_first || p.quiz_answers;
    if (first) (out[lid] = out[lid] || { flags: {}, help: {} }).quiz = first;
  });
  return out;
}

/** Teacher: everything students said about each lesson in a course. No names. */
function feedbackReport(grade) {
  var cfg = teacher_(), sum = summary_(true), cid = DATA.courses[grade] ? grade : DATA.default_course;
  var lessons = lessonList_(cid).map(function (L) {
    var x = { id: L.id, number: L.number, title: L.title, file: L.file, ratings: [0, 0, 0, 0, 0], hardest: [], change: [],
              started: 0, finished: 0, steps: L.build.map(function (st, i) { return { n: i + 1, title: st.title, flags: 0, reasons: {}, notes: [], help: 0 }; }),
              quiz: L.quiz.map(function (q, i) { return { n: i + 1, question: q.question.replace(/<[^>]+>/g, ''), answered: 0, missed: 0, flags: 0, reasons: {}, notes: [] }; }) };
    Object.keys(sum.students).forEach(function (email) {
      var s = sum.students[email], f = (s.fb || {})[L.id], prog = (s.lessons || {})[L.id];
      if (prog) { x.started++; if (prog.pct === 100) x.finished++; }
      if (!f) return;
      if (f.rating) x.ratings[f.rating - 1]++;
      if (f.hardest) x.hardest.push(f.hardest);
      if (f.change) x.change.push(f.change);
      Object.keys(f.flags || {}).forEach(function (k) {
        var parts = k.split(':'), item = (parts[0] === 'step' ? x.steps : x.quiz)[+parts[1]], fl = f.flags[k];
        if (!item) return;
        item.flags++;
        item.reasons[fl.reason] = (item.reasons[fl.reason] || 0) + 1;
        if (fl.note) item.notes.push(fl.note);
      });
      Object.keys(f.help || {}).forEach(function (k) { if (x.steps[+k]) x.steps[+k].help += f.help[k]; });
      (f.quiz || []).forEach(function (a, qi) {
        if (!L.quiz[qi]) return;
        x.quiz[qi].answered++;
        if (a !== L.quiz[qi].answer) x.quiz[qi].missed++;
      });
    });
    var n = x.ratings.reduce(function (t, c) { return t + c; }, 0);
    x.rated = n;
    x.avg = n ? Math.round(10 * x.ratings.reduce(function (t, c, i) { return t + c * (i + 1); }, 0) / n) / 10 : null;
    return x;
  });
  return { grade: cid, grade_name: DATA.courses[cid].name, grades: DATA.course_ids.map(function (g) { return { id: g, name: DATA.courses[g].short }; }),
           students: Object.keys(sum.students).length, reasons: FB_REASONS_, lessons: lessons,
           generated: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd') };
}

// ---------------------------------------------------------------- daily backups and the owner's "Your data" card
// Once a day, every student record and the settings go into one dated JSON file in "Maker Lab data/backups"
// ("Maker Lab Backup 2026-11-18.json"). Reading every student takes a while, so the backup is built a few students
// at a time while the teacher uses Maker Lab (teacher pages and the class display), never inside the lock and never
// while a student waits. "Back up now" finishes it in one go. The last 8 backups are kept.

var BACKUPS_KEPT_ = 8;

function backupDay_() { return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd'); }
function backupList_() {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty('backup:list') || '[]'); } catch (e) { return []; }
}

/** Add up to `budgetMs` of students to today's backup. Safe to call often; a backup problem never breaks a page. */
function backupStep_(budgetMs) {
  var props = PropertiesService.getScriptProperties(), cache = CacheService.getScriptCache();
  try {
    var day = backupDay_(), st = JSON.parse(props.getProperty('backup:state') || '{}');
    if (st.day === day && st.done && !st.redo) return st;
    if (cache.get('backup:running')) return st;                       // another request is working on it
    cache.put('backup:running', '1', 60);
    if (st.day !== day) st = { day: day, i: 0, done: false, file: null };
    if (st.redo) st = { day: day, i: 0, done: false, file: st.file };          // "Back up now": start today's over, same file
    var emails = Object.keys(props.getProperties()).filter(function (k) { return k.indexOf('student:') === 0; })
      .map(function (k) { return k.slice(8); }).sort();
    var data = st.file && st.i > 0 ? readJsonFile_(st.file) : { app: 'Maker Lab', day: day, made_at: now_(), config: readNamed_('config', null), students: {} };
    var t0 = Date.now();
    while (st.i < emails.length && Date.now() - t0 < budgetMs) {
      var id = props.getProperty('student:' + emails[st.i]);
      if (id) data.students[emails[st.i]] = readJsonFile_(id);
      st.i++;
    }
    st.done = st.i >= emails.length;
    data.complete = st.done;
    data.count = Object.keys(data.students).length;
    var text = JSON.stringify(data);
    if (st.file) retry_(function () { DriveApp.getFileById(st.file).setContent(text); });
    else st.file = backupFolder_().createFile('Maker Lab Backup ' + day + '.json', text, 'application/json').getId();
    if (st.done) {
      var list = backupList_().filter(function (b) { return b.id !== st.file; });
      list.push({ id: st.file, day: day, students: data.count });
      while (list.length > BACKUPS_KEPT_) {
        var old = list.shift();
        try { DriveApp.getFileById(old.id).setTrashed(true); } catch (e) { /* already gone */ }
      }
      props.setProperty('backup:list', JSON.stringify(list));
    }
    props.setProperty('backup:state', JSON.stringify(st));
    cache.remove('backup:running');
    return st;
  } catch (e) {
    cache.remove('backup:running');
    console.warn('Backup step failed (nothing lost): ' + ((e && e.message) || e));
    return null;
  }
}

/** Owner: make today's backup again from scratch, now (it replaces today's file, so there's still one per day). */
function backupNow() {
  teacher_();
  var props = PropertiesService.getScriptProperties(), st = {};
  try { st = JSON.parse(props.getProperty('backup:state') || '{}'); } catch (e) { st = {}; }
  if (st.day === backupDay_()) { st.redo = true; props.setProperty('backup:state', JSON.stringify(st)); }
  CacheService.getScriptCache().remove('backup:running');
  var st = null;
  for (var k = 0; k < 6; k++) { st = backupStep_(4000); if (!st || st.done) break; }
  return dataInfo();
}

/** Owner: where the data lives, how much there is, the backups, and any other "Maker Lab data" folders in Drive. */
function dataInfo() {
  teacher_();
  var props = PropertiesService.getScriptProperties(), all = props.getProperties(), cfg = config_();
  var folderId = all['folder:data'] || '', folder = null, others = [];
  if (folderId) { try { folder = DriveApp.getFolderById(folderId); } catch (e) { folder = null; } }
  try {
    var it = DriveApp.getFoldersByName(DATA_FOLDER);
    while (it.hasNext() && others.length < 10) { var f = it.next(); if (f.getId() !== folderId) others.push({ id: f.getId(), url: f.getUrl() }); }
  } catch (e) { /* Drive search unavailable: skip */ }
  var history = [];
  try { history = JSON.parse(all['storage:history'] || '[]'); } catch (e) { history = []; }
  var st = {};
  try { st = JSON.parse(all['backup:state'] || '{}'); } catch (e) { st = {}; }
  return {
    folder: folder ? { id: folderId, url: folder.getUrl(), name: folder.getName() } : { id: folderId, missing: !!folderId },
    students: Object.keys(all).filter(function (k) { return k.indexOf('student:') === 0; }).length,
    classes: Object.keys(cfg.classes).length,
    backups: backupList_().map(function (b) {
      var url = '';
      try { url = DriveApp.getFileById(b.id).getUrl(); } catch (e) { url = ''; }
      return { day: b.day, students: b.students, url: url };
    }).reverse(),
    today: st.day === backupDay_() ? { done: !!st.done, students: st.i || 0 } : null,
    others: others, history: history.slice(-10).reverse(),
  };
}

// ---------------------------------------------------------------- translation (Português do Brasil)
// The page sends the sentences it shows (HTML with only inline tags; code, numbers and names already swapped for
// <span translate="no">§n</span> placeholders by client/lib/translate.js). Each sentence is translated once with
// Google's LanguageApp and kept: in the cache (6 h) and in 16 small Drive files ("translations-pt-0" … "-f"),
// so later visits are instant. A request stops after about 8 seconds and the page asks again for the rest.
// No lock: two students translating the same sentence at once just both save the same answer.

var TR_LANGS_ = { pt: 'pt' };
var TR_BUDGET_MS_ = 8000;

function trHash_(s) {
  var h1 = 0x811c9dc5, h2 = 5381;
  for (var i = 0; i < s.length; i++) { var c = s.charCodeAt(i); h1 = Math.imul(h1 ^ c, 16777619) >>> 0; h2 = ((h2 * 33) ^ c) >>> 0; }
  return ('0000000' + h1.toString(16)).slice(-8) + ('0000000' + h2.toString(16)).slice(-8);
}

/** Translate up to 80 sentences. Returns {done: {hash: translation}, left: number still to do (ask again)}. */
function translate(lang, items) {
  if (!whoIs_().email) throw new Error('Sign in with your school Google account.');
  var tl = TR_LANGS_[lang];
  if (!tl) throw new Error('That language isn\'t available.');
  items = (items || []).slice(0, 80).map(function (s) { return String(s).slice(0, 4000); });
  var cache = CacheService.getScriptCache(), out = {}, need = {};
  items.forEach(function (s) { need[trHash_(s)] = s; });
  var hashes = Object.keys(need), hit = cache.getAll(hashes.map(function (h) { return 'tr:' + lang + ':' + h; })) || {};
  hashes.forEach(function (h) { var v = hit['tr:' + lang + ':' + h]; if (v != null) { out[h] = v; delete need[h]; } });
  // saved translations, one small file per first letter of the hash
  var shards = {};
  Object.keys(need).forEach(function (h) { (shards[h.charAt(0)] = shards[h.charAt(0)] || []).push(h); });
  var shardData = {};
  Object.keys(shards).forEach(function (k) {
    shardData[k] = readNamed_('translations-' + lang + '-' + k, {});
    shards[k].forEach(function (h) { if (shardData[k][h] != null) { out[h] = shardData[k][h]; delete need[h]; } });
  });
  // new sentences: ask Google, many at once, until the time runs out
  var fresh = {}, todo = Object.keys(need), t0 = Date.now();
  while (todo.length && Date.now() - t0 < TR_BUDGET_MS_) {
    var batch = [], size = 0;
    while (todo.length && batch.length < 40 && size + need[todo[0]].length < 4500) { size += need[todo[0]].length; batch.push(todo.shift()); }
    if (!batch.length) batch.push(todo.shift());
    trBatch_(batch.map(function (h) { return need[h]; }), tl).forEach(function (t, i) { if (t != null) fresh[batch[i]] = t; });
  }
  var put = {};
  Object.keys(fresh).forEach(function (h) {
    out[h] = fresh[h];
    put['tr:' + lang + ':' + h] = fresh[h];
    var k = h.charAt(0);
    if (!shardData[k]) shardData[k] = readNamed_('translations-' + lang + '-' + k, {});
    shardData[k][h] = fresh[h];
  });
  Object.keys(out).forEach(function (h) { if (!put['tr:' + lang + ':' + h]) put['tr:' + lang + ':' + h] = out[h]; });
  try { cache.putAll(put, 21600); } catch (e) { /* too big for the cache: the Drive copy still has it */ }
  var changed = {};
  Object.keys(fresh).forEach(function (h) { changed[h.charAt(0)] = 1; });
  Object.keys(changed).forEach(function (k) { writeNamed_('translations-' + lang + '-' + k, shardData[k]); });
  return { done: out, left: Object.keys(need).length - Object.keys(fresh).length };
}

/** One call to Google for several sentences: each goes in its own <div id="tN">, and comes back the same way. */
function trBatch_(list, tl) {
  var html = list.map(function (s, i) { return '<div id="t' + i + '">' + s + '</div>'; }).join('');
  var res = retry_(function () { return LanguageApp.translate(html, 'en', tl, { contentType: 'html' }); });
  var got = [], re = /<div id="t(\d+)">([\s\S]*?)<\/div>/g, m;
  while ((m = re.exec(res))) got[+m[1]] = m[2];
  return list.map(function (s, i) {
    if (got[i] != null) return got[i];
    try { return retry_(function () { return LanguageApp.translate(s, 'en', tl, { contentType: 'html' }); }); } catch (e) { return null; }
  });
}

// ---------------------------------------------------------------- 🐞 problem reports
// Students (and the teacher) report a problem from Aa → "Report a problem" or the footer; the page adds where they
// were (page, lesson, stage, step), the browser, the app version and its last errors. Page errors are also reported
// on their own (client/lib/bugs.js, at most 3 per visit) and repeats are dropped here. Reports are kept in one file
// ("bugs"), newest 400. Saving takes the lock briefly (read, add one, write); nothing slow happens inside it.

var BUG_KEEP_ = 400, BUG_PER_DAY_ = 10;
var BUG_KINDS_ = { broken: "Something didn't work", words: 'Words are wrong or confusing', find: "I can't find something", other: 'Something else', auto: 'Page error (automatic)' };

function reportBug(d) {
  var me = whoIs_();
  if (!me.email) throw new Error('Sign in with your school Google account.');
  d = d || {};
  var kind = BUG_KINDS_[d.kind] ? d.kind : 'other';
  var text = String(d.text || '').slice(0, 1500).trim();
  if (kind !== 'auto' && text.length < 3) throw new Error('Tell us a little about what happened.');
  var cache = CacheService.getScriptCache(), day = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
  var mine = 'bugs:' + day + ':' + me.email, count = Number(cache.get(mine) || 0);
  if (count >= BUG_PER_DAY_) return { ok: true, skipped: 'too many today' };
  if (kind === 'auto') {                                       // the same page error once a day is enough
    var key = 'bug:' + trHash_(String(d.text || '') + '|' + String(d.page || ''));
    if (cache.get(key)) return { ok: true, skipped: 'seen' };
    cache.put(key, '1', 21600);
  }
  cache.put(mine, String(count + 1), 21600);
  var ctx = d.ctx || {};
  var rec = me.teacher ? null : (function () { try { return loadStudent_(me.email); } catch (e) { return null; } })();
  var bug = { id: Math.random().toString(36).slice(2, 10), at: now_(), status: 'new', kind: kind, text: text,
              email: me.email, name: me.teacher ? 'Teacher' : ((rec && rec.name) || me.email.split('@')[0]),
              page: String(d.page || '').slice(0, 200),
              lesson: String(ctx.lesson || '').slice(0, 60), stage: String(ctx.stage || '').slice(0, 20),
              step: ctx.step == null ? null : Number(ctx.step), lang: String(ctx.lang || '').slice(0, 5),
              browser: String(d.browser || '').slice(0, 200), screen: String(d.screen || '').slice(0, 40),
              version: typeof BUILD_STAMPS !== "undefined" ? (BUILD_STAMPS.Assets || "") + "/" + (BUILD_STAMPS.Data || "") : "",
              errors: (d.errors || []).slice(-5).map(function (e) { return String(e).slice(0, 300); }) };
  withLock_(function () {
    var list = readNamed_('bugs', []);
    list.unshift(bug);
    if (list.length > BUG_KEEP_) list = list.slice(0, BUG_KEEP_);
    writeNamed_('bugs', list);
  });
  return { ok: true, id: bug.id };
}

/** Teacher: all reports, newest first, with the lesson's title and file. */
function bugList() {
  teacher_();
  return { kinds: BUG_KINDS_, bugs: readNamed_('bugs', []).map(function (b) {
    var L = DATA.lessons[b.lesson];
    var out = JSON.parse(JSON.stringify(b));
    delete out.email;
    if (L) { out.lesson_title = L.number + '. ' + L.title; out.file = L.file; out.course = DATA.courses[L.course].short;
             if (b.step != null && L.build[b.step]) out.step_title = 'Step ' + (b.step + 1) + ': ' + L.build[b.step].title; }
    return out;
  }) };
}

/** Teacher: mark a report fixed / new again, or delete it. */
function bugUpdate(id, status) {
  teacher_();
  if (['new', 'fixed', 'deleted'].indexOf(status) < 0) throw new Error('Unknown status.');
  withLock_(function () {
    var list = readNamed_('bugs', []);
    list = status === 'deleted' ? list.filter(function (b) { return b.id !== id; })
      : list.map(function (b) { if (b.id === id) b.status = status; return b; });
    writeNamed_('bugs', list);
  });
  return bugList();
}

function bugCountNew_() {
  try { return readNamed_('bugs', []).filter(function (b) { return b.status === 'new'; }).length; } catch (e) { return 0; }
}

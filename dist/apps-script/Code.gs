/**
 * micro:bit Maker Lab for Google Apps Script.
 *
 * This file is GENERATED by tools/build_apps_script.py from apps_script/server/*.js.
 * Edit those files in the repository, rebuild, and paste the result. Setup steps: INSTALL.md.
 *
 * How it works
 *  - Deploy as a web app: Execute as "Me", access "Anyone within your school".
 *  - Everyone who opens it is identified by their school Google account.
 *  - The script owner is the teacher. Everyone else is a student.
 *  - Each student's work is one JSON file in the "Maker Lab data/students" folder of the
 *    teacher's Drive, so 30 students saving at once never wait for each other.
 */
var APP_NAME = 'micro:bit Maker Lab';
var DATA_FOLDER = 'Maker Lab data';
var FIRMWARE = {
  v1: 'https://github.com/bbcmicrobit/micropython/releases/download/v1.1.1/micropython-microbit-v1.1.1.hex',
  v2: 'https://github.com/microbit-foundation/micropython-microbit-v2/releases/download/v2.1.2/micropython-microbit-v2.1.2.hex',
};
var FIRMWARE_PART = 400000;          // characters per google.script.run reply
var MAX_TEXT = 20000;                // longest text a student can save in one field
var SUMMARY_MAX_AGE_MS = 60 * 1000;  // the gradebook refreshes changed students at most once a minute

// ---------------------------------------------------------------- who is here
function whoIs_() {
  var email = '';
  try { email = (Session.getActiveUser().getEmail() || '').toLowerCase(); } catch (e) { email = ''; }
  var owner = (Session.getEffectiveUser().getEmail() || '').toLowerCase();
  return { email: email, teacher: !!email && email === owner };
}

function now_() { return new Date().toISOString(); }

// ---------------------------------------------------------------- Drive folders
function folder_(key, name, parentFn) {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty(key);
  if (id) {
    try { return DriveApp.getFolderById(id); } catch (e) { /* deleted: make a new one */ }
  }
  var f = parentFn ? parentFn().createFolder(name) : DriveApp.createFolder(name);
  props.setProperty(key, f.getId());
  return f;
}
function dataFolder_() { return folder_('folder:data', DATA_FOLDER, null); }
function studentFolder_() { return folder_('folder:students', 'students', dataFolder_); }

function readJsonFile_(id) {
  return JSON.parse(DriveApp.getFileById(id).getBlob().getDataAsString());
}

/** A JSON file in the data folder, found by a script property, made on first write. */
function readNamed_(key, fallback) {
  var id = PropertiesService.getScriptProperties().getProperty('file:' + key);
  if (!id) return fallback;
  try { return readJsonFile_(id); } catch (e) { return fallback; }
}
function writeNamed_(key, value) {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('file:' + key);
  var text = JSON.stringify(value);
  if (id) {
    try { DriveApp.getFileById(id).setContent(text); return; } catch (e) { /* deleted: make a new one */ }
  }
  var f = dataFolder_().createFile(key + '.json', text, 'application/json');
  props.setProperty('file:' + key, f.getId());
}

// ---------------------------------------------------------------- teacher settings
// Only the teacher writes this file: classes, assignments, videos, feedback and bonus XP.
function emptyConfig_() {
  return { v: 1, classes: {}, assignments: [], videos: {}, feedback: {}, bonuses: {}, picks: {}, removed: {}, rosters: {}, next_id: 1 };
}
function config_() {
  var c = CacheService.getScriptCache().get('config');
  if (c) { var cached = JSON.parse(c); cached.rosters = cached.rosters || {}; return cached; }
  var cfg = readNamed_('config', null) || emptyConfig_();
  cfg.rosters = cfg.rosters || {};              // added with the Google Classroom import
  cacheConfig_(cfg);
  return cfg;
}
function cacheConfig_(cfg) {
  var text = JSON.stringify(cfg);
  if (text.length < 90000) CacheService.getScriptCache().put('config', text, 600);
  else CacheService.getScriptCache().remove('config');
}
function saveConfig_(cfg) {
  writeNamed_('config', cfg);
  cacheConfig_(cfg);
}
function nextId_(cfg) { var id = cfg.next_id || 1; cfg.next_id = id + 1; return id; }

/** Classes a student belongs to: joined with a code or on a Google Classroom roster, and not removed by the teacher. */
function studentClassIds_(rec, cfg) {
  var ids = (rec.classes || []).slice();
  Object.keys(cfg.rosters || {}).forEach(function (cid) { if (cfg.rosters[cid][rec.email] && ids.indexOf(cid) < 0) ids.push(cid); });
  return ids.filter(function (cid) {
    return cfg.classes[cid] && (cfg.removed[cid] || []).indexOf(rec.email) < 0;
  });
}

// ---------------------------------------------------------------- student files
function newStudent_(email) {
  return { v: 1, email: email, name: '', classes: [], xp: 0, avatar: null, badges: {}, xp_keys: {},
           xp_log: [], progress: {}, created_at: now_(), updated_at: now_() };
}
function studentFileId_(email) {
  return PropertiesService.getScriptProperties().getProperty('student:' + email);
}
function loadStudent_(email) {
  var cached = CacheService.getScriptCache().get('s:' + email);
  if (cached) return JSON.parse(cached);
  var id = studentFileId_(email);
  if (!id) return null;
  try { return readJsonFile_(id); } catch (e) { return null; }
}
function saveStudent_(rec) {
  rec.updated_at = now_();
  var text = JSON.stringify(rec);
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('student:' + rec.email);
  var saved = false;
  if (id) {
    try { DriveApp.getFileById(id).setContent(text); saved = true; } catch (e) { /* deleted: make a new one */ }
  }
  if (!saved) {
    var name = 'student-' + rec.email.replace(/[^a-z0-9._-]/g, '_') + '.json';
    props.setProperty('student:' + rec.email, studentFolder_().createFile(name, text, 'application/json').getId());
  }
  if (text.length < 90000) CacheService.getScriptCache().put('s:' + rec.email, text, 600);
  else CacheService.getScriptCache().remove('s:' + rec.email);
}

// ---------------------------------------------------------------- gradebook summary
// One small record per student, rebuilt from files that changed since the last look.
function summary_() {
  var s = readNamed_('summary', null) || { built_ms: 0, students: {} };
  if (Date.now() - (s.built_ms || 0) < SUMMARY_MAX_AGE_MS) return s;
  var since = (s.built_ms || 0) - 120000;       // overlap a little, Drive times are rounded
  var started = Date.now();
  var props = PropertiesService.getScriptProperties().getProperties();
  var byId = {};
  Object.keys(props).forEach(function (k) { if (k.indexOf('student:') === 0) byId[props[k]] = k.slice(8); });
  // Walk the folder instead of using a Drive search query (real Drive rejected the query: "Invalid argument: q").
  var it = studentFolder_().getFiles();
  while (it.hasNext()) {
    var f = it.next();
    var email = byId[f.getId()];
    if (!email || f.getLastUpdated().getTime() <= since) continue;
    try { s.students[email] = studentSummary_(JSON.parse(f.getBlob().getDataAsString())); } catch (e) { /* skip a bad file */ }
  }
  s.built_ms = started;
  writeNamed_('summary', s);
  return s;
}

function studentSummary_(rec) {
  var lessons = {};
  Object.keys(rec.progress || {}).forEach(function (lid) {
    var L = DATA.lessons[lid];
    if (!L) return;
    var p = rec.progress[lid];
    lessons[lid] = { pct: percent_(p, L), quiz_best: p.quiz_best == null ? null : p.quiz_best, quiz_total: p.quiz_total || 0,
                     debug_solved: !!p.debug_solved, challenge: !!p.challenge_submitted_at, stars: lessonStars_(L, p),
                     completed_at: p.completed_at || null, updated_at: p.updated_at || null };
  });
  return { name: rec.name, classes: rec.classes || [], xp: rec.xp || 0, avatar: rec.avatar || null,
           badges: Object.keys(rec.badges || {}), lessons: lessons, updated_at: rec.updated_at, wins: recentWins_(rec) };
}

/** A student's last few wins for the class display: badges, finished lessons, perfect quizzes, teacher bonuses. */
function winKind_(e) {
  var key = e.key || '', r = e.reason || '';
  if (key.indexOf('badge:') === 0 || (!key && r.indexOf('Badge: ') === 0)) return 'badge';
  if (key.indexOf('complete:') === 0 || (!key && r.indexOf(DATA.section_labels.complete + ' · ') === 0)) return 'complete';
  if (key.indexOf('quiz_perfect:') === 0 || (!key && r.indexOf(DATA.section_labels.quiz_perfect + ' · ') === 0)) return 'quiz_perfect';
  if (key.indexOf('bonus:') === 0 || (!key && r.indexOf('Bonus from your teacher') === 0)) return 'bonus';
  return null;
}
function recentWins_(rec) {
  return (rec.xp_log || []).filter(winKind_).slice(0, 5).map(function (e) {
    return { kind: winKind_(e), reason: e.reason, at: e.at };
  });
}

// ---------------------------------------------------------------- lesson sections
function percent_(p, L) {
  var keys = L.section_keys, s = (p && p.sections) || {}, done = 0;
  keys.forEach(function (k) { if (s[k]) done++; });
  return keys.length ? Math.round(100 * done / keys.length) : 0;
}

function lessonStars_(L, p) {
  if (!p) return 0;
  var first = L.has_debug ? p.debug_solved : (p.sections || {}).lab;
  return (first ? 1 : 0) + (p.quiz_total && p.quiz_best === p.quiz_total ? 1 : 0) + (p.challenge_submitted_at ? 1 : 0);
}

// ---------------------------------------------------------------- code checks (never runs student code)
/** Removes # comments outside strings, line by line, like lessons.py. */
function stripComments_(code) {
  return String(code).split('\n').map(function (line) {
    var inStr = null, out = '';
    for (var i = 0; i < line.length; i++) {
      var ch = line.charAt(i);
      if (inStr) { if (ch === inStr) inStr = null; }
      else if (ch === '"' || ch === "'") inStr = ch;
      else if (ch === '#') break;
      out += ch;
    }
    return out.replace(/\s+$/, '');
  }).join('\n');
}

/** Python regex -> JavaScript regex. The build checks every lesson pattern behaves the same. */
function pyRegex_(pattern) {
  var src = String(pattern), flags = 'm';
  var inline = /^\(\?([aiLmsux]+)\)/.exec(src);      // Python's leading (?i), (?s) ... flags
  if (inline) {
    src = src.slice(inline[0].length);
    if (inline[1].indexOf('i') >= 0) flags += 'i';
    if (inline[1].indexOf('s') >= 0) flags += 's';
  }
  src = src.replace(/\\A/g, '^(?<![\\s\\S])').replace(/\\Z/g, '$(?![\\s\\S])');
  return new RegExp(src, flags);
}

function runChecks_(code, checks) {
  var stripped = stripComments_(code);
  return checks.map(function (c) {
    if (c.type === 'syntax') {
      var err = pythonSyntaxError_(code);
      return err ? { ok: false, message: c.message || err } : { ok: true, message: c.message || '' };
    }
    var hit = pyRegex_(c.pattern).test(stripped);
    return { ok: c.type === 'contains' ? hit : !hit, message: c.message || '' };
  });
}

/**
 * A small Python syntax checker for beginner programs. It finds the mistakes students make
 * (a missing colon, bad indentation, an unclosed bracket or quote, = inside if, a misspelled
 * keyword) and returns a message like Python's, or '' when the code looks fine.
 * The build compares it with real Python on every code sample in the lessons.
 */
var PY_KEYWORDS_ = ['if', 'elif', 'else', 'for', 'while', 'def', 'class', 'try', 'except', 'finally', 'with',
  'return', 'import', 'from', 'raise', 'pass', 'break', 'continue', 'del', 'global', 'nonlocal', 'assert',
  'yield', 'lambda', 'not', 'async', 'await', 'match', 'case', 'in', 'is', 'and', 'or', 'print'];
var TRIPLE_D_ = '"' + '"' + '"', TRIPLE_S_ = "'" + "'" + "'";

function pythonSyntaxError_(code) {
  var lines = String(code).replace(/\r/g, '').split('\n');
  var say = function (n, msg) { return "Python can't read line " + n + ': ' + msg; };
  var close = { ')': '(', ']': '[', '}': '{' };
  var logical = [], stack = [], cur = null, triple = null, tripleLine = 0;
  for (var n = 0; n < lines.length; n++) {
    var raw = lines[n], clean = '', i = 0;
    while (i < raw.length) {
      var ch = raw.charAt(i);
      if (triple) {
        if (raw.substr(i, 3) === triple) { triple = null; clean += 'S'; i += 3; } else i++;
        continue;
      }
      if (ch === '#') break;
      var three = raw.substr(i, 3);
      if (three === TRIPLE_D_ || three === TRIPLE_S_) { triple = three; tripleLine = n + 1; i += 3; continue; }
      if (ch === '"' || ch === "'") {
        var j = i + 1;
        while (j < raw.length && raw.charAt(j) !== ch) j += raw.charAt(j) === '\\' ? 2 : 1;
        if (j >= raw.length) return say(n + 1, 'unterminated string literal (a quote is missing)');
        clean += 'S'; i = j + 1; continue;
      }
      if (ch === '(' || ch === '[' || ch === '{') stack.push({ c: ch, line: n + 1 });
      else if (close[ch]) {
        var top = stack.pop();
        if (!top) return say(n + 1, "unmatched '" + ch + "'");
        if (top.c !== close[ch]) return say(n + 1, "closing parenthesis '" + ch + "' does not match opening parenthesis '" + top.c + "'");
      }
      clean += ch; i++;
    }
    if (!cur) {
      if (!clean.trim() && !stack.length && !triple) continue;
      cur = { line: n + 1, indent: (raw.match(/^[ \t]*/) || [''])[0], text: clean.trim() };
    } else {
      cur.text += ' ' + clean.trim();
    }
    if (!stack.length && !triple && !/\\$/.test(clean.replace(/\s+$/, ''))) { logical.push(cur); cur = null; }
  }
  if (triple) return say(tripleLine, 'unterminated triple-quoted string');
  if (stack.length) return say(stack[stack.length - 1].line, "'" + stack[stack.length - 1].c + "' was never closed");
  if (cur) logical.push(cur);

  var indents = [0], expect = false, last = 0;
  for (var k = 0; k < logical.length; k++) {
    var L = logical[k], body = L.text;
    if (/\t/.test(L.indent) && / /.test(L.indent)) return say(L.line, 'inconsistent use of tabs and spaces in indentation');
    var w = L.indent.replace(/\t/g, '        ').length;
    if (expect) {
      if (w <= indents[indents.length - 1]) return say(L.line, 'expected an indented block');
      indents.push(w); expect = false;
    } else if (w > indents[indents.length - 1]) {
      return say(L.line, 'unexpected indent');
    } else {
      while (w < indents[indents.length - 1]) indents.pop();
      if (w !== indents[indents.length - 1]) return say(L.line, 'unindent does not match any outer indentation level');
    }
    var first = (/^[A-Za-z_]\w*/.exec(body) || [''])[0];
    // the first ':' outside brackets (not part of :=)
    var depth = 0, colon = -1;
    for (var c = 0; c < body.length; c++) {
      var x = body.charAt(c);
      if ('([{'.indexOf(x) >= 0) depth++;
      else if (')]}'.indexOf(x) >= 0) depth--;
      else if (x === ':' && depth === 0 && body.charAt(c + 1) !== '=') { colon = c; break; }
    }
    if (/^(if|elif|else|for|while|def|class|try|except|finally|with)$/.test(first)) {
      if (colon < 0) return say(L.line, "expected ':'");
      if (/^(else|try|finally)$/.test(first) && body.slice(first.length, colon).trim()) return say(L.line, "expected ':'");
      if (/^(if|elif|while)$/.test(first)) {
        var cond = body.slice(first.length, colon).replace(/[=!<>]=|:=/g, ''), flat = '', d = 0;
        for (var y = 0; y < cond.length; y++) {
          var z = cond.charAt(y);
          if ('([{'.indexOf(z) >= 0) d++; else if (')]}'.indexOf(z) >= 0) d--; else if (d === 0) flat += z;
        }
        if (flat.indexOf('=') >= 0) return say(L.line, "invalid syntax. Maybe you meant '==' instead of '='?");
      }
      if (!body.slice(colon + 1).trim()) expect = true;
    } else if (first === 'print' && /^print\s+[^\s(=]/.test(body)) {
      return say(L.line, "Missing parentheses in call to 'print'. Did you mean print(...)?");
    } else if (first && PY_KEYWORDS_.indexOf(first) < 0 && /^[A-Za-z_]\w*\s+[A-Za-z_\d(S]/.test(body)
               && !/^[A-Za-z_]\w*\s+(if|else|and|or|in|is|not|for)\b/.test(body)) {
      return say(L.line, 'invalid syntax');
    }
    last = L.line;
  }
  if (expect) return say(last + 1, 'expected an indented block');
  return '';
}

// ---------------------------------------------------------------- quiz
function gradeQuiz_(L, answers) {
  var results = L.quiz.map(function (q, i) {
    var a = answers[i];
    return { correct: a === q.answer, explain: q.explain, answer: q.answer };
  });
  var score = results.filter(function (r) { return r.correct; }).length;
  return { score: score, total: L.quiz.length, results: results };
}

// ---------------------------------------------------------------- XP, levels, badges, map, avatars
// A JavaScript copy of app/gamify.py. The numbers (XP values, levels, badges, map, avatar parts)
// come from gamify.py through the build, so there is still one place to change them.

function levelInfo_(xp) {
  var levels = DATA.levels, lvl = 1;
  for (var i = 0; i < levels.length; i++) if (xp >= levels[i][0]) lvl = i + 1;
  var floor = levels[lvl - 1][0], next = lvl < levels.length ? levels[lvl][0] : null;
  return { level: lvl, title: levels[lvl - 1][1], xp: xp, floor: floor, next: next,
           pct: next === null ? 100 : Math.round(100 * (xp - floor) / (next - floor)), max: next === null };
}

function badgeById_(id) {
  for (var i = 0; i < DATA.badges.length; i++) {
    var b = DATA.badges[i];
    if (b[0] === id) return { id: b[0], icon: b[1], name: b[2], desc: b[3] };
  }
  return null;
}

function lessonList_() { return DATA.order.map(function (id) { return DATA.lessons[id]; }); }

function badgeChecks_(rec, cfg) {
  var earned = {}, prog = rec.progress || {}, ids = Object.keys(prog).filter(function (l) { return DATA.lessons[l]; });
  var done = ids.filter(function (l) { return percent_(prog[l], DATA.lessons[l]) === 100; });
  var keys = Object.keys(rec.xp_keys || {});
  var any = function (fn) { return ids.some(function (l) { return fn(prog[l], DATA.lessons[l]); }); };
  var count = function (fn) { return ids.filter(function (l) { return fn(prog[l], DATA.lessons[l]); }).length; };
  if (any(function (p) { var s = p.sections || {}; return Object.keys(s).some(function (k) { return s[k]; }); })) earned['first-spark'] = 1;
  if (any(function (p) { return (p.sections || {}).circuit; })) earned['let-there-be-light'] = 1;
  if (ids.reduce(function (t, l) { return t + (prog[l].sends || 0); }, 0) >= 10) earned['hardware-hacker'] = 1;
  var fixed = count(function (p) { return p.debug_solved; });
  if (fixed >= 1) earned['bug-squasher'] = 1;
  if (fixed >= 5) earned['exterminator'] = 1;
  if (keys.some(function (k) { return k.indexOf('clean_fix:') === 0; })) earned['clean-fix'] = 1;
  if (keys.some(function (k) { return k.indexOf('quiz_perfect:') === 0; })) earned['quiz-whiz'] = 1;
  if (keys.filter(function (k) { return k.indexOf('quiz_first_try:') === 0; }).length >= 3) earned['sharpshooter'] = 1;
  if (keys.filter(function (k) { return k.indexOf('learn_check_') === 0; }).length >= 15) earned['eagle-eye'] = 1;
  if (count(function (p) { return p.challenge_submitted_at; }) >= 3) earned['inventor'] = 1;
  if (done.length) earned['finisher'] = 1;
  if (count(function (p, L) { return lessonStars_(L, p) === 3; }) >= 5) earned['star-collector'] = 1;
  var units = {};
  ids.forEach(function (l) { units[DATA.lessons[l].unit] = 1; });
  if (Object.keys(units).length >= 3) earned['explorer'] = 1;
  if (rec.avatar) earned['robot-stylist'] = 1;
  Object.keys(DATA.units).forEach(function (u) {
    var inUnit = lessonList_().filter(function (L) { return String(L.unit) === String(u) && L.kind !== 'check'; });
    if (inUnit.length && inUnit.every(function (L) { return done.indexOf(L.id) >= 0; })) earned['unit-' + u] = 1;
  });
  var core = lessonList_().filter(function (L) { return L.unit <= 4 && L.kind !== 'check'; });
  if (core.length && core.every(function (L) { return done.indexOf(L.id) >= 0; })) earned['graduate'] = 1;
  var classes = studentClassIds_(rec, cfg);
  if (classes.length && done.length) {
    cfg.assignments.forEach(function (a) {
      if (classes.indexOf(a.class_id) < 0 || !a.due) return;
      var p = prog[a.lesson_id];
      if (p && p.completed_at && p.completed_at.slice(0, 10) <= a.due) earned['early-bird'] = 1;
    });
  }
  if ((cfg.picks || {})[rec.email]) earned['teachers-pick'] = 1;
  return earned;
}

function award_(rec, key, amount, reason, gained) {
  if (rec.xp_keys[key] !== undefined) return;
  rec.xp_keys[key] = amount;
  rec.xp = (rec.xp || 0) + amount;
  rec.xp_log.unshift({ amount: amount, reason: reason, at: now_(), key: key });
  if (rec.xp_log.length > 40) rec.xp_log.length = 40;
  gained.push({ amount: amount, reason: reason });
}

/** Awards any XP and badges the student has earned but not yet received. Never double-counts. */
function syncRewards_(rec, cfg) {
  var before = levelInfo_(rec.xp || 0), gained = [], X = DATA.xp, labels = DATA.section_labels;
  rec.xp_keys = rec.xp_keys || {}; rec.xp_log = rec.xp_log || []; rec.badges = rec.badges || {};
  Object.keys(rec.progress || {}).forEach(function (lid) {
    var L = DATA.lessons[lid], p = rec.progress[lid];
    if (!L) return;
    var s = p.sections || {};
    L.section_keys.forEach(function (k) {
      if (s[k]) award_(rec, k + ':' + lid, X[k], labels[k] + ' · ' + L.title, gained);
    });
    if (p.debug_solved && !(p.debug_hints_used || 0)) award_(rec, 'clean_fix:' + lid, X.clean_fix, labels.clean_fix + ' · ' + L.title, gained);
    if (p.quiz_total && p.quiz_best === p.quiz_total) {
      award_(rec, 'quiz_perfect:' + lid, X.quiz_perfect, labels.quiz_perfect + ' · ' + L.title, gained);
      if (p.quiz_attempts === 1) award_(rec, 'quiz_first_try:' + lid, X.quiz_first_try, labels.quiz_first_try + ' · ' + L.title, gained);
    }
    Object.keys(p.learn_checks || {}).sort().forEach(function (i) {
      var row = p.learn_checks[i];
      if (row && row.ok && row.tries === 1 && (L.learn_checks || [])[+i])
        award_(rec, 'learn_check_' + i + ':' + lid, X.learn_check, labels.learn_check + ' · ' + L.title, gained);
    });
    if (percent_(p, L) === 100) award_(rec, 'complete:' + lid, X.complete, labels.complete + ' · ' + L.title, gained);
  });
  ((cfg.bonuses || {})[rec.email] || []).forEach(function (b) { award_(rec, b.key, b.amount, b.reason, gained); });
  var newBadges = [], earned = badgeChecks_(rec, cfg);
  Object.keys(earned).sort().forEach(function (bid) {
    if (rec.badges[bid]) return;
    var b = badgeById_(bid);
    if (!b) return;
    rec.badges[bid] = now_();
    award_(rec, 'badge:' + bid, X.badge, 'Badge: ' + b.name, gained);
    newBadges.push(b);
  });
  var after = levelInfo_(rec.xp || 0);
  return { xp_gained: gained.reduce(function (t, g) { return t + g.amount; }, 0), items: gained.slice(0, 6),
           badges: newBadges, level: after, level_up: after.level > before.level };
}

function lessonXp_(rec, lid) {
  var total = 0;
  Object.keys(rec.xp_keys || {}).forEach(function (k) {
    var i = k.indexOf(':');
    if (i > 0 && k.slice(i + 1) === lid) total += rec.xp_keys[k];
  });
  return total;
}

function badgeList_(rec) {
  return DATA.badges.map(function (b) {
    var at = (rec.badges || {})[b[0]];
    return { id: b[0], icon: b[1], name: b[2], desc: b[3], earned: !!at, earned_at: at || null };
  });
}

// ---------------------------------------------------------------- map
/** Lessons a student must do because their class assigned them (choice branches only once started). */
function assignedIds_(rec, cfg) {
  var classes = studentClassIds_(rec, cfg), out = {};
  cfg.assignments.forEach(function (a) { if (classes.indexOf(a.class_id) >= 0 && !a.branch) out[a.lesson_id] = 1; });
  return out;
}

function mapData_(rec, assigned) {
  var prog = (rec && rec.progress) || {}, complete = {}, nodes = [], current = null;
  lessonList_().forEach(function (L) { if (prog[L.id] && percent_(prog[L.id], L) === 100) complete[L.id] = 1; });
  var recent = Object.keys(prog).filter(function (l) { return DATA.lessons[l] && !complete[l]; })
    .sort(function (a, b) { return String(prog[b].updated_at || '').localeCompare(String(prog[a].updated_at || '')); });
  if (recent.length) current = recent[0];
  lessonList_().forEach(function (L) {
    var t = DATA.tree[L.id];
    if (!t) return;
    var p = prog[L.id], pct = p ? percent_(p, L) : 0;
    var reqs = t.requires.filter(function (r) { return DATA.lessons[r]; });
    var also = (t.or_after || []).filter(function (r) { return DATA.lessons[r]; });
    var unlocked = reqs.every(function (r) { return complete[r]; }) || also.some(function (r) { return complete[r]; }) || assigned[L.id] || pct > 0;
    var state = complete[L.id] ? 'complete' : pct > 0 ? 'progress' : unlocked ? 'open' : 'locked';
    nodes.push({ id: L.id, number: L.number, title: L.title, unit: L.unit, x: t.pos[0], y: t.pos[1], requires: reqs,
                 requires_titles: reqs.filter(function (r) { return !complete[r]; }).map(function (r) { return DATA.lessons[r].title; }),
                 or_titles: also.map(function (r) { return DATA.lessons[r].title; }),
                 state: state, pct: pct, stars: lessonStars_(L, p), assigned: !!assigned[L.id], xp_possible: L.possible_xp });
  });
  if (!current) {
    var open = nodes.filter(function (n) { return n.state === 'open'; })[0];
    current = open ? open.id : (nodes.length ? nodes[nodes.length - 1].id : null);
  }
  return { nodes: nodes, current: current, units: DATA.units };
}

// ---------------------------------------------------------------- avatars
function avatarOf_(rec) {
  var a = JSON.parse(JSON.stringify(DATA.default_avatar));
  if (rec && rec.avatar) Object.keys(a).forEach(function (k) { if (rec.avatar[k] !== undefined) a[k] = rec.avatar[k]; });
  return a;
}
function unlockText_(u) {
  if (!u) return '';
  return u[0] === 'level' ? 'Reach level ' + u[1] : 'Earn the ' + badgeById_(u[1]).name + ' badge';
}
function isUnlocked_(u, level, badges) {
  if (!u) return true;
  return u[0] === 'level' ? level >= u[1] : !!badges[u[1]];
}
function avatarCatalog_(rec, teacher) {
  var level = levelInfo_((rec && rec.xp) || 0).level, badges = (rec && rec.badges) || {}, out = {};
  Object.keys(DATA.avatar_options).forEach(function (part) {
    out[part] = DATA.avatar_options[part].map(function (o) {
      return { id: o[0], label: o[1], unlocked: teacher || isUnlocked_(o[2], level, badges), how: unlockText_(o[2]) };
    });
  });
  return out;
}
function cleanAvatar_(rec, data, teacher) {
  var level = levelInfo_(rec.xp || 0).level, out = {};
  var parts = Object.keys(DATA.avatar_options);
  for (var i = 0; i < parts.length; i++) {
    var part = parts[i], choice = data[part] === undefined ? DATA.default_avatar[part] : data[part];
    var match = DATA.avatar_options[part].filter(function (o) { return o[0] === choice; })[0];
    if (!match) return { error: 'Unknown ' + part };
    if (!teacher && !isUnlocked_(match[2], level, rec.badges || {})) return { error: match[1] + ' is still locked: ' + unlockText_(match[2]) + '.' };
    out[part] = choice;
  }
  var name = String(data.name || '').trim();
  if (!/^[A-Za-z0-9 .\-_!']{0,20}$/.test(name)) return { error: 'Robot names can be up to 20 letters, numbers and spaces.' };
  out.name = name;
  return { avatar: out };
}

// ---------------------------------------------------------------- student API
// The browser's lesson code calls the same paths as the Flask site (/api/lessons/<id>/save ...).
// client/shim.js turns those fetch() calls into google.script.run.api(path, body).

function text_(v) {
  if (typeof v !== 'string') throw new Error('Bad request');
  return v.slice(0, MAX_TEXT);
}

function newProgress_() {
  return { sections: {}, circuit_steps: [], started_at: now_(), updated_at: now_() };
}

function mark_(p, key, done) { p.sections = p.sections || {}; p.sections[key] = done === undefined ? true : !!done; }

/** Every student request: who they are, their record, the teacher's settings. */
function student_() {
  var me = whoIs_();
  if (!me.email) throw new Error('Sign in with your school Google account.');
  var rec = loadStudent_(me.email);
  if (!rec) throw new Error('Join your class first: open Maker Lab and enter your class code.');
  return { me: me, rec: rec, cfg: config_() };
}

function finish_(ctx, L, p, extra) {
  var pct = percent_(p, L);
  if (pct === 100 && !p.completed_at) p.completed_at = now_();
  p.updated_at = now_();
  var rewards = syncRewards_(ctx.rec, ctx.cfg);
  saveStudent_(ctx.rec);
  var out = { ok: true, sections: p.sections, percent: pct, rewards: rewards,
              lesson_xp: lessonXp_(ctx.rec, L.id), stars: lessonStars_(L, p) };
  Object.keys(extra || {}).forEach(function (k) { out[k] = extra[k]; });
  return out;
}

function failing_(results) {
  return results.filter(function (r) { return !r.ok && r.message; }).map(function (r) { return r.message; }).slice(0, 1);
}

/** One entry point for the lesson page. Returns {status, body} like an HTTP response. */
function api(path, bodyJson) {
  try {
    var body = bodyJson ? JSON.parse(bodyJson) : {};
    var m = /^\/api\/lessons\/([\w-]+)\/(save|sent|practice|debug|quiz|challenge|partner|learn-check)$/.exec(path);
    if (path === '/api/avatar') return apiAvatar_(body);
    if (!m) return { status: 404, body: { error: 'Not found' } };
    var L = DATA.lessons[m[1]];
    if (!L) return { status: 404, body: { error: 'No such lesson' } };
    if (m[2] === 'partner') return { status: 200, body: { status: 'none', classmates: [] } };   // partners come later
    if (m[2] === 'learn-check' && whoIs_().teacher) {      // the teacher can try the checks; nothing is saved
      var g = gradeLearnCheck_(L, body.card, body.choice);
      return g ? { status: 200, body: { ok: true, check: g } } : { status: 400, body: { ok: false, error: 'No such check' } };
    }
    var ctx = student_();
    var p = ctx.rec.progress[L.id] || (ctx.rec.progress[L.id] = newProgress_());
    return { status: 200, body: API_[m[2].replace('-', '_')](ctx, L, p, body) };
  } catch (e) {
    if (e && e.status) return { status: e.status, body: { ok: false, error: e.message } };
    return { status: 400, body: { ok: false, error: (e && e.message) || 'Something went wrong.' } };
  }
}

function badRequest_(msg) { var e = new Error(msg); e.status = 400; return e; }

/** A Learn card's quick check, graded here so the answers never reach the browser. Null if there's no check. */
function gradeLearnCheck_(L, card, choice) {
  var ck = (L.learn_checks || [])[card];
  if (typeof card !== 'number' || !ck) return null;
  var correct = choice === ck.answer;
  return { correct: correct, why: correct ? ck.why : '', hint: correct ? '' : ck.hint };
}

var API_ = {
  learn_check: function (ctx, L, p, d) {
    var g = gradeLearnCheck_(L, d.card, d.choice);
    if (!g) throw badRequest_('No such check');
    p.learn_checks = p.learn_checks || {};
    var row = p.learn_checks[String(d.card)] || { tries: 0, ok: false };
    if (!row.ok) {
      row.tries++;
      row.ok = g.correct;
      if (g.correct) row.pick = d.choice;
    }
    p.learn_checks[String(d.card)] = row;
    return finish_(ctx, L, p, { check: g, learn_checks: p.learn_checks });
  },
  save: function (ctx, L, p, d) {
    ['code', 'practice_code', 'debug_code', 'challenge_code', 'challenge_response', 'debug_reflection'].forEach(function (f) {
      if (d[f] !== undefined) p[f] = text_(d[f]);
    });
    if (d.warmup_answer !== undefined) {
      p.warmup_answer = text_(d.warmup_answer);
      mark_(p, 'warmup', p.warmup_answer.trim().length >= 3);
    }
    if (typeof d.debug_hints_used === 'number') p.debug_hints_used = Math.max(p.debug_hints_used || 0, Math.min(d.debug_hints_used, 10));
    if (d.circuit_steps !== undefined && L.stepped_count) {
      var seen = {};
      p.circuit_steps = (d.circuit_steps || []).filter(function (i) {
        var ok = typeof i === 'number' && i === Math.floor(i) && i >= 0 && i < L.stepped_count && !seen[i];
        seen[i] = 1; return ok;
      }).sort(function (a, b) { return a - b; });
      mark_(p, L.stepped_key, p.circuit_steps.length === L.stepped_count);
    }
    ['learn', 'code'].forEach(function (k) { if (d.mark && d.mark[k] !== undefined) mark_(p, k, d.mark[k]); });
    return finish_(ctx, L, p);
  },
  sent: function (ctx, L, p, d) {
    p.sends = (p.sends || 0) + 1;
    if (d.section === 'code') mark_(p, 'code');
    return finish_(ctx, L, p);
  },
  practice: function (ctx, L, p, d) {
    if (!L.practice) throw badRequest_('This lesson has no Your turn task.');
    var code = text_(d.code || '');
    p.practice_code = code;
    var results = runChecks_(code, L.practice.checks), solved = results.every(function (r) { return r.ok; });
    if (solved) { p.practice_solved = true; mark_(p, 'practice'); }
    return finish_(ctx, L, p, { solved: solved, messages: failing_(results),
      passed: results.filter(function (r) { return r.ok; }).length, total: results.length });
  },
  debug: function (ctx, L, p, d) {
    if (!L.debug) throw badRequest_('This lesson has no debug task.');
    var code = text_(d.code || '');
    p.debug_code = code;
    p.debug_attempts = (p.debug_attempts || 0) + 1;
    var results = code.trim() === L.debug.buggy_code.trim()
      ? [{ ok: false, message: 'This is still the original broken code. Change something first!' }]
      : runChecks_(code, L.debug.checks);
    var solved = results.every(function (r) { return r.ok; });
    if (solved) { p.debug_solved = true; mark_(p, 'debug'); }
    return finish_(ctx, L, p, { solved: solved, messages: failing_(results),
      passed: results.filter(function (r) { return r.ok; }).length, total: results.length });
  },
  quiz: function (ctx, L, p, d) {
    if (!Array.isArray(d.answers) || d.answers.length !== L.quiz.length) throw badRequest_('Answer every question.');
    var answers = d.answers.map(function (a) { return typeof a === 'number' ? a : null; });
    var graded = gradeQuiz_(L, answers);
    p.quiz_answers = answers;
    p.quiz_score = graded.score;
    p.quiz_total = graded.total;
    p.quiz_best = Math.max(p.quiz_best || 0, graded.score);
    p.quiz_attempts = (p.quiz_attempts || 0) + 1;
    mark_(p, 'quiz');
    return finish_(ctx, L, p, { quiz: graded, best: p.quiz_best });
  },
  challenge: function (ctx, L, p, d) {
    var response = text_(d.response || '').trim();
    if (response.length < 10) throw badRequest_('Tell us a bit more about what you built (at least a sentence).');
    p.challenge_code = text_(d.code || '');
    p.challenge_response = response;
    p.challenge_submitted_at = now_();
    mark_(p, 'challenge');
    return finish_(ctx, L, p, { partner: null });
  },
};

function apiAvatar_(d) {
  var me = whoIs_();
  if (me.teacher) return { status: 200, body: { ok: true, avatar: cleanAvatar_({ xp: 0 }, d, true).avatar, rewards: {} } };
  var ctx = student_();
  var r = cleanAvatar_(ctx.rec, d, false);
  if (r.error) return { status: 400, body: { ok: false, error: r.error } };
  ctx.rec.avatar = r.avatar;
  var rewards = syncRewards_(ctx.rec, ctx.cfg);
  saveStudent_(ctx.rec);
  return { status: 200, body: { ok: true, avatar: r.avatar, rewards: rewards } };
}

// ---------------------------------------------------------------- joining a class
function joinClass(code, name) {
  var me = whoIs_();
  if (!me.email) throw new Error('Sign in with your school Google account.');
  if (me.teacher) throw new Error('You are the teacher. Students join with the class code.');
  code = String(code || '').trim().toUpperCase();
  name = String(name || '').trim().replace(/\s+/g, ' ').slice(0, 40);
  var cfg = config_();
  var cls = Object.keys(cfg.classes).map(function (k) { return cfg.classes[k]; }).filter(function (c) { return c.code === code; })[0];
  if (!cls) throw new Error('That class code was not found. Check it with your teacher.');
  var rec = loadStudent_(me.email) || newStudent_(me.email);
  if (name) rec.name = name;
  if (!rec.name) throw new Error('Type your first name and last initial.');
  if (rec.classes.indexOf(cls.id) < 0) rec.classes.push(cls.id);
  saveStudent_(rec);
  return { ok: true, class_name: cls.name };
}

/** The student finished (or skipped) the micro:bit setup tutorial: stop showing the reminder. */
function markSetupDone(done) {
  var me = whoIs_();
  if (!me.email || me.teacher) return { ok: true };
  var rec = loadStudent_(me.email);
  if (!rec) throw new Error('Join your class first.');
  rec.setup_done = done !== false;
  saveStudent_(rec);
  return { ok: true };
}

// ---------------------------------------------------------------- firmware for .hex downloads
/** Run once from the editor (Run > setup). Makes the data folder and downloads the micro:bit firmware. */
function setup() {
  var folder = dataFolder_();
  studentFolder_();
  var props = PropertiesService.getScriptProperties();
  Object.keys(FIRMWARE).forEach(function (name) {
    var key = 'firmware:' + name;
    if (props.getProperty(key)) {
      try { DriveApp.getFileById(props.getProperty(key)); return; } catch (e) { /* re-download */ }
    }
    if (firmwareFromFolder_(name)) return;          // uploaded by hand
    var text;
    try { text = UrlFetchApp.fetch(FIRMWARE[name]).getContentText(); } catch (e) {
      throw new Error('Could not download the ' + name + ' firmware (' + e.message + '). Upload firmware-' + name +
        '.hex to the "' + DATA_FOLDER + '" folder in Drive instead, then run setup again.');
    }
    if (text.charAt(0) !== ':' || text.length < 100000) throw new Error('The ' + name + ' firmware download did not look like a .hex file.');
    props.setProperty(key, folder.createFile('firmware-' + name + '.hex', text, 'text/plain').getId());
  });
  if (!readNamed_('config', null)) saveConfig_(emptyConfig_());
  return 'Set up: data folder "' + DATA_FOLDER + '" and the micro:bit firmware are ready.';
}

/** A firmware-v1.hex / firmware-v2.hex file the teacher uploaded to the data folder. */
function firmwareFromFolder_(name) {
  var it = dataFolder_().getFilesByName('firmware-' + name + '.hex');
  if (!it.hasNext()) return null;
  var id = it.next().getId();
  PropertiesService.getScriptProperties().setProperty('firmware:' + name, id);
  return id;
}

function firmwareText_(name) {
  var id = PropertiesService.getScriptProperties().getProperty('firmware:' + name) || firmwareFromFolder_(name);
  if (!id) throw new Error('The micro:bit firmware is not set up yet. Ask your teacher to run setup.');
  return DriveApp.getFileById(id).getBlob().getDataAsString();
}
function firmwareInfo(name) {
  return { parts: Math.ceil(firmwareText_(name).length / FIRMWARE_PART) };
}
function firmwarePart(name, i) {
  return firmwareText_(name).substr(i * FIRMWARE_PART, FIRMWARE_PART);
}

// ---------------------------------------------------------------- teacher
// Only the script owner can call these. They change config.json, never a student's file,
// so a teacher and a student saving at the same moment can't overwrite each other.

function teacher_() {
  var me = whoIs_();
  if (!me.teacher) { var e = new Error('Only the teacher can do that.'); e.status = 403; throw e; }
  return config_();
}

function joinCode_(cfg) {
  var abc = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789', used = {};
  Object.keys(cfg.classes).forEach(function (k) { used[cfg.classes[k].code] = 1; });
  for (;;) {
    var code = '';
    for (var i = 0; i < 6; i++) code += abc.charAt(Math.floor(Math.random() * abc.length));
    if (!used[code]) return code;
  }
}

function dateOrEmpty_(s) {
  s = String(s || '');
  return /^\d{4}-\d{2}-\d{2}$/.test(s) ? s : '';
}

function createClass(name) {
  var cfg = teacher_();
  name = String(name || '').trim().slice(0, 80);
  if (!name) throw new Error('Give the class a name.');
  var id = String(nextId_(cfg));
  cfg.classes[id] = { id: id, name: name, code: joinCode_(cfg), created_at: now_() };
  saveConfig_(cfg);
  return cfg.classes[id];
}

function deleteClass(cid, typedName) {
  var cfg = teacher_(), c = cfg.classes[cid];
  if (!c) throw new Error('No such class.');
  if (typedName !== c.name) throw new Error('Type the class name exactly to delete it.');
  delete cfg.classes[cid];
  if (cfg.rosters) delete cfg.rosters[cid];
  cfg.assignments = cfg.assignments.filter(function (a) { return a.class_id !== cid; });
  saveConfig_(cfg);
  return { ok: true };
}

function assignLessons(cid, lessonIds, due, note) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  var have = {};
  cfg.assignments.forEach(function (a) { if (a.class_id === cid) have[a.lesson_id] = 1; });
  var added = 0;
  (lessonIds || []).forEach(function (lid) {
    if (!DATA.lessons[lid] || have[lid]) return;
    cfg.assignments.push({ id: String(nextId_(cfg)), class_id: cid, lesson_id: lid, due: dateOrEmpty_(due),
                           note: String(note || '').slice(0, 500), branch: null, created_at: now_() });
    added++;
  });
  saveConfig_(cfg);
  return { added: added };
}

/** The Sprint trunk, then one branch or a choice of all three (choice branches only count once started). */
function assignSprint(cid, choice, due, note) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  if (choice !== 'choice' && !DATA.sprint.branches[choice]) throw new Error('Pick a branch.');
  if (!dateOrEmpty_(due)) throw new Error('Pick a due date for the Sprint.');
  var wanted = DATA.sprint.trunk.map(function (l) { return [l, null]; });
  if (choice === 'choice') Object.keys(DATA.sprint.branches).forEach(function (b) { DATA.sprint.branches[b].forEach(function (l) { wanted.push([l, b]); }); });
  else DATA.sprint.branches[choice].forEach(function (l) { wanted.push([l, null]); });
  var existing = {};
  cfg.assignments.forEach(function (a) { if (a.class_id === cid) existing[a.lesson_id] = a; });
  var added = 0;
  wanted.forEach(function (w) {
    if (!DATA.lessons[w[0]]) return;
    if (existing[w[0]]) { existing[w[0]].due = due; existing[w[0]].branch = w[1]; return; }
    cfg.assignments.push({ id: String(nextId_(cfg)), class_id: cid, lesson_id: w[0], due: due,
                           note: String(note || '').slice(0, 500), branch: w[1], created_at: now_() });
    added++;
  });
  saveConfig_(cfg);
  return { added: added };
}

function updateAssignment(aid, due, note, remove) {
  var cfg = teacher_();
  var a = cfg.assignments.filter(function (x) { return x.id === aid; })[0];
  if (!a) throw new Error('No such assignment.');
  if (remove) cfg.assignments = cfg.assignments.filter(function (x) { return x.id !== aid; });
  else { a.due = dateOrEmpty_(due); a.note = String(note || '').slice(0, 500); }
  saveConfig_(cfg);
  return { ok: true };
}

function removeStudent(cid, email) {
  var cfg = teacher_();
  cfg.removed[cid] = cfg.removed[cid] || [];
  if (cfg.removed[cid].indexOf(email) < 0) cfg.removed[cid].push(email);
  saveConfig_(cfg);
  return { ok: true };
}

function saveFeedback(email, lid, text) {
  var cfg = teacher_();
  cfg.feedback[email] = cfg.feedback[email] || {};
  cfg.feedback[email][lid] = String(text || '').trim().slice(0, 5000);
  saveConfig_(cfg);
  return { ok: true };
}

function giveBonus(email, amount, reason, badge) {
  var cfg = teacher_();
  amount = Math.max(0, Math.min(Math.floor(Number(amount) || 0), 200));
  reason = String(reason || '').trim().slice(0, 120) || 'Great work';
  if (amount) {
    cfg.bonuses[email] = cfg.bonuses[email] || [];
    cfg.bonuses[email].push({ key: 'bonus:' + now_(), amount: amount, reason: 'Bonus from your teacher: ' + reason, at: now_() });
  }
  if (badge) cfg.picks[email] = true;
  saveConfig_(cfg);
  return { ok: true, xp: amount };
}

/** Hide the Learn cards for a class when the teacher teaches that part live. */
function setSkipLearn(cid, skip) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  cfg.classes[cid].skip_learn = !!skip;
  saveConfig_(cfg);
  return { ok: true, skip_learn: !!skip };
}

function saveVideos(map) {
  var cfg = teacher_(), out = {};
  Object.keys(map || {}).forEach(function (lid) {
    var url = String(map[lid] || '').trim();
    if (DATA.lessons[lid] && /^https:\/\//.test(url)) out[lid] = url.slice(0, 500);
  });
  cfg.videos = out;
  saveConfig_(cfg);
  return { ok: true, count: Object.keys(out).length };
}

// ---------------------------------------------------------------- gradebook
/** Everyone in a class: students who joined with the code, plus the Google Classroom roster (even before they sign in). */
function classStudents_(cfg, sum, cid) {
  var removed = cfg.removed[cid] || [], roster = rosterOf_(cfg, cid), emails = {};
  Object.keys(sum.students).forEach(function (email) { if (sum.students[email].classes.indexOf(cid) >= 0) emails[email] = 1; });
  Object.keys(roster).forEach(function (email) { emails[email] = 1; });
  return Object.keys(emails).filter(function (email) { return removed.indexOf(email) < 0; }).map(function (email) {
    var s = sum.students[email];
    if (!s) return { email: email, name: roster[email] || email, xp: 0, level: 1, avatar: null, badges: [], lessons: {}, not_yet: true };
    return { email: email, name: roster[email] || s.name || email, xp: s.xp, level: levelInfo_(s.xp).level, avatar: s.avatar || null,
             badges: s.badges, lessons: s.lessons, rostered: email in roster };
  }).sort(function (a, b) { return a.name.toLowerCase().localeCompare(b.name.toLowerCase()); });
}

function owesAssignment_(a, started) {
  return !a.branch || (DATA.sprint.branches[a.branch] || []).some(function (l) { return started[l]; });
}

function gradebookCell_(a, s) {
  var started = {};
  Object.keys(s.lessons).forEach(function (l) { started[l] = 1; });
  if (!owesAssignment_(a, started)) return { status: 'other-branch', pct: 0, late: false };
  var x = s.lessons[a.lesson_id];
  var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
  var status = !x ? 'not-started' : x.pct === 100 ? 'complete' : 'in-progress';
  return { status: status, pct: x ? x.pct : 0, quiz_best: x ? x.quiz_best : null, quiz_total: x ? x.quiz_total : 0,
           debug_solved: !!(x && x.debug_solved), challenge: !!(x && x.challenge), stars: x ? x.stars : 0,
           late: !!(a.due && a.due < today && status !== 'complete') };
}

function teacherHome() {
  var cfg = teacher_(), sum = summary_();
  return { classes: Object.keys(cfg.classes).map(function (cid) {
    var c = cfg.classes[cid];
    return { id: c.id, name: c.name, code: c.code, students: classStudents_(cfg, sum, cid).length, classroom: c.classroom || null,
             assignments: cfg.assignments.filter(function (a) { return a.class_id === cid; }).length };
  }) };
}

function gradebook(cid) {
  var cfg = teacher_(), c = cfg.classes[cid];
  if (!c) throw new Error('No such class.');
  var sum = summary_(), students = classStudents_(cfg, sum, cid);
  var cols = cfg.assignments.filter(function (a) { return a.class_id === cid && DATA.lessons[a.lesson_id]; }).map(function (a) {
    var L = DATA.lessons[a.lesson_id];
    return { id: a.id, lesson_id: L.id, number: L.number, title: L.title, due: a.due, note: a.note, branch: a.branch };
  });
  var grid = {};
  students.forEach(function (s) { cols.forEach(function (a) { grid[s.email + '|' + a.id] = gradebookCell_(a, s); }); });
  return { cls: c, cols: cols, students: students.map(function (s) {
             return { email: s.email, name: s.name, xp: s.xp, level: s.level, avatar: s.avatar, not_yet: !!s.not_yet };
           }), grid: grid,
           assigned: cols.map(function (a) { return a.lesson_id; }), url: ScriptApp.getService().getUrl() };
}

function studentDetail(cid, email) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  var rec = loadStudentFresh_(email);
  if (!rec && rosterOf_(cfg, cid)[email]) rec = newStudent_(email), rec.name = rosterOf_(cfg, cid)[email];
  if (!rec) throw new Error('No work saved for that student yet.');
  var assigned = {};
  cfg.assignments.forEach(function (a) { if (a.class_id === cid) assigned[a.lesson_id] = 1; });
  var items = lessonList_().filter(function (L) { return rec.progress[L.id] || assigned[L.id]; }).map(function (L) {
    var p = rec.progress[L.id] || null;
    return { id: L.id, number: L.number, title: L.title, assigned: !!assigned[L.id], pct: p ? percent_(p, L) : 0, p: p,
             feedback: ((cfg.feedback[email] || {})[L.id]) || '', stepped_count: L.stepped_count, has_debug: L.has_debug,
             learn_titles: (L.learn_checks || []).some(function (c) { return c; }) ? L.learn_titles : [] };
  });
  return { cls: cfg.classes[cid], student: { email: email, name: rec.name, xp: rec.xp || 0, level: levelInfo_(rec.xp || 0),
           avatar: avatarOf_(rec), badges: badgeList_(rec).filter(function (b) { return b.earned; }) }, items: items };
}

/** The teacher always reads a student's file from Drive, not a cached copy. */
function loadStudentFresh_(email) {
  var id = studentFileId_(email);
  if (!id) return null;
  try { return readJsonFile_(id); } catch (e) { return null; }
}

// ---------------------------------------------------------------- Google Classroom grades package
// Paste the result into the "Maker Lab to Google Classroom" sender (maker-lab-classroom.gs).
function classroomPackage(cid, how, lessonIds) {
  if (['complete', 'quiz', 'both'].indexOf(how) < 0) throw new Error('Pick how to score.');
  var gb = gradebook(cid), wanted = {};
  (lessonIds || []).forEach(function (l) { wanted[l] = 1; });
  var cols = gb.cols.filter(function (a) { return wanted[a.lesson_id]; });
  var students = gb.students.map(function (s, i) {
    var grades = {};
    cols.forEach(function (a) {
      var cell = gb.grid[s.email + '|' + a.id], score = null;
      if (cell && cell.status !== 'not-started' && cell.status !== 'other-branch') {
        var quiz = cell.quiz_total ? Math.round(100 * (cell.quiz_best || 0) / cell.quiz_total) : null;
        score = how === 'complete' ? cell.pct : how === 'quiz' ? quiz : (quiz === null ? null : Math.round((cell.pct + quiz) / 2));
      }
      if (score !== null) grades[a.lesson_id] = score;
    });
    return { ref: s.email, name: s.name, grades: grades };
  });
  return { source: 'microbit-maker-lab', version: 1, 'class': gb.cls.name, students: students,
           assignments: cols.map(function (a) { return { key: a.lesson_id, title: a.number + '. ' + a.title, due: a.due || '' }; }) };
}

// ---------------------------------------------------------------- class display (projector)
// Same data as the Flask site's /teacher/classes/<id>/screen/data, read by app/static/js/screen.js.
var WIN_ICONS_ = { badge: '🏅', complete: '🏁', quiz_perfect: '🧠', bonus: '🍎' };

function winText_(name, w) {
  var r = w.reason || '', detail = r.indexOf(' · ') >= 0 ? r.slice(r.indexOf(' · ') + 3) : r;
  if (w.kind === 'badge') return name + ' earned the ' + r.replace('Badge: ', '') + ' badge';
  if (w.kind === 'complete') return name + ' finished ' + detail;
  if (w.kind === 'quiz_perfect') return name + ' got a perfect quiz in ' + detail;
  return name + ' got a bonus from the teacher';
}

/** First names for the projector, with a last initial when two students share one (or robot names). */
function shownNames_(students, mode) {
  var first = function (s) { return (String(s.name || '').trim().split(/\s+/)[0]) || 'Student'; }, count = {}, out = {};
  students.forEach(function (s) { count[first(s)] = (count[first(s)] || 0) + 1; });
  students.forEach(function (s) {
    var parts = String(s.name || '').trim().split(/\s+/), n = first(s);
    if (count[n] > 1 && parts.length > 1) n += ' ' + parts[1].charAt(0) + '.';
    if (mode === 'robot' && s.avatar && s.avatar.name) n = s.avatar.name;
    out[s.email] = n;
  });
  return out;
}

var STOP_ICONS_ = { warmup: '✏️', learn: '📖', circuit: '🔌', lab: '🧪', code: '💻', practice: '🧩', debug: '🐞', quiz: '❓', challenge: '🚀' };

function whereIs_(s) {
  var ids = Object.keys(s.lessons || {}).filter(function (l) { return DATA.lessons[l]; })
    .sort(function (a, b) { return String(s.lessons[b].updated_at || '').localeCompare(String(s.lessons[a].updated_at || '')); });
  for (var i = 0; i < ids.length; i++) {
    var x = s.lessons[ids[i]], L = DATA.lessons[ids[i]];
    if (x.pct < 100) return { where: L.number + '. ' + L.title, pct: x.pct, status: 'working', lesson_id: L.id };
  }
  if (ids.length) { var D = DATA.lessons[ids[0]]; return { where: '✓ ' + D.number + '. ' + D.title, pct: 100, status: 'done', lesson_id: D.id }; }
  return { where: 'Not started', pct: 0, status: 'waiting', lesson_id: null };
}

/** Race-track stops for a lesson: one per section, named like its agenda. */
function trackStops_(L) {
  return L.section_keys.map(function (k) {
    return { key: k, name: (L.agenda_names || {})[k] || k.charAt(0).toUpperCase() + k.slice(1), icon: STOP_ICONS_[k] || '⭐' };
  });
}

/** Standards from the lessons students are on right now, most students first (the focus lesson if nobody is). */
function standardsInPlay_(counts, focusId) {
  var c = Object.keys(counts).length ? counts : (function () { var o = {}; o[focusId] = 0; return o; })(), out = {}, order = [];
  Object.keys(c).sort(function (a, b) { return c[b] - c[a]; }).forEach(function (lid) {
    var L = DATA.lessons[lid];
    (L.standards || []).forEach(function (st) {
      if (!out[st.code]) { out[st.code] = { code: st.code, text: st.text, students: 0, lessons: [] }; order.push(st.code); }
      out[st.code].students += c[lid];
      out[st.code].lessons.push(L.number + '. ' + L.title);
    });
  });
  return order.map(function (k) { return out[k]; }).sort(function (a, b) { return b.students - a.students; }).slice(0, 4);
}

function screenPayload_(cfg, cid) {
  var c = cfg.classes[cid], saved = c.screen || {};
  var settings = { lesson_id: saved.lesson_id || '', question: saved.question || '', names: saved.names || 'first',
                   xp: saved.xp || 'each', bell: saved.bell || '', view: saved.view === 'cards' ? 'cards' : 'track' };
  var sum = summary_(), students = classStudents_(cfg, sum, cid), names = shownNames_(students, settings.names), wins = [];
  var wheres = {}, working = {};
  students.forEach(function (s) {
    var w = wheres[s.email] = whereIs_(s);
    if (w.status === 'working') working[w.lesson_id] = (working[w.lesson_id] || 0) + 1;
  });
  var L = DATA.lessons[settings.lesson_id];
  if (!L && Object.keys(working).length) {        // default: the lesson most students are on right now
    L = DATA.lessons[Object.keys(working).sort().reduce(function (best, lid) { return working[lid] > working[best] ? lid : best; })];
  }
  if (!L) {                                         // ...or the next assignment due
    var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
    var mine = cfg.assignments.filter(function (a) { return a.class_id === cid && DATA.lessons[a.lesson_id]; })
      .sort(function (a, b) { return (a.due || '9999') < (b.due || '9999') ? -1 : (a.due || '9999') > (b.due || '9999') ? 1 : 0; });
    var next = mine.filter(function (a) { return !a.due || a.due >= today; })[0] || mine[0];
    L = next ? DATA.lessons[next.lesson_id] : DATA.lessons[DATA.order[0]];
  }
  var rows = students.map(function (s) {
    var w = wheres[s.email], here = (s.lessons || {})[L.id];
    var row = { name: names[s.email], avatar: s.avatar || null, level: s.level, where: w.where, pct: w.pct, status: w.status,
                // race track: sections done in today's lesson (null = busy with a different lesson, or not started)
                done: here ? Math.round(here.pct * L.section_keys.length / 100) : null };
    if (!here && w.status === 'working') row.elsewhere = w.where;
    if (settings.xp === 'each') row.xp = s.xp || 0;      // hidden XP never reaches the browser
    ((sum.students[s.email] || {}).wins || []).forEach(function (x) {
      wins.push({ icon: WIN_ICONS_[x.kind] || '⭐', text: winText_(names[s.email], x), at: x.at });
    });
    return row;
  }).sort(function (a, b) { return a.name.toLowerCase().localeCompare(b.name.toLowerCase()); });
  var since = new Date(Date.now() - 12 * 3600 * 1000).toISOString();
  wins = wins.filter(function (w) { return w.at >= since; }).sort(function (a, b) { return String(b.at).localeCompare(String(a.at)); }).slice(0, 8);
  return { settings: settings, students: rows, wins: wins,
           total_xp: settings.xp === 'hide' ? 0 : students.reduce(function (t, s) { return t + (s.xp || 0); }, 0),
           lesson: { id: L.id, number: L.number, title: L.title }, auto_lesson: !DATA.lessons[settings.lesson_id],
           track: trackStops_(L), question: settings.question || L.essential_question || '', big_idea: L.big_idea || '',
           standards: standardsInPlay_(working, L.id) };
}

function screenData(cid) {
  var cfg = teacher_();
  if (!cfg.classes[cid]) throw new Error('No such class.');
  return screenPayload_(cfg, cid);
}

function screenSave(cid, d) {
  var cfg = teacher_(), c = cfg.classes[cid];
  if (!c) throw new Error('No such class.');
  d = d || {};
  c.screen = { lesson_id: DATA.lessons[d.lesson_id] ? d.lesson_id : '', question: String(d.question || '').trim().slice(0, 300),
               names: d.names === 'robot' ? 'robot' : 'first', view: d.view === 'cards' ? 'cards' : 'track',
               xp: ['each', 'total', 'hide'].indexOf(d.xp) >= 0 ? d.xp : 'each',
               bell: /^\d{1,2}:\d{2}$/.test(String(d.bell || '')) ? d.bell : '' };
  saveConfig_(cfg);
  return screenPayload_(cfg, cid);
}

function screenUnits_() {
  return catalogUnits_().map(function (u) {
    return { title: 'Unit ' + u.number + ': ' + u.title, lessons: u.lessons.map(function (l) { return { id: l.id, number: l.number, title: l.title }; }) };
  });
}

// ---------------------------------------------------------------- Google Classroom: import classes and rosters
// Uses the Google Classroom advanced service (appsscript.json "dependencies"), read-only, as the teacher.
// A linked class keeps its roster in config.json (cfg.rosters[cid] = { email: name }), so students on it
// are in the class the first time they open Maker Lab: no join code, and their Classroom name is used.

function classroomApi_() {
  if (typeof Classroom === 'undefined' || !Classroom.Courses) {
    throw new Error('The Google Classroom service is not turned on. Replace appsscript.json with the one in INSTALL.md, ' +
      'save, then run checkInstall once to allow access.');
  }
  return Classroom;
}

function classroomCoursesRaw_() {
  var api = classroomApi_(), out = [], token = null;
  do {
    var r = api.Courses.list({ teacherId: 'me', courseStates: ['ACTIVE'], pageSize: 100, pageToken: token || undefined });
    (r.courses || []).forEach(function (c) { out.push(c); });
    token = r.nextPageToken;
  } while (token);
  return out;
}

/** { students: { email: name }, missing: number of students whose email Classroom didn't share } */
function classroomRoster_(courseId) {
  var api = classroomApi_(), students = {}, missing = 0, token = null;
  do {
    var r = api.Courses.Students.list(courseId, { pageSize: 100, pageToken: token || undefined });
    (r.students || []).forEach(function (s) {
      var p = s.profile || {}, email = String(p.emailAddress || '').trim().toLowerCase();
      var name = String((p.name && (p.name.fullName || [p.name.givenName, p.name.familyName].join(' '))) || '').trim();
      if (email) students[email] = name.slice(0, 40) || email;
      else missing++;
    });
    token = r.nextPageToken;
  } while (token);
  return { students: students, missing: missing };
}

function rosterOf_(cfg, cid) { return (cfg.rosters || {})[cid] || {}; }

/** The import page: your active Classroom courses and which Maker Lab class each is linked to. */
function classroomCourses() {
  var cfg = teacher_(), linked = {};
  Object.keys(cfg.classes).forEach(function (cid) {
    var g = cfg.classes[cid].classroom;
    if (g) linked[g.id] = cid;
  });
  var courses = classroomCoursesRaw_().map(function (c) {
    return { id: c.id, name: c.name || 'Untitled class', section: c.section || '', link: c.alternateLink || '', linked: linked[c.id] || null };
  });
  return { courses: courses, classes: Object.keys(cfg.classes).map(function (cid) { return { id: cid, name: cfg.classes[cid].name }; }) };
}

/** choices: [{ course_id, target: 'new' | a class id }]. Makes or links each class, then copies its roster. */
function importClassroom(choices) {
  var cfg = teacher_(), byId = {}, results = [];
  classroomCoursesRaw_().forEach(function (c) { byId[c.id] = c; });
  (choices || []).forEach(function (ch) {
    var c = byId[ch && ch.course_id];
    if (!c) return;
    var cid = ch.target === 'new' ? null : String(ch.target || '');
    if (cid && !cfg.classes[cid]) return;
    Object.keys(cfg.classes).forEach(function (k) {   // a course links to one class at a time
      var g = cfg.classes[k].classroom;
      if (g && g.id === c.id && k !== cid) { delete cfg.classes[k].classroom; delete cfg.rosters[k]; }
    });
    if (!cid) {
      cid = String(nextId_(cfg));
      var name = (c.name + (c.section ? ' (' + c.section + ')' : '')).slice(0, 80);
      cfg.classes[cid] = { id: cid, name: name, code: joinCode_(cfg), created_at: now_() };
    }
    cfg.classes[cid].classroom = { id: c.id, name: c.name || '', section: c.section || '', link: c.alternateLink || '' };
    results.push(syncInto_(cfg, cid));
  });
  saveConfig_(cfg);
  return { classes: results };
}

function syncInto_(cfg, cid) {
  var cls = cfg.classes[cid], before = rosterOf_(cfg, cid), r = classroomRoster_(cls.classroom.id);
  cfg.rosters = cfg.rosters || {};
  cfg.rosters[cid] = r.students;
  cls.classroom.synced_at = now_();
  cls.classroom.missing = r.missing;
  var added = Object.keys(r.students).filter(function (e) { return !(e in before); }).length;
  var left = Object.keys(before).filter(function (e) { return !(e in r.students); }).length;
  return { id: cid, name: cls.name, students: Object.keys(r.students).length, added: added, left: left, missing: r.missing };
}

/** Copies the class's roster from Google Classroom again (new students in, students who left out). */
function syncClassroom(cid) {
  var cfg = teacher_(), cls = cfg.classes[cid];
  if (!cls) throw new Error('No such class.');
  if (!cls.classroom) throw new Error('This class is not linked to Google Classroom.');
  var out = syncInto_(cfg, cid);
  saveConfig_(cfg);
  return out;
}

/** Re-copies every linked class's roster. */
function syncAllClassroom() {
  var cfg = teacher_(), out = [];
  Object.keys(cfg.classes).forEach(function (cid) {
    if (!cfg.classes[cid].classroom) return;
    try { out.push(syncInto_(cfg, cid)); } catch (e) { out.push({ id: cid, name: cfg.classes[cid].name, error: e.message }); }
  });
  saveConfig_(cfg);
  return { classes: out };
}

function unlinkClassroom(cid) {
  var cfg = teacher_(), cls = cfg.classes[cid];
  if (!cls) throw new Error('No such class.');
  delete cls.classroom;
  if (cfg.rosters) delete cfg.rosters[cid];
  saveConfig_(cfg);
  return { ok: true };
}

/** The Classroom name for a student, if any linked class has them on its roster. */
function rosterName_(cfg, email) {
  var rosters = cfg.rosters || {};
  for (var cid in rosters) if (cfg.classes[cid] && rosters[cid][email]) return rosters[cid][email];
  return '';
}

// ---------------------------------------------------------------- pages
/** Lesson pages are stored gzip-compressed (PAGES_GZ, made by the build); unpack one when needed. */
var PAGE_CACHE_ = {};
function page_(id) {
  if (PAGE_CACHE_[id]) return PAGE_CACHE_[id];
  var packed = PAGES_GZ[id];
  if (!packed) return null;
  var blob = Utilities.newBlob(Utilities.base64Decode(packed), 'application/x-gzip');
  return (PAGE_CACHE_[id] = JSON.parse(Utilities.ungzip(blob).getDataAsString('UTF-8')));
}

// Every page is one doGet: ?p=/lessons/blink-external-led mirrors the Flask site's URLs.
// Lesson pages are pre-rendered by the build (PAGES); other pages are drawn in the browser
// by client/pages.js from the data sent here.

function doGet(e) {
  var problems = installProblems_();
  if (problems.length) return plainPage_('Maker Lab needs a fix', '<h1>Maker Lab isn\'t installed correctly yet</h1><ul><li>' +
    problems.map(escapeHtml_).join('</li><li>') + '</li></ul><p>Fix the files above in the Apps Script editor, save, then deploy a ' +
    '<b>new version</b> (Deploy → Manage deployments → ✏️ → Version: New version). The steps are in INSTALL.md.</p>');
  var me = whoIs_();
  var path = String((e && e.parameter && e.parameter.p) || '/');
  var page;
  try {
    if (!me.email) page = { name: 'error', title: 'Sign in', data: { message: 'Open Maker Lab while signed in to your school Google account.' } };
    else page = me.teacher ? teacherPage_(path) : studentPage_(me, path);
  } catch (err) {
    page = { name: 'error', title: 'Problem', data: { message: (err && err.message) || 'Something went wrong.' } };
  }
  return render_(me, page);
}

function studentPage_(me, path) {
  var rec = loadStudent_(me.email), cfg = config_();
  var listed = rosterName_(cfg, me.email);
  if (listed && (!rec || !rec.name)) {          // on a Google Classroom roster: no join page, use the Classroom name
    rec = rec || newStudent_(me.email);
    rec.name = listed;
    saveStudent_(rec);
  }
  if (!rec || !rec.name || !studentClassIds_(rec, cfg).length) return { name: 'join', title: 'Join your class', data: { name: rec ? rec.name : '' } };
  var rewards = syncRewards_(rec, cfg);
  if (rewards.xp_gained) saveStudent_(rec);
  var level = levelInfo_(rec.xp || 0), base = { level: level, avatar: avatarOf_(rec), rewards: rewards, name: rec.name };
  var m;
  if (path === '/' || path === '/dashboard') return { name: 'dashboard', title: 'Dashboard', data: merge_(base, dashboardData_(rec, cfg)) };
  if (path === '/lessons') return { name: 'catalog', title: 'Lessons', data: merge_(base, catalogData_(rec)) };
  if (path === '/map') return { name: 'map', title: 'Maker Map', data: merge_(base, { map: mapData_(rec, assignedIds_(rec, cfg)) }) };
  if (path === '/me') return { name: 'profile', title: 'My robot', data: merge_(base, profileData_(rec)) };
  if (path === '/setup') return { name: 'setup', title: 'micro:bit setup', editor: true, data: merge_(base, { done: !!rec.setup_done }) };
  if (path === '/editor') return { name: 'playground', title: 'Editor', editor: true, html: page_('_playground').html, data: base };
  if ((m = /^\/lessons\/([\w-]+)$/.exec(path)) && PAGES_GZ[m[1]]) return lessonPage_(m[1], rec, cfg, base, false);
  return { name: 'error', title: 'Not found', data: { message: "We couldn't find that page." } };
}

function teacherPage_(path) {
  var cfg = config_(), m, base = { teacher: true };
  if (path === '/' || path === '/teacher') return { name: 'teacher-home', title: 'My classes', data: merge_(base, teacherHome()) };
  if ((m = /^\/teacher\/classes\/(\w+)$/.exec(path))) return { name: 'classroom', title: 'Class', data: merge_(base, merge_(gradebook(m[1]), { units: catalogUnits_() })) };
  if ((m = /^\/teacher\/classes\/(\w+)\/students\/(.+)$/.exec(path))) return { name: 'student', title: 'Student', data: merge_(base, studentDetail(m[1], decodeURIComponent(m[2]))) };
  if (path === '/teacher/google-import') return { name: 'gc-import', title: 'Import from Google Classroom', data: merge_(base, classroomImportData_()) };
  if ((m = /^\/teacher\/classes\/(\w+)\/screen$/.exec(path))) {
    if (!cfg.classes[m[1]]) throw new Error('No such class.');
    return { name: 'screen', title: 'Class display', bodyClass: 'screen-page', mainClass: 'screen-main',
             data: merge_(base, { cls: { id: m[1], name: cfg.classes[m[1]].name }, units: screenUnits_() }) };
  }
  if ((m = /^\/teacher\/classes\/(\w+)\/google-classroom$/.exec(path))) return { name: 'google', title: 'Google Classroom', data: merge_(base, gradebook(m[1])) };
  if (path === '/setup') return { name: 'setup', title: 'micro:bit setup', editor: true, data: merge_(base, { done: true }) };
  if (path === '/teacher/standards') return { name: 'static', title: 'Standards', html: page_('_standards').html, data: base };
  if (path === '/teacher/videos') return { name: 'videos', title: 'Videos', data: merge_(base, { units: catalogUnits_(), urls: cfg.videos }) };
  if (path === '/lessons') return { name: 'catalog', title: 'Lessons', data: merge_(base, catalogData_(null)) };
  if (path === '/map') {
    var map = mapData_(null, {});
    map.nodes.forEach(function (n) { n.state = 'open'; });
    return { name: 'map', title: 'Maker Map', data: merge_(base, { map: map }) };
  }
  if (path === '/editor') return { name: 'playground', title: 'Editor', editor: true, html: page_('_playground').html, data: base };
  if ((m = /^\/lessons\/([\w-]+)$/.exec(path)) && PAGES_GZ[m[1]]) return lessonPage_(m[1], null, cfg, base, true);
  return { name: 'error', title: 'Not found', data: { message: "We couldn't find that page." } };
}

function classroomImportData_() {
  try { return classroomCourses(); } catch (e) { return { courses: [], classes: [], problem: e.message }; }
}

function merge_(a, b) {
  var out = {};
  Object.keys(a).forEach(function (k) { out[k] = a[k]; });
  Object.keys(b).forEach(function (k) { out[k] = b[k]; });
  return out;
}

function catalogUnits_() {
  return Object.keys(DATA.units).map(function (u) {
    return { number: +u, title: DATA.units[u].title, blurb: DATA.units[u].blurb,
             lessons: lessonList_().filter(function (L) { return String(L.unit) === u; }).map(function (L) { return L.card; }) };
  }).filter(function (u) { return u.lessons.length; });
}

function catalogData_(rec) {
  var pct = {};
  if (rec) Object.keys(rec.progress).forEach(function (l) { if (DATA.lessons[l]) pct[l] = percent_(rec.progress[l], DATA.lessons[l]); });
  return { units: catalogUnits_(), pct: pct };
}

function dashboardData_(rec, cfg) {
  var classes = studentClassIds_(rec, cfg), started = {};
  Object.keys(rec.progress).forEach(function (l) { started[l] = 1; });
  var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
  var rows = cfg.assignments.filter(function (a) {
    return classes.indexOf(a.class_id) >= 0 && DATA.lessons[a.lesson_id] && owesAssignment_(a, started);
  }).sort(function (a, b) { return (a.due || '9999') < (b.due || '9999') ? -1 : (a.due || '9999') > (b.due || '9999') ? 1 : 0; })
    .map(function (a) {
      var L = DATA.lessons[a.lesson_id], p = rec.progress[a.lesson_id], pct = p ? percent_(p, L) : 0;
      return { lesson: L.card, class_name: cfg.classes[a.class_id].name, due: a.due, note: a.note, pct: pct,
               overdue: !!(a.due && a.due < today && pct < 100), feedback: !!((cfg.feedback[rec.email] || {})[a.lesson_id]) };
    });
  var recent = Object.keys(rec.progress).filter(function (l) { return DATA.lessons[l]; })
    .sort(function (a, b) { return String(rec.progress[b].updated_at || '').localeCompare(String(rec.progress[a].updated_at || '')); })
    .slice(0, 3).map(function (l) { return { lesson: DATA.lessons[l].card, pct: percent_(rec.progress[l], DATA.lessons[l]) }; });
  var badges = badgeList_(rec).filter(function (b) { return b.earned; })
    .sort(function (a, b) { return String(b.earned_at).localeCompare(String(a.earned_at)); });
  return { rows: rows, recent: recent, badges: badges.slice(0, 6), badge_total: DATA.badges.length, setup_done: !!rec.setup_done,
           classes: classes.map(function (c) { return cfg.classes[c].name; }) };
}

function profileData_(rec) {
  return { badges: badgeList_(rec), history: rec.xp_log || [], catalog: avatarCatalog_(rec, false),
           parts: DATA.avatar_parts, levels: DATA.levels, xp_table: DATA.xp };
}

function lessonState_(L, p, rec, cfg) {
  return {
    sections: (p && p.sections) || {}, circuit_steps: (p && p.circuit_steps) || [],
    warmup_answer: (p && p.warmup_answer) || '',
    code: (p && p.code) || L.starter,
    debug_code: (p && p.debug_code) || L.buggy,
    practice_code: (p && p.practice_code) || L.practice_starter,
    practice_solved: !!(p && p.practice_solved), debug_solved: !!(p && p.debug_solved),
    debug_hints_used: (p && p.debug_hints_used) || 0, debug_reflection: (p && p.debug_reflection) || '',
    quiz_answers: p && p.quiz_answers ? p.quiz_answers : null, quiz_score: p ? p.quiz_score : null, quiz_best: p ? p.quiz_best : null,
    challenge_code: (p && (p.challenge_code || p.code)) || L.starter,
    challenge_response: (p && p.challenge_response) || '', challenge_submitted: !!(p && p.challenge_submitted_at),
    feedback: rec ? ((cfg.feedback[rec.email] || {})[L.id] || '') : '',
    learn_checks: (p && p.learn_checks) || {},
    skip_learn: !!(rec && L.section_keys.indexOf('learn') >= 0 && skipsLearn_(rec, cfg)),
  };
}

/** True when one of the student's classes has the teacher teaching Learn live. */
function skipsLearn_(rec, cfg) {
  return studentClassIds_(rec, cfg).some(function (cid) { return cfg.classes[cid].skip_learn; });
}

function lessonPage_(lid, rec, cfg, base, teacher) {
  var L = DATA.lessons[lid], pg = page_(lid), p = rec ? rec.progress[lid] : null;
  if (rec && L.section_keys.indexOf('learn') >= 0 && skipsLearn_(rec, cfg) && !(p && p.sections && p.sections.learn)) {
    p = rec.progress[lid] || (rec.progress[lid] = newProgress_());     // taught live, so it counts as done
    mark_(p, 'learn', true);
    p.updated_at = now_();
    var got = syncRewards_(rec, cfg);
    saveStudent_(rec);
    if (got.xp_gained) base = merge_(base, { rewards: got, level: got.level });
  }
  var state = lessonState_(L, p, rec, cfg);
  if (p && p.quiz_answers) state.quiz_results = gradeQuiz_(L, p.quiz_answers);
  return { name: 'lesson', title: L.title, editor: true, lesson: true, html: pg.html, mainClass: 'lesson-layout',
           data: merge_(base, { lesson_xp: rec ? lessonXp_(rec, lid) : 0, stars: lessonStars_(L, p), xp_possible: L.possible_xp,
                                video: embedInfo_(cfg.videos[lid]), teacher_key: teacher ? pg.teacher_key : '' }),
           globals: { LESSON: pg.view, STATE: state, SECTION_KEYS: L.section_keys } };
}

/** Same rules as app/videos.py: YouTube, Google Drive, Vimeo, or a direct video file. */
function embedInfo_(url) {
  if (!url || !/^https:\/\//.test(url)) return null;
  var m;
  if ((m = /^https:\/\/(?:www\.|m\.)?(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{6,20})/.exec(url)))
    return { kind: 'iframe', src: 'https://www.youtube-nocookie.com/embed/' + m[1] };
  if ((m = /^https:\/\/drive\.google\.com\/file\/d\/([\w-]+)/.exec(url))) return { kind: 'iframe', src: 'https://drive.google.com/file/d/' + m[1] + '/preview' };
  if ((m = /^https:\/\/(?:www\.)?vimeo\.com\/(\d+)/.exec(url))) return { kind: 'iframe', src: 'https://player.vimeo.com/video/' + m[1] };
  if (/\.(mp4|webm|ogg)(\?|$)/i.test(url)) return { kind: 'video', src: url };
  return { kind: 'link', src: url };
}

// ---------------------------------------------------------------- install check
function escapeHtml_(s) {
  return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; });
}

/** Every pasted Script file must be there, complete (its last line sets its stamp), and from the same build. */
function installProblems_() {
  var out = [], stamps = typeof BUILD_STAMPS === 'undefined' ? {} : BUILD_STAMPS;
  Object.keys(BUILD_EXPECT).forEach(function (key) {
    var got = stamps[key], name = key + '.gs';
    if (!got) out.push(name + ' is missing or was cut short while pasting. Add it as a Script file named "' + key + '" and paste all of it.');
    else if (got !== BUILD_EXPECT[key]) out.push(name + ' is from a different version than Code.gs. Paste the new ' + name + '.');
  });
  return out;
}

/** Run this from the editor (choose checkInstall, press Run) to check everything; the result is in the log. */
function checkInstall() {
  var lines = [], ok = function (good, text) { lines.push((good ? '✅ ' : '❌ ') + text); };
  var problems = installProblems_();
  ok(!problems.length, problems.length ? 'Files: ' + problems.join(' | ') : 'All ' + BUILD_FILES.length + ' files are pasted, complete, and match (Code.gs ' + BUILD_ID + ')');
  try {
    ['styles', 'app', 'editor'].forEach(function (k) { if (asset_(k).length < 1000) throw new Error(k + ' is empty'); });
    ok(true, 'The site\'s styles and code unpack');
  } catch (e) { ok(false, 'Assets.gs: ' + e.message); }
  try { ok(Object.keys(DATA.lessons).length > 0, Object.keys(DATA.lessons).length + ' lessons in Data.gs'); } catch (e) { ok(false, 'Data.gs: ' + e.message); }
  try {
    var n = Object.keys(PAGES_GZ).length, first = page_(DATA.order[0]);
    ok(!!first && first.html.length > 1000, n + ' lesson pages in Pages*.gs, and they unpack');
  } catch (e) { ok(false, 'Pages*.gs: ' + e.message); }
  try { studentFolder_(); ok(true, 'Drive folder "' + DATA_FOLDER + '" is ready'); } catch (e) { ok(false, 'Drive folder: ' + e.message + ' (run setup)'); }
  ['v1', 'v2'].forEach(function (v) {
    try { ok(firmwareInfo(v).parts > 0, 'micro:bit firmware ' + v + ' is saved'); } catch (e) { ok(false, 'firmware ' + v + ': ' + e.message); }
  });
  try { config_(); ok(true, 'Settings file reads'); } catch (e) { ok(false, 'Settings: ' + e.message); }
  try { ok(true, 'Google Classroom: ' + classroomCoursesRaw_().length + ' active classes you teach'); }
  catch (e) { ok(false, 'Google Classroom: ' + e.message); }
  try { ok(ScriptApp.getService().isEnabled(), 'Web app is deployed: ' + ScriptApp.getService().getUrl()); } catch (e) { ok(false, 'Deployment: ' + e.message); }
  var report = lines.join('\n');
  Logger.log(report);
  return report;
}

function plainPage_(title, body) {
  return HtmlService.createHtmlOutput('<!doctype html><html><head><base target="_top"><meta charset="utf-8"></head>' +
    '<body style="font:16px/1.5 system-ui,sans-serif;max-width:760px;margin:24px auto;padding:0 16px;color:#12283f">' + body + '</body></html>')
    .setTitle(title);
}

// ---------------------------------------------------------------- the HTML around every page
/** The site's CSS and JavaScript, stored gzip-compressed in Assets.gs. */
var ASSET_CACHE_ = {};
function asset_(name) {
  if (ASSET_CACHE_[name] !== undefined) return ASSET_CACHE_[name];
  var blob = Utilities.newBlob(Utilities.base64Decode(ASSETS_GZ[name]), 'application/x-gzip');
  return (ASSET_CACHE_[name] = JSON.parse(Utilities.ungzip(blob).getDataAsString('UTF-8')));
}

/** Text as web-safe base64: only letters, digits, - and _, so Apps Script can't mistake any of it for a comment. */
function safe64_(text) {
  return Utilities.base64EncodeWebSafe(Utilities.newBlob(text, 'text/plain').getBytes()).replace(/=+$/, '');
}

// Apps Script strips // and /* comments from <script> blocks, without noticing when they're inside strings.
// So the page gets exactly two tiny scripts written with no slashes at all, and all real code and data
// travel as safe64 text that the loader decodes and runs.
var CRASH_SCRIPT_ = '<script>window.addEventListener("error",function(e){var b=document.getElementById("ml-crash");' +
  'if(!b){b=document.createElement("div");b.id="ml-crash";b.style.cssText="position:fixed;left:8px;right:8px;bottom:8px;' +
  'z-index:9999;background:#fde2e2;color:#7a1010;border:2px solid #b32626;border-radius:10px;padding:10px 14px;' +
  'font:14px system-ui,sans-serif;white-space:pre-wrap";(document.body||document.documentElement).appendChild(b);' +
  'b.textContent="Something went wrong on this page. Please send this to your teacher:"}' +
  'b.textContent+=String.fromCharCode(10)+(e.message||"error")+(e.lineno?" (line "+e.lineno+")":"")});</script>';
var LOADER_SCRIPT_ = '<script>(function(){var t=document.getElementById("ml-code");' +
  'function d(s){var b=atob(s.split("-").join("+").split("_").join(String.fromCharCode(47)));' +
  'var u=new Uint8Array(b.length);for(var i=0;i<b.length;i++){u[i]=b.charCodeAt(i)}return new TextDecoder().decode(u)}' +
  'var parts=t.textContent.split(".");for(var j=0;j<parts.length;j++){if(!parts[j])continue;' +
  'var s=document.createElement("script");s.textContent=d(parts[j]);document.body.appendChild(s)}' +
  'if(window.MLStart){window.MLStart()}})();</script>';

function json_(v) { return JSON.stringify(v).replace(/</g, '\\u003c'); }

// The game-style fonts (the theme falls back to system fonts if Google Fonts is blocked). A <link>, not a
// CSS @import, because Apps Script strips "//" inside <style> blocks.
var FONTS_HTML_ = '<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&family=Titan+One&display=swap">';

function render_(me, page) {
  var nav = me.teacher
    ? [['/lessons', 'Lessons'], ['/map', 'Map'], ['/editor', 'Editor'], ['/', 'My classes'], ['/teacher/standards', 'Standards'], ['/teacher/videos', 'Videos'], ['/setup', 'micro:bit setup']]
    : [['/lessons', 'Lessons'], ['/map', 'Map'], ['/editor', 'Editor'], ['/setup', 'micro:bit setup'], ['/', 'Dashboard']];
  var ml = { base: ScriptApp.getService().getUrl(), page: page.name, teacher: me.teacher, nav: nav, data: page.data || {} };
  var globals = page.globals || {}, setup = 'window.ML=' + json_(ml) + ';';
  Object.keys(globals).forEach(function (k) { setup += 'window.' + k + '=' + json_(globals[k]) + ';'; });
  var code = [safe64_(setup), safe64_(asset_('app'))];
  if (page.editor) code.push(safe64_(asset_('editor')));
  var out = ['<!doctype html><html lang="en"><head><base target="_top"><meta charset="utf-8">', FONTS_HTML_,
    '<meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="apps-script">',
    '<style>', asset_('styles'), '</style></head><body class="apps-script ' + (page.bodyClass || '') + '">', CRASH_SCRIPT_,
    '<header class="topbar" id="topbar"></header>',
    '<main class="', page.mainClass || 'container', '" id="main">',
    page.html || '<p class="muted" style="padding:24px">Loading Maker Lab…</p><noscript>Maker Lab needs JavaScript turned on.</noscript>', '</main>',
    '<footer class="footer">Built for young makers · Python + micro:bit + circuits</footer>',
    '<div id="ml-code" hidden>', code.join('.'), '</div>', LOADER_SCRIPT_, '</body></html>'];
  return HtmlService.createHtmlOutput(out.join(''))
    .setTitle((page.title ? page.title + ' · ' : '') + APP_NAME)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}
